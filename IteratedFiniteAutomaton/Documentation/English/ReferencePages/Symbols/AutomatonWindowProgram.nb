Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWindowProgram", "ObjectName",
 CellID->112717927,ExpressionUUID->"d86ef827-1ae1-463c-9e42-8ebc5f381065"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b10a7066-e2eb-4a1c-bbf3-c548e4f656ba"],
 Cell[BoxData[
  RowBox[{"AutomatonWindowProgram", "[", 
   StyleBox["m", "TI"], ",", 
   StyleBox["active", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0a7598f6-bb7b-4bc3-9fb9-aa1a3e10abbe"],
 " \[LineSeparator]",
 "gives the rule of the automaton on the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["m", "TI"]]], "InlineFormula",ExpressionUUID->
  "3c6a1396-1aab-48eb-afe1-a4afdbc55f85"],
 " windows of the ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "c8955295-f079-45a1-8b10-83e35d037664"],
 " symbols last read, advancing the symbol it reads exactly under the windows \
in ",
 Cell[BoxData[
  StyleBox["active", "TI"]], "InlineFormula",ExpressionUUID->
  "9683ffe8-9362-46a7-97ee-8eaa1f7b0267"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bfea608f-0d00-4391-813b-9d639053c79d"],
 Cell[BoxData[
  RowBox[{"AutomatonWindowProgram", "[", 
   StyleBox["m", "TI"], ",", 
   StyleBox["active", "TI"], ",", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "950a5352-cad9-441e-a6e3-8fab3815b9a8"],
 " \[LineSeparator]",
 "uses ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "c3b6c114-39bf-43bf-84ff-b2749c51f85b"],
 " symbols.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7490d7fe-76fb-466a-8f69-434885ea8c61"],
 Cell[BoxData[
  RowBox[{"AutomatonWindowProgram", "[", 
   StyleBox["m", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1769de72-fada-490a-b9b0-20bfdb1d3ab9"],
 " \[LineSeparator]",
 "takes ",
 Cell[BoxData[
  StyleBox["active", "TI"]], "InlineFormula",ExpressionUUID->
  "1b899459-962e-4012-b68e-bee201c3fcb2"],
 " to be the single all-ones window, the carry rule of the odometer."
}], "Usage",
 CellID->816567441,ExpressionUUID->"11387309-f919-4d81-aa3c-0ef51ac0e5d2"],

Cell[TextData[{
 "The windows are given as lists of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "088126af-8940-4b48-9647-a232e393d391"],
 " symbols, and the state numbered ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"FromDigits", "[", 
    RowBox[{
     StyleBox["w", "TI"], ",", 
     StyleBox["k", "TI"]}], "]"}], "+", "1"}]], "InlineFormula",
  ExpressionUUID->"af3eb4ca-6094-4853-a3fd-40faa3713f8d"],
 " is the window ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "7846c8f3-b494-4402-9ed7-1820a6afbea0"],
 "."
}], "Notes",
 CellID->960389545,ExpressionUUID->"e51aaeaa-95e0-45ee-b5be-5008f9ae29d5"],

Cell[TextData[{
 "One step of the evolution is a sliding-block code: it advances a symbol \
exactly when the ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "bbe1dec0-105c-45e1-b033-266c73399c72"],
 " symbols before it form a window in ",
 Cell[BoxData[
  StyleBox["active", "TI"]], "InlineFormula",ExpressionUUID->
  "5d26176e-6786-4fd2-b442-adb4b09972c1"],
 "."
}], "Notes",
 CellID->613445441,ExpressionUUID->"ebbe84df-75bc-47dc-8461-858553278bc4"],

Cell[TextData[{
 "The section at a tree vertex depends only on the last ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "9fce3e5b-e045-4085-b7d7-5a53aaf1f56e"],
 " letters of the vertex, so the automaton is exponentially active rather \
than bounded."
}], "Notes",
 CellID->612369648,ExpressionUUID->"5b400a44-0f3d-456b-acdb-580798d4c94c"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[Equal]", "1"}]], "InlineFormula",ExpressionUUID->
  "ec8b1392-b6ca-407b-b262-37a133a2571b"],
 " over two symbols the construction is the lamplighter automaton of \
Grigorchuk and Zuk, and not the adding machine its carry rule resembles."
}], "Notes",
 CellID->429844311,ExpressionUUID->"2804a1d2-6ec9-4c18-8504-aaf6d1c765fe"]
}, Open  ]],

