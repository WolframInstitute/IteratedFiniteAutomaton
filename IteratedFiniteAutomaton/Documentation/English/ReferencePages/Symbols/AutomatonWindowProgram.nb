Cell["\<\
The window of length one over two symbols is the lamplighter automaton:\
\>", "ExampleText",
 CellID->807587807,ExpressionUUID->"7a624445-29d6-4746-a1fd-6cb15fd2cc6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonicalAutomatonCode", "[", 
   RowBox[{"AutomatonWindowProgram", "[", "1", "]"}], "]"}], "===", 
  RowBox[{"CanonicalAutomatonCode", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<a\>\"", ",", "\"\<b\>\""}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<b\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<a\>\"", ",", "\"\<b\>\""}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->790963140,ExpressionUUID->"9bf3891f-34e2-46e1-8f6b-f60a32dbb7a3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
