      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]}], "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "1", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], 
