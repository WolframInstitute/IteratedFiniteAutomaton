Cell["\<\
Binary decrement is the inverse transducer of the adding machine, so \
converting both and evolving each one step undoes the increment:\
\>", "ExampleText",
 CellID->479762727,ExpressionUUID->"322bb0cb-0ce7-49dd-b423-c70d97b68c36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"increment", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<eps\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<lam\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
     ",", "\"\<eps\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->396695812,ExpressionUUID->"d7e187ab-3a55-40b2-9be1-55f3fa143ba9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"decrement", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<borrow\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<borrow\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<done\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<done\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
