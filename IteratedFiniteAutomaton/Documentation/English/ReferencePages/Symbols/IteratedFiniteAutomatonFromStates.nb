Cell["The adding machine as a Mealy transducer with named states:", \
"ExampleText",
 CellID->537455627,ExpressionUUID->"54d2dce5-d90c-4017-a73f-1b83c1177367"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mealy", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<eps\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<lam\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->326905088,ExpressionUUID->"f3bd5a4f-4779-44a2-8d40-94886abb156b"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   RowBox[{"mealy", ",", "\"\<eps\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->483360529,ExpressionUUID->"c5027bfa-cf78-4ba7-8d83-52377207ffc0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"eps\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"lam\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->447265219,ExpressionUUID->"07f38f91-ff72-44b0-b45f-d4c37e973add"],

