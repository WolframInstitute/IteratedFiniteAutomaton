Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromStates", "ObjectName",
 CellID->144764118,ExpressionUUID->"f913aa8d-c01b-4e88-91b5-645e094163ab"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"46651c2c-51d5-41b3-911e-82eece03d6a6"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "6ecef478-be16-4c1f-95ab-419b4c57d96d"],
 " \[LineSeparator]",
 "converts a Mealy transducer with named states and initial state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "a4ad457d-9e3d-4f6f-8403-dc6da43817bf"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->203363073,ExpressionUUID->"b8116415-5fe9-41ec-a30a-973acd8acf72"],

Cell[TextData[{
 "The specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["input", "TI"], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["output", "TI"], ",", 
         StyleBox["next", "TI"]}], "}"}]}], ",", "\[Ellipsis]"}], "}"}]}], ",",
    "\[Ellipsis]", "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "f1c907d7-f78a-4260-b4ab-831bc74bb5d8"],
 " lists for each named state the transitions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["input", "TI"], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["output", "TI"], ",", 
     StyleBox["next", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "a89d3304-3b33-417f-9da9-ad6bf4707435"],
 "."
}], "Notes",
 CellID->928984143,ExpressionUUID->"56573db0-f53f-4b06-af17-770e679ddf35"],

Cell[TextData[{
 "States are numbered with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "1c77707b-c73d-4391-918f-15700cd425a1"],
 " first; the numbering is returned under \"StateIndex\"."
}], "Notes",
 CellID->590602115,ExpressionUUID->"60428d9f-3d4b-43b1-9cf5-63f85ca82209"],

Cell[TextData[{
 "The keys \"Rule\" and \"InitialState\" are suitable for ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "d674fa14-730e-4371-b28e-994665c39c37"],
 "; the whole association can be passed to ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonEvolve",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonEvolve"]], "InlineFormula",ExpressionUUID->
  "c8ea2bb1-6a9a-4d7b-a045-214a15d2c4b8"],
 "."
}], "Notes",
 CellID->987783745,ExpressionUUID->"93807bbd-8076-4ea4-8cc4-946d52ced0a3"]
}, Open  ]],

