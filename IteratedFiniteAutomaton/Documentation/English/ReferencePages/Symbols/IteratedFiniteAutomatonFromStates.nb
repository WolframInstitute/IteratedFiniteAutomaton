Cell["The adding machine as a Mealy transducer with named states:", \
"ExampleText",
 CellID->944144084,ExpressionUUID->"c5c33cb6-4986-4f5f-81da-4fb57899e176"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mealy", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<eps\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<lam\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->225886598,ExpressionUUID->"09c3074f-5b9d-4708-a1be-88df960c4420"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   RowBox[{"mealy", ",", "\"\<eps\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->145007219,ExpressionUUID->"592bda72-af27-4efb-ac3c-d748186ab1b8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"eps\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"lam\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->311206134,ExpressionUUID->"b019d1b7-746f-4857-8ff2-b8b961ba5a53"],

