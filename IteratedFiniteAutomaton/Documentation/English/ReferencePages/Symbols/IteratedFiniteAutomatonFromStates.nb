Cell["The adding machine as a Mealy transducer with named states:", \
"ExampleText",
 CellID->506454388,ExpressionUUID->"4b0a161d-d9d7-4291-ae2a-cb9c2d0d720f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mealy", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<eps\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<lam\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->358481913,ExpressionUUID->"dc38acac-6c94-4176-8b9b-c92645a795f5"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   RowBox[{"mealy", ",", "\"\<eps\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->811728633,ExpressionUUID->"bffd252c-5fb4-4576-89b4-2e94067164fc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"eps\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"lam\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->847163547,ExpressionUUID->"21a3f485-a963-4efc-8b0d-3c5b0b575b04"],

Cell["Evolve the converted automaton:", "ExampleText",
 CellID->951076021,ExpressionUUID->"909af55f-715b-4029-a8be-679b89fa7d05"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "6"}], "]"}], ",", "5"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->982979537,ExpressionUUID->"071744b7-0ce7-48ea-9d0d-cab98b8b4ae1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->290367497,ExpressionUUID->"d7e5b1e0-44b8-4042-bb97-f1a231876243"]
}, Open  ]],

