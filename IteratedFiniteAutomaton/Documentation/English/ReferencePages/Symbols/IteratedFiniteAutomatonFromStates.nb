Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromStates", "ObjectName",
 CellID->744302162,ExpressionUUID->"a59d2ae1-9a57-429e-a3a5-23629e733661"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5fd87ad5-c9ef-4800-a2f1-d41b7a1dc53c"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "0bcaf660-d606-40c5-b629-db2b5d7f707d"],
 " \[LineSeparator]",
 "converts a Mealy transducer with named states and initial state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "1b2f36c3-d7d3-4169-8182-9204133a1d48"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->435808645,ExpressionUUID->"d60eff92-fdec-442c-831d-b270345dbeb9"],

Cell[TextData[{
 "The specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["input", "TI"], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["output", "TI"], ",", 
         StyleBox["next", "TI"]}], "}"}]}], ",", "\[Ellipsis]"}], "}"}]}], ",",
    "\[Ellipsis]", "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "9b92323f-c4a2-4637-b3da-ea010e62cd06"],
 " lists for each named state the transitions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["input", "TI"], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["output", "TI"], ",", 
     StyleBox["next", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "843dc420-0cfa-4ccb-b94c-4481866a9d85"],
 "."
}], "Notes",
 CellID->952506575,ExpressionUUID->"09999266-a22a-4c5e-af8b-772794b1113a"],

Cell[TextData[{
 "States are numbered with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "3df87379-c703-41fe-8bed-cd1fb68f8bc8"],
 " first; the numbering is returned under \"StateIndex\"."
}], "Notes",
 CellID->193588137,ExpressionUUID->"61392b85-a605-4389-b564-6d1b7857a220"],

Cell[TextData[{
 "The keys \"Rule\" and \"InitialState\" are suitable for ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "2ed0f993-c82f-4cb7-80f3-6a210148f14f"],
 "; the whole association can be passed to ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonEvolve",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonEvolve"]], "InlineFormula",ExpressionUUID->
  "bf5e69dd-63f6-46b1-b3a6-06b1decb42ce"],
 "."
}], "Notes",
 CellID->864744863,ExpressionUUID->"1abef082-fe9c-45b2-99a3-38f0147c94e8"]
}, Open  ]],

