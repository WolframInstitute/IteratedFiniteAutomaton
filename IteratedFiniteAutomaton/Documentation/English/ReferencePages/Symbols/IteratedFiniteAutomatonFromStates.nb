Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromStates", "ObjectName",
 CellID->266812368,ExpressionUUID->"bceadb5f-6a37-4a85-a6eb-30b0e5310d88"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4bdd4757-3774-4be3-a988-dab557ea4311"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "163ca75c-8d42-43e5-8119-b0f61e730b09"],
 " \[LineSeparator]",
 "converts a Mealy transducer with named states and initial state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "ac9766c8-ecb9-49bc-a798-1a94c3dc2cc9"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->966742723,ExpressionUUID->"46fdda93-b942-41bf-9cfc-9835ad01596b"],

Cell[TextData[{
 "The specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["input", "TI"], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["output", "TI"], ",", 
         StyleBox["next", "TI"]}], "}"}]}], ",", "\[Ellipsis]"}], "}"}]}], ",",
    "\[Ellipsis]", "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "f1dd3672-9337-4eaa-b697-ea5deb2d293b"],
 " lists for each named state the transitions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["input", "TI"], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["output", "TI"], ",", 
     StyleBox["next", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "e8bd7d1e-0bee-4611-b332-991c6badf300"],
 "."
}], "Notes",
 CellID->724490012,ExpressionUUID->"44a59aed-f218-462a-b1a1-55f1b8f5fb64"],

Cell[TextData[{
 "States are numbered with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "28fc454f-5f08-46e1-9b15-dc3ab9bace9a"],
 " first; the numbering is returned under \"StateIndex\"."
}], "Notes",
 CellID->261269264,ExpressionUUID->"bb662f13-f786-4bec-bd34-82a878349d84"],

Cell[TextData[{
 "The keys \"Rule\" and \"InitialState\" are suitable for ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "a1c2f302-9fe7-4fe9-8a62-3646bfdef82f"],
 "; the whole association can be passed to ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonEvolve",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonEvolve"]], "InlineFormula",ExpressionUUID->
  "dd93c99a-39c0-4871-a2d9-95cf6252b6ea"],
 "."
}], "Notes",
 CellID->332431371,ExpressionUUID->"f045358e-b133-42cc-b8f9-04c4bfe5d57f"]
}, Open  ]],

