Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromStates", "ObjectName",
 CellID->539412854,ExpressionUUID->"99178726-4706-4d08-a1ff-8ec139964ec1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"885f9628-4c8f-4f11-8f62-27a06c50b7ff"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "60fffa76-9d22-4dc2-8c9b-76a931f45cba"],
 " \[LineSeparator]",
 "converts a Mealy transducer with named states and initial state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "e8eb4ad2-dbd7-48f3-8bbd-c916a248ac0a"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->992495022,ExpressionUUID->"eb0a5736-c828-403f-8f69-074aba6246ba"],

Cell[TextData[{
 "The specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       StyleBox["input", "TI"], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         StyleBox["output", "TI"], ",", 
         StyleBox["next", "TI"]}], "}"}]}], ",", "\[Ellipsis]"}], "}"}]}], ",",
    "\[Ellipsis]", "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "997b9453-fa44-48b7-87dd-efebeddad637"],
 " lists for each named state the transitions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["input", "TI"], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["output", "TI"], ",", 
     StyleBox["next", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "8bbbe9e8-4827-49a2-9aac-72334b86e9c3"],
 "."
}], "Notes",
 CellID->682518354,ExpressionUUID->"ba7c5452-7d1a-44a8-b3be-1cb377a14911"],

Cell[TextData[{
 "States are numbered with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "20cdeaeb-336d-493b-a25c-f6c2ddbe83c8"],
 " first; the numbering is returned under \"StateIndex\"."
}], "Notes",
 CellID->343542728,ExpressionUUID->"74a1a50c-a070-46e4-b548-f1e9418252c3"],

Cell[TextData[{
 "The keys \"Rule\" and \"InitialState\" are suitable for ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "a5674ff9-36d1-4f93-a653-3397e66168c3"],
 "; the whole association can be passed to ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonEvolve",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonEvolve"]], "InlineFormula",ExpressionUUID->
  "3e80df8d-1473-45ca-8673-1973e6e8a5ee"],
 "."
}], "Notes",
 CellID->681378024,ExpressionUUID->"00fd0221-fadd-441d-80b6-c2e7f50f97e8"]
}, Open  ]],

