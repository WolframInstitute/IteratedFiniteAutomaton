Cell["\<\
Binary decrement is the inverse transducer of the adding machine, so \
converting both and evolving each one step undoes the increment:\
\>", "ExampleText",
 CellID->447388066,ExpressionUUID->"69d8cd98-12d2-4d35-973e-6df919952f0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"increment", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<eps\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<lam\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
     ",", "\"\<eps\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->690411562,ExpressionUUID->"36b84180-5642-4a96-8e7e-1c80e4e2fd01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"decrement", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<borrow\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<borrow\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<done\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<done\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
