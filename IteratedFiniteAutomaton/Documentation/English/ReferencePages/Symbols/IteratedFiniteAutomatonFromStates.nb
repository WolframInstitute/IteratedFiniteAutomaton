Cell["The adding machine as a Mealy transducer with named states:", \
"ExampleText",
 CellID->838007219,ExpressionUUID->"7c50ba99-2b02-4060-b133-056deae2d22b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mealy", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<eps\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"\"\<lam\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
        RowBox[{"1", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->835313965,ExpressionUUID->"ef2eeb83-8009-4337-a3f4-94719b3e3bcf"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
   RowBox[{"mealy", ",", "\"\<eps\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->930092486,ExpressionUUID->"ba2d5b90-bfd5-4fe3-9094-dcbb8371fff1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"eps\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"lam\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->591723271,ExpressionUUID->"2b7883d7-9861-4925-be2b-3fa4f1f707aa"],

Cell["Evolve the converted automaton:", "ExampleText",
 CellID->255195044,ExpressionUUID->"5880e31e-4e04-4c78-89bc-7991bb61c7ac"],

Cell[BoxData[
