Cell["The default searches the whole support:", "ExampleText",
 CellID->867543605,ExpressionUUID->"a357235c-d279-490d-927b-87aac51db4b7"],

Cell[BoxData[
 RowBox[{"Options", "[", "GroupRingZeroDivisorSurvival", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->365545416,ExpressionUUID->"1150189a-706c-453a-814d-6b45d838a0c0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Modulus", "\[Rule]", "2"}], ",", 
   RowBox[{"MaxTerms", "\[Rule]", "\[Infinity]"}], ",", 
   RowBox[{"Method", "\[Rule]", "Automatic"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->265326855,ExpressionUUID->"9fedf9b9-4f6c-4bd2-800f-278a2f3cc08e"],

