Notebook[{

Cell[CellGroupData[{
Cell["MaxTerms", "ObjectName",
 CellID->369513811,ExpressionUUID->"3fa40732-5160-4469-a6eb-33169f466ba9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7ee9f7d-87c7-4f9e-8a25-2298e76ccb49"],
 Cell[BoxData[
 "MaxTerms"], "InlineFormula",ExpressionUUID->
  "5fa76360-3362-42bc-b211-078f2521d946"],
 " \[LineSeparator]",
 "is an option for the group-ring searches specifying the largest number of \
nonzero terms a candidate element may have."
}], "Usage",
 CellID->197920198,ExpressionUUID->"7eb6298e-6181-4b3a-b1a6-6128f78a1bab"],

Cell[TextData[{
 "The default is ",
 Cell[BoxData[
  ButtonBox["Infinity",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Infinity"]], "InlineFormula",ExpressionUUID->
  "b9ab2004-607f-4c32-a739-5136f5a44b38"],
 ", which searches the whole support."
}], "Notes",
 CellID->483883203,ExpressionUUID->"22066ff5-38d1-4ce1-b27f-aa50cb351208"],

Cell["\<\
Bounding the number of terms shrinks the candidate set, so it can only lose \
survivors, never gain them; a nonempty result under a bound is still a \
genuine find.\
\>", "Notes",
 CellID->486766446,ExpressionUUID->"42044ed2-5a9f-4f40-aaa1-fda6b83634cc"],

Cell[TextData[{
 "It is accepted by ",
 Cell[BoxData[
  ButtonBox["GroupRingIdempotentSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingIdempotentSurvival"]], "InlineFormula",ExpressionUUID->
  "c8cee392-70ff-4239-bc47-bc25aae52b6b"],
 " and ",
 Cell[BoxData[
  ButtonBox["GroupRingZeroDivisorSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingZeroDivisorSurvival"]], "InlineFormula",ExpressionUUID->
  "31bbd51d-c8bd-42b6-9556-0eb5a910e8f3"],
 "."
}], "Notes",
 CellID->520141346,ExpressionUUID->"a3fd5824-31bd-41cf-8512-6a8074c1c6b4"]
}, Open  ]],

