  $Line = 0; Null]], "ExampleDelimiter",
 CellID->808320016,ExpressionUUID->"cdff2eb8-0829-4a74-accf-a8b4926396b1"],

Cell["\<\
Restricting the Grigorchuk zero-divisor search to two terms drops the one \
survivor that needs four:\
\>", "ExampleText",
 CellID->132062410,ExpressionUUID->"e25f1d13-37f1-43cb-b9ac-27e91bf91651"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"GroupRingZeroDivisorSurvival", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "1", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"3", ",", "8"}], "]"}], ",", 
       RowBox[{"MaxTerms", "\[Rule]", "2"}]}], "]"}], "[", "\"\<Survivors\>\"",
      "]"}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"GroupRingZeroDivisorSurvival", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "1", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"3", ",", "8"}], "]"}]}], "]"}], "[", "\"\<Survivors\>\"", 
     "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->461772774,ExpressionUUID->"bbc620f7-e879-4a21-910c-2a2badbf64c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->207432855,ExpressionUUID->"a8b9ffbe-fb58-4337-b8ac-9eaeee4db03c"]
}, Open  ]],

