Cell["The default searches the whole support:", "ExampleText",
 CellID->984520230,ExpressionUUID->"f571f9ed-476b-47d3-b231-228d50909230"],

Cell[BoxData[
 RowBox[{"Options", "[", "GroupRingZeroDivisorSurvival", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->253223224,ExpressionUUID->"d12deb32-d6b1-40bc-83cf-6a5f568afa06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Modulus", "\[Rule]", "2"}], ",", 
   RowBox[{"MaxTerms", "\[Rule]", "\[Infinity]"}], ",", 
   RowBox[{"Method", "\[Rule]", "Automatic"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->484838233,ExpressionUUID->"d7bde5ba-a7ae-4b6b-a131-a3b7919182ff"],

Cell[BoxData[
 InterpretationBox[Cell[
