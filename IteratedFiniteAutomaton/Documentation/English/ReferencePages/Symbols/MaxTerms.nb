Notebook[{

Cell[CellGroupData[{
Cell["MaxTerms", "ObjectName",
 CellID->649140933,ExpressionUUID->"ea33f546-23da-4498-bf43-1ca85bf28f56"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"482d8c97-21b8-4d1a-ac3d-381308e168e2"],
 Cell[BoxData[
 "MaxTerms"], "InlineFormula",ExpressionUUID->
  "3f778c6b-4855-48bf-9ad0-f82a3cf0e387"],
 " \[LineSeparator]",
 "is an option for the group-ring searches specifying the largest number of \
nonzero terms a candidate element may have."
}], "Usage",
 CellID->886541600,ExpressionUUID->"5354b130-5a4d-4103-a8bf-81ddd9d606fe"],

Cell[TextData[{
 "The default is ",
 Cell[BoxData[
  ButtonBox["Infinity",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Infinity"]], "InlineFormula",ExpressionUUID->
  "92ee9a95-59da-4b8a-b4e0-b2940d49da24"],
 ", which searches the whole support."
}], "Notes",
 CellID->237068372,ExpressionUUID->"38abfc80-d5c4-4d46-9303-71463375cb27"],

Cell["\<\
Bounding the number of terms shrinks the candidate set, so it can only lose \
survivors, never gain them; a nonempty result under a bound is still a \
genuine find.\
\>", "Notes",
 CellID->653895947,ExpressionUUID->"b9b3277f-223f-4009-93dc-a5a3c7c062a2"],

Cell[TextData[{
 "It is accepted by ",
 Cell[BoxData[
  ButtonBox["GroupRingIdempotentSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingIdempotentSurvival"]], "InlineFormula",ExpressionUUID->
  "012bf76f-3b16-4de2-aa95-ad8da0afc325"],
 " and ",
 Cell[BoxData[
  ButtonBox["GroupRingZeroDivisorSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingZeroDivisorSurvival"]], "InlineFormula",ExpressionUUID->
  "b0af1b47-0ed0-43d2-b510-a66e332fb7ee"],
 "."
}], "Notes",
 CellID->881510048,ExpressionUUID->"4c0f37ea-edec-45b2-be5e-fb223eec1891"]
}, Open  ]],

