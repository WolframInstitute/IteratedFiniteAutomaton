  $Line = 0; Null]], "ExampleDelimiter",
 CellID->671378333,ExpressionUUID->"a4796bed-a8bf-4bb3-a11e-d9f4c93e18f6"],

Cell["\<\
Restricting the Grigorchuk zero-divisor search to two terms drops the one \
survivor that needs four:\
\>", "ExampleText",
 CellID->555960302,ExpressionUUID->"34ebae51-70a9-4f26-9685-04e3532a946f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"GroupRingZeroDivisorSurvival", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "1", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"3", ",", "8"}], "]"}], ",", 
       RowBox[{"MaxTerms", "\[Rule]", "2"}]}], "]"}], "[", "\"\<Survivors\>\"",
      "]"}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"GroupRingZeroDivisorSurvival", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "1", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"3", ",", "8"}], "]"}]}], "]"}], "[", "\"\<Survivors\>\"", 
     "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->708256058,ExpressionUUID->"751f85e0-5f75-4743-b4ae-e19c71be926e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->247727792,ExpressionUUID->"dd7d6980-efa6-4dd7-87aa-da2c788841fc"]
}, Open  ]],

