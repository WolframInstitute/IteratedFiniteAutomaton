Cell[CellGroupData[{
Cell["AutomatonSectionTable", "ObjectName",
 CellID->577552031,ExpressionUUID->"f3fd4d72-808f-41a0-96da-f43e42785c6f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"781c4085-d9b6-436e-9b7f-2fab3652fe67"],
 Cell[BoxData[
  RowBox[{"AutomatonSectionTable", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3811ce19-0d8a-45ca-98e4-7eb2f345e3e2"],
 " \[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "851df92b-850b-4eae-96d8-ea7e49dd5f05"],
 " sending ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["g", "TI"], ",", 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a0677351-535a-4e44-98eb-3afdd12a9b4f"],
 " to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"section", " ", "of", " "}], 
    StyleBox["g", "TI"], 
    RowBox[{" ", "at", " "}], 
    StyleBox["x", "TI"], ",", 
    RowBox[{" ", 
     RowBox[{"image", " ", "of", " "}]}], 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "024f26db-81ad-4aab-8b06-b33cc63c56eb"],
 ", for every generator and every inverse generator."
}], "Usage",
 CellID->915631791,ExpressionUUID->"6759fedc-a5eb-41bf-9c66-ecde9b7786cc"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "dfb453af-581c-43db-b568-69bedebe87a2"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "bdd0254b-5e3c-449f-bcee-f957d0d22ee1"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "6c6560f6-e36e-4e05-b287-f8bd773f54bf"],
 "."
}], "Notes",
 CellID->608491434,ExpressionUUID->"ee9a5a15-5e41-49a6-971e-2fa4d3f5b39e"],

Cell[TextData[{
 "Inverse generators are keyed by negative state numbers, so the table has ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"], 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "8210704b-e6e3-4d27-89c4-cacf537e0183"],
 " entries."
}], "Notes",
 CellID->832290497,ExpressionUUID->"900026b0-2603-4a44-a3d4-98683e3da8ff"],

Cell[TextData[{
 "It is the ",
 Cell[BoxData[
  StyleBox["sections", "TI"]], "InlineFormula",ExpressionUUID->
  "e812d863-98b3-4a4a-8406-47e0abb8549d"],
 " argument of ",
 Cell[BoxData[
  ButtonBox["AutomatonWordSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonWordSection"]], "InlineFormula",ExpressionUUID->
  "be76514a-1a1c-4c05-a32a-9a6e78f8dffc"],
 ", built once and reused across words."
}], "Notes",
 CellID->288479697,ExpressionUUID->"6018ddf1-19aa-49af-ae88-3d040cbd78aa"]
}, Open  ]],

