Cell[CellGroupData[{
Cell["AutomatonSectionTable", "ObjectName",
 CellID->788950973,ExpressionUUID->"5771457a-4c4a-4a6b-b022-62d251bb2fea"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc4d69e1-d55d-49fd-a7d5-a734bab7b6ec"],
 Cell[BoxData[
  RowBox[{"AutomatonSectionTable", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "601e0c54-2aa2-48ed-a618-900fe6aacbca"],
 " \[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "8c12b717-7762-4a3d-baf6-ba6b630af25e"],
 " sending ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["g", "TI"], ",", 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "36528070-8afb-4adf-b701-1acdba174aeb"],
 " to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"section", " ", "of", " "}], 
    StyleBox["g", "TI"], 
    RowBox[{" ", "at", " "}], 
    StyleBox["x", "TI"], ",", 
    RowBox[{" ", 
     RowBox[{"image", " ", "of", " "}]}], 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "e138a546-5be7-4384-933c-8d19458da4bb"],
 ", for every generator and every inverse generator."
}], "Usage",
 CellID->314327165,ExpressionUUID->"fd9fb44c-a0c4-4e0f-8f63-e604fbc8342d"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "be92b6fd-b9c1-4303-9cb1-e75f2eb24187"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "1dcf1c08-a15b-4e80-aef7-c38411c35a08"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "0b618764-a60a-427a-8809-44080a7dcb4e"],
 "."
}], "Notes",
 CellID->580091845,ExpressionUUID->"ddfca86e-bf49-49fd-9f43-f6252170bf96"],

Cell[TextData[{
 "Inverse generators are keyed by negative state numbers, so the table has ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"], 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "d24ce7f8-98d3-46cc-9b16-fa9cb746f58b"],
 " entries."
}], "Notes",
 CellID->871516429,ExpressionUUID->"539f69cb-c294-44b3-8813-3b353112ece5"],

Cell[TextData[{
 "It is the ",
 Cell[BoxData[
  StyleBox["sections", "TI"]], "InlineFormula",ExpressionUUID->
  "ad70ccc7-59c7-420b-8e17-f31265c2184d"],
 " argument of ",
 Cell[BoxData[
  ButtonBox["AutomatonWordSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonWordSection"]], "InlineFormula",ExpressionUUID->
  "ccf9d08e-5fc2-4a05-a698-1abfc3b859ee"],
 ", built once and reused across words."
}], "Notes",
 CellID->571614518,ExpressionUUID->"64e4a23d-fed2-4ba5-8349-012fe1cdff58"]
}, Open  ]],

