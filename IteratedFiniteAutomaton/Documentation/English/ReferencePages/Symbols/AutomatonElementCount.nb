Cell[CellGroupData[{
Cell["AutomatonElementCount", "ObjectName",
 CellID->147438085,ExpressionUUID->"8c392100-b3d1-44f1-8c0c-caf0177aea26"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a1e98a4d-72b8-40e0-811a-5f4ba5632313"],
 Cell[BoxData[
  RowBox[{"AutomatonElementCount", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["wordLength", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f8a8493d-879b-42e0-b056-4e282445ed94"],
 " \[LineSeparator]",
 "gives the number of distinct elements of ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "690532e8-044c-4942-b45f-8022c6a8c6b7"],
 " represented by words of length at most ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "7e267eb1-ac1d-47b0-a0ef-734241466f5e"],
 "."
}], "Usage",
 CellID->678366905,ExpressionUUID->"8ab1d80c-6b88-4312-99b5-40d7090c961a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "94d3221f-6f99-47d4-9adc-a5ca4068a0e8"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "7e54a136-6c95-47b6-b40a-0ad3cf5fb1e4"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "bc7f2cd7-39f1-4f80-8095-5140fdf9fd7d"],
 "."
}], "Notes",
 CellID->504904920,ExpressionUUID->"38d67be7-983a-4870-b5a7-c3b6b4fd755b"],

Cell[TextData[{
 "The identity is counted, so the value at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["wordLength", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "b505d177-ef03-4079-8a69-8f9b3ad14bc6"],
 " is 1."
}], "Notes",
 CellID->126582068,ExpressionUUID->"173160e9-379f-4296-a7c7-c05cf2be592d"],

Cell[TextData[{
 "As a function of ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "e70cde3e-c70e-49e8-9e33-56f806933210"],
 " this is the growth function of the level quotient, truncated at the ball \
radius; linear growth indicates a virtually abelian group and exponential \
growth a free-like one."
}], "Notes",
 CellID->475380100,ExpressionUUID->"c22199ec-6f4b-4d8a-bb42-ff53ec241f9b"]
}, Open  ]],

