Cell[CellGroupData[{
Cell["AutomatonElementCount", "ObjectName",
 CellID->626569392,ExpressionUUID->"7e63d2d2-c85a-43a1-92b3-d905211d024f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"601aa94b-d841-4eb3-bbb3-d1176350f2d0"],
 Cell[BoxData[
  RowBox[{"AutomatonElementCount", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["wordLength", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "046a2d29-0f18-4046-8524-c5afef68b17d"],
 " \[LineSeparator]",
 "gives the number of distinct elements of ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "be41b431-6103-444a-8edf-ff813a48a473"],
 " represented by words of length at most ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "951306d6-7848-4ba2-8e3b-0064fa11e6d7"],
 "."
}], "Usage",
 CellID->616742671,ExpressionUUID->"5ce7ea5b-7e25-430e-935b-292cf7c50542"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "e0c49d9f-8183-4170-9812-5977df2d195a"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "35c8e435-7c43-42c0-b279-5e568a4f6d53"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "41786d90-d768-4680-9840-560e8b4c03cf"],
 "."
}], "Notes",
 CellID->241661277,ExpressionUUID->"abd2c69d-572e-4e10-800f-3085fd82230e"],

Cell[TextData[{
 "The identity is counted, so the value at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["wordLength", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "2a054f17-1cad-416a-95d2-12e014b24e8b"],
 " is 1."
}], "Notes",
 CellID->955551229,ExpressionUUID->"3cdcc24b-aaef-4939-a7c9-32b995651b53"],

Cell[TextData[{
 "As a function of ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "4d4478b7-c75f-4062-99c3-ad99d6247996"],
 " this is the growth function of the level quotient, truncated at the ball \
radius; linear growth indicates a virtually abelian group and exponential \
growth a free-like one."
}], "Notes",
 CellID->135367582,ExpressionUUID->"274c7b41-5293-499a-a7ac-0f8f515fedba"]
}, Open  ]],

