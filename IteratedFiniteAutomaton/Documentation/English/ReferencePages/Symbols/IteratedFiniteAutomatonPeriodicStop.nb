Cell["\<\
The odometer on three cells returns to the zero row after 8 steps:\
\>", "ExampleText",
 CellID->515652644,ExpressionUUID->"6b09c0fd-6e03-4dca-ab7c-68f0e036e51a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->575063265,ExpressionUUID->"f262cebe-2bf5-4a42-a557-143d692412b2"],

Cell[BoxData[
 RowBox[{"evolution", "=", 
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", "3"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->292667721,ExpressionUUID->"3bfb24fb-8051-42e0-ab94-3357456255c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->689630572,ExpressionUUID->"89f95b0c-f0b4-479d-9c02-f8ae9265590c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "evolution", "]"}], ",", 
   RowBox[{
    RowBox[{"First", "[", "evolution", "]"}], "===", 
    RowBox[{"Last", "[", "evolution", "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->513855198,ExpressionUUID->"8a911e8b-1253-4eb6-9d84-fb29552396b4"],

Cell[BoxData[
 RowBox[{"{", 
