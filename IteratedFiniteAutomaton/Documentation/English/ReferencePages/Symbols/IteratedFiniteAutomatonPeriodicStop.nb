Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonPeriodicStop", "ObjectName",
 CellID->948576049,ExpressionUUID->"62de6b8b-8225-40bb-a972-1930d7d6c7be"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6999b39-1032-4767-b5a9-f67b353314e9"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "28c0416d-ed62-43d5-9fce-7ed9e882a03d"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton until a row repeats.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1268f07d-4864-4202-9264-6f12bf923661"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d949cf5e-5e8e-42ed-ba1c-a6c0614a29e9"],
 " \[LineSeparator]",
 "starts in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "abf0c75b-47f0-49f3-a108-ae76635c744f"],
 " and evolves at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "5d40efa5-2b92-4934-9538-d7b16d0a33f8"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0c7b00d-7532-417b-9139-07447029445d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "71981beb-31e2-41f9-ae15-baab24c6ae88"],
 " \[LineSeparator]",
 "is the operator form."
}], "Usage",
 CellID->318785083,ExpressionUUID->"b75725bf-bdba-4d65-8d21-d590b997ca9c"],

Cell["\<\
Evolution stops at the first row that equals an earlier row; the repeated row \
is included as the last element.\
\>", "Notes",
 CellID->761724773,ExpressionUUID->"8700c4aa-eeaa-4dd7-9e00-14805bf3cd18"],

Cell[TextData[{
 "With maximal step count ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "0002bf57-e152-4b47-a0fe-99701c337b9d"],
 " the result has at most ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "8b229543-1d78-40d7-8f45-4a1e06d1e586"],
 " rows, whether or not a repetition occurred."
}], "Notes",
 CellID->716036836,ExpressionUUID->"aee424ec-5453-452d-a875-ee7e46c604d3"],

Cell[TextData[{
 "On rows of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "f4bc0073-e212-43b4-9c4d-6b1e9ee1b816"],
 " over ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "b9747947-444a-417a-99bc-6aa0748f5dc0"],
 " symbols a repetition always occurs within ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "4001ba18-816e-4ac9-8174-554ddde00794"],
 " steps."
}], "Notes",
 CellID->575868975,ExpressionUUID->"d1ce45db-2c7f-422b-b956-513ff3451d57"]
}, Open  ]],

