Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonPeriodicStop", "ObjectName",
 CellID->447826792,ExpressionUUID->"03891deb-09de-4b59-a3ec-ff0c7a3102b9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e546d144-a6e9-4e83-912d-e167985e760b"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8900ea12-9c81-4c5c-b63d-a66e839bec41"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton until a row repeats.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"94925a1d-b959-48cb-92e1-8604daab329a"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ea5a4445-8533-406c-aa85-af5e9fc15abf"],
 " \[LineSeparator]",
 "starts in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "1007beef-a1e0-4a37-8579-81f7d746fe79"],
 " and evolves at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "a8565eef-5f95-431a-8638-8118c2e80c7d"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"64deb231-1129-4748-9af1-c09f7ece1e4e"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "e24ecc58-5e62-461a-bdda-18e0781334f1"],
 " \[LineSeparator]",
 "is the operator form."
}], "Usage",
 CellID->690733820,ExpressionUUID->"b8ad6256-5954-4bf6-bfdf-590a80fe0ce9"],

Cell["\<\
Evolution stops at the first row that equals an earlier row; the repeated row \
is included as the last element.\
\>", "Notes",
 CellID->937811293,ExpressionUUID->"ba0a984c-a293-4b3a-a75d-d34c092ec6ad"],

Cell[TextData[{
 "With maximal step count ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "ac0f1943-0a17-4531-862e-1722ec1153a1"],
 " the result has at most ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "500d3ab7-f92f-4c34-adb5-08ee15049b53"],
 " rows, whether or not a repetition occurred."
}], "Notes",
 CellID->996295038,ExpressionUUID->"7e0d30fc-a298-488f-bf7f-22e2f90c48e5"],

Cell[TextData[{
 "On rows of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "c884136c-86a3-459e-aa9d-25cfc8a4880c"],
 " over ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "6bb288da-9db1-4c20-96ff-4fc2f7fe2951"],
 " symbols a repetition always occurs within ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "c4b30018-cdaf-4ff2-a1b3-e52623642ce9"],
 " steps."
}], "Notes",
 CellID->293964774,ExpressionUUID->"2add9973-c906-4b81-bb09-c6f49e1f15f6"]
}, Open  ]],

