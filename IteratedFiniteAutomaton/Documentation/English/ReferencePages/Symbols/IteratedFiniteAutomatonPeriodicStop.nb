Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonPeriodicStop", "ObjectName",
 CellID->653740503,ExpressionUUID->"2a8f397b-41e8-4662-b015-b984fb4520de"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"202af304-c816-4ada-88df-66712e8b7b5f"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "077bda85-83ce-4d09-b6b6-5aaae71d6ec6"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton until a row repeats.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"60e3e082-cd8f-4ac1-becf-7335daca3629"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "40ba20e6-fb9d-47f4-894c-32d04d54bba9"],
 " \[LineSeparator]",
 "starts in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "19e7e319-133d-4536-ac2c-8ed31b41c0de"],
 " and evolves at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "39b1e1ee-8a9b-4251-994d-2ac7c730fadb"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"609606eb-bee1-4eff-96f1-15b8b043a1cf"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "c05d8103-4719-4453-963c-7e0bae0d44a3"],
 " \[LineSeparator]",
 "is the operator form."
}], "Usage",
 CellID->812036693,ExpressionUUID->"d9831871-c33e-4b5d-898a-d1d8e178fdc2"],

Cell["\<\
Evolution stops at the first row that equals an earlier row; the repeated row \
is included as the last element.\
\>", "Notes",
 CellID->831344863,ExpressionUUID->"49762b1a-3d40-4caa-a932-402f3b172d26"],

Cell[TextData[{
 "With maximal step count ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "08ffccb9-b599-4c37-aabd-763eff91332a"],
 " the result has at most ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "1612874f-5a6a-40a5-ac47-f32993842f1f"],
 " rows, whether or not a repetition occurred."
}], "Notes",
 CellID->698631718,ExpressionUUID->"dadcf88f-99df-46ec-8f7f-61cc15df5d60"],

Cell[TextData[{
 "On rows of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "696e9cc2-0fb3-41a3-92dc-a48e08ed0dd5"],
 " over ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "d97c127a-358b-42ba-9015-db208d2c2952"],
 " symbols a repetition always occurs within ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "f35b6e7a-98b1-49e8-b1d0-21023610f1c9"],
 " steps."
}], "Notes",
 CellID->380668998,ExpressionUUID->"b1d2ae4e-7c2b-4fa3-8fda-b30b616b313a"]
}, Open  ]],

