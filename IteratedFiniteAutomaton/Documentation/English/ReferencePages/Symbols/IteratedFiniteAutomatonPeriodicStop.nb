Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonPeriodicStop", "ObjectName",
 CellID->436622499,ExpressionUUID->"5e48c180-8231-4291-85fc-3d4985cacb96"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"71135d08-198e-4639-9df4-241b0d4f6ea2"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9c080deb-b29c-434c-b506-316d38a44560"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton until a row repeats.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"496c5618-efbd-4845-9b6c-d8073151882c"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3d376463-0e9b-4745-ad2a-562448d80ca0"],
 " \[LineSeparator]",
 "starts in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "73192948-4f0d-4854-b1b2-9b9120afea58"],
 " and evolves at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "88074770-e676-4958-b98c-a9e607c87010"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4c2610a7-86f3-403a-914b-4b28bd88f6d1"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonPeriodicStop", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "005fe710-bd40-4f71-971a-28d04a17e060"],
 " \[LineSeparator]",
 "is the operator form."
}], "Usage",
 CellID->412879331,ExpressionUUID->"77c1fcf7-142a-4730-92cb-d6f45032b210"],

Cell["\<\
Evolution stops at the first row that equals an earlier row; the repeated row \
is included as the last element.\
\>", "Notes",
 CellID->702992279,ExpressionUUID->"e36afb96-7016-4955-b111-f4668ee95c69"],

Cell[TextData[{
 "With maximal step count ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "37090196-9c7b-41f9-8543-67f03503f84c"],
 " the result has at most ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "53d934f5-1531-4999-81a1-eedb7906bfbf"],
 " rows, whether or not a repetition occurred."
}], "Notes",
 CellID->594455958,ExpressionUUID->"bf06aee5-a8e8-49e9-8770-59dd2b52b577"],

Cell[TextData[{
 "On rows of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "2cadcb6d-b1a6-4a83-94b1-2a3751091d1e"],
 " over ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "91f29dfc-9632-43c9-9704-f36cca380af5"],
 " symbols a repetition always occurs within ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "4f87ed15-084a-4466-8c37-56a254f57cf5"],
 " steps."
}], "Notes",
 CellID->648052611,ExpressionUUID->"51a055a2-89fb-4c2b-b34d-2546104a4d54"]
}, Open  ]],

