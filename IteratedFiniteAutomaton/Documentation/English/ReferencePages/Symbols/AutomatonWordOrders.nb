Cell[CellGroupData[{
Cell["AutomatonWordOrders", "ObjectName",
 CellID->609059878,ExpressionUUID->"054421ff-5e19-4e0a-b52f-37f396259462"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"06fd3198-f2c7-4144-89a8-d646b32fd7e6"],
 Cell[BoxData[
  RowBox[{"AutomatonWordOrders", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["word", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ed1842e2-ee3d-47c7-aa4e-ad9d2e0fc502"],
 " \[LineSeparator]",
 "gives the order of ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "e42fe191-c4fc-44bd-b6ce-e7c09daf455a"],
 " in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "1d5d969f-0869-4720-a7f6-011b2a049dd9"],
 " for each level in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "2a5f9cfc-640d-4ac3-a474-6c2f538c4902"],
 "."
}], "Usage",
 CellID->942509003,ExpressionUUID->"34839775-49bf-4faf-a7e1-348e46a828ac"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "fb23c727-990f-4086-8834-937baef873bd"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "b247af78-0f82-4c68-aa96-45b910cdae99"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "46c58dc3-57b8-4729-b030-37b917f703fe"],
 "."
}], "Notes",
 CellID->603452707,ExpressionUUID->"b7c96af1-b973-4b31-bc4c-b1f400551466"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "8886b873-be0d-45fa-8d68-a9ffef1c70a7"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "05df79ce-5927-4086-a3a3-0c366c1131d7"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "b0a99098-ad23-4632-93d3-cf37fd771695"],
 "."
}], "Notes",
 CellID->946537122,ExpressionUUID->"dbb6b6ce-a33b-4146-8137-eb37f832a70a"],

Cell["\<\
The orders are nondecreasing in the level, since a deeper quotient refines a \
shallower one.\
\>", "Notes",
 CellID->525280136,ExpressionUUID->"371553a4-09b4-438b-88b3-a788d49f2ee4"],

Cell[TextData[{
 "They are constant from some level on exactly when ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "868770b5-9552-4cd3-98bd-fa37e8c2699f"],
 " has finite order in the automaton group."
}], "Notes",
 CellID->801823809,ExpressionUUID->"b72202a3-27f4-4841-9c03-bc0a33be78af"]
}, Open  ]],

