Cell[CellGroupData[{
Cell["AutomatonWordOrders", "ObjectName",
 CellID->374062489,ExpressionUUID->"50fab4fb-e805-44ea-ad04-efe28d6bc8ae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2f1ae8e4-b307-468a-bbcd-fce5a30a0d2e"],
 Cell[BoxData[
  RowBox[{"AutomatonWordOrders", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["word", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "55318c7a-e71c-45f2-b495-6c3ce0eda1ac"],
 " \[LineSeparator]",
 "gives the order of ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "24b910ac-9779-4e37-800f-d63a398700f7"],
 " in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "d7a0d7d0-f11d-47d0-9a4a-9d32afb332d7"],
 " for each level in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "d0de40af-0061-4680-8585-e825097bb06a"],
 "."
}], "Usage",
 CellID->631683263,ExpressionUUID->"5574e396-ec3c-40a0-b5e0-3297a32a5661"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "81c714cc-4adb-421a-80c2-00eef8b17587"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "029010f2-7fc9-40d0-96cf-1d6e22691317"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "fe9a4922-eb0c-48fc-9ba1-dff70c35266d"],
 "."
}], "Notes",
 CellID->536029195,ExpressionUUID->"fe275a5c-b3d6-4bf4-8a37-9aec4e6b3743"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "30ae4486-eaa4-4bca-8c36-5545d1ea7689"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "ade6090e-ae56-4a4d-9660-5f77faa1bcca"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "858c16b5-9054-42b0-9517-1cb7e0563975"],
 "."
}], "Notes",
 CellID->222951710,ExpressionUUID->"2df9bc34-c235-4c41-806e-7322927f09dd"],

Cell["\<\
The orders are nondecreasing in the level, since a deeper quotient refines a \
shallower one.\
\>", "Notes",
 CellID->743334305,ExpressionUUID->"57b56747-5263-4ec3-9873-f9f08f4125aa"],

Cell[TextData[{
 "They are constant from some level on exactly when ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "b08e15e2-fb6e-4b43-a79a-499cc2ab95eb"],
 " has finite order in the automaton group."
}], "Notes",
 CellID->880325903,ExpressionUUID->"3e1de36a-babc-441a-845b-9c4af97a6028"]
}, Open  ]],

