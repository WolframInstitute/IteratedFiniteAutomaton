Cell["\<\
The transitions form a set, not a sequence, so reordering them does not \
change the code:\
\>", "ExampleText",
 CellID->540599608,ExpressionUUID->"f66fab7d-4ae1-4e7d-a19d-3a82ec69f712"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AutomatonCodeFromRule", "[", 
   RowBox[{"Reverse", "[", 
    RowBox[{"AutomatonRuleFromCode", "[", 
     RowBox[{"{", 
      RowBox[{"62", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "]"}], "===", 
  RowBox[{"AutomatonCodeFromRule", "[", 
   RowBox[{"AutomatonRuleFromCode", "[", 
    RowBox[{"{", 
     RowBox[{"62", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->692755429,ExpressionUUID->"26ad93b5-1c73-499a-ad3f-e824af0df3db"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->338384200,ExpressionUUID->"c35eae7d-7011-47af-8bf7-00ed43ef7d3b"]
}, Open  ]]
}, Open  ]],

