Cell["\<\
The transitions form a set, not a sequence, so reordering them does not \
change the code:\
\>", "ExampleText",
 CellID->408050450,ExpressionUUID->"e427a7f3-8ef2-4d64-81a0-7bacdec16014"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AutomatonCodeFromRule", "[", 
   RowBox[{"Reverse", "[", 
    RowBox[{"AutomatonRuleFromCode", "[", 
     RowBox[{"{", 
      RowBox[{"62", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "]"}], "===", 
  RowBox[{"AutomatonCodeFromRule", "[", 
   RowBox[{"AutomatonRuleFromCode", "[", 
    RowBox[{"{", 
     RowBox[{"62", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->876838187,ExpressionUUID->"1976e154-be04-4f98-bf8d-8e037e1b85f8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->515440262,ExpressionUUID->"4023d075-3013-4433-878c-2d490197a515"]
}, Open  ]]
}, Open  ]],

