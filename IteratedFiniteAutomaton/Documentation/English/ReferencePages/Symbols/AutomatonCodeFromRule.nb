Cell["The adding machine, written out as transitions, is code 62:", \
"ExampleText",
 CellID->820406147,ExpressionUUID->"128f0b52-afdd-4672-be37-2b4576d00432"],

Cell[BoxData[
 RowBox[{"AutomatonCodeFromRule", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->505059108,ExpressionUUID->"e1721b83-f07d-4f86-8b52-1e3acec05213"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"62", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->457691748,ExpressionUUID->"d5ac634e-510e-4f32-a930-45487962d50c"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"ebd54b7e-3f99-4830-832b-d13b9aae4fad"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->346755161,ExpressionUUID->"25076bd0-5ef3-4757-9e7a-7e2ed2fdb738"],

Cell["\<\
A converter returns an explicit rule, so its code names the automaton it \
compiled:\
\>", "ExampleText",
 CellID->694636201,ExpressionUUID->"d89c05a0-71be-4808-a85c-30be6298726e"],

Cell[BoxData[
 RowBox[{"AutomatonCodeFromRule", "[", 
  RowBox[{
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->292952186,ExpressionUUID->"97192833-f0c7-4e05-a298-7b8741b651fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"62", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->400191499,ExpressionUUID->"077fad92-5677-4689-b7b2-022feb04d236"]
}, Open  ]],

