Cell["The adding machine, written out as transitions, is code 62:", \
"ExampleText",
 CellID->788876284,ExpressionUUID->"e202ec57-f00b-497c-bf8d-5fde1dcf08aa"],

Cell[BoxData[
 RowBox[{"AutomatonCodeFromRule", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->599985786,ExpressionUUID->"04e2bd67-870d-4cce-91de-8d370ecfaa42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"62", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->610613982,ExpressionUUID->"06e82f18-f942-4b65-8fa8-ecf075f42cf9"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"4fccb07a-9963-479f-b8e9-665e1c56ab3c"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->351396987,ExpressionUUID->"af09e7ee-0a6d-4981-8200-d06315d91a2f"],

Cell["\<\
A converter returns an explicit rule, so its code names the automaton it \
compiled:\
\>", "ExampleText",
 CellID->181273951,ExpressionUUID->"90732da6-3f7a-413a-b080-cd675c7e7d0b"],

Cell[BoxData[
 RowBox[{"AutomatonCodeFromRule", "[", 
  RowBox[{
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->854190223,ExpressionUUID->"7efbbf3a-228f-4dc9-af03-676f1c4a87f2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"62", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->604728348,ExpressionUUID->"a49b876a-ee41-4b94-a467-5e85e7db4485"]
}, Open  ]],

