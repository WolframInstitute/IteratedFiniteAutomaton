Cell[CellGroupData[{
Cell["AutomatonRuleFromCode", "ObjectName",
 CellID->403001362,ExpressionUUID->"cd4ef189-ad4e-49f6-a650-254addf86cdf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"837c7adf-c759-481b-a01b-875622b2d794"],
 Cell[BoxData[
  RowBox[{"AutomatonRuleFromCode", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["k", "TI"]}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"e6b50953-a83d-4c5c-a079-35d44cbe8670"],
 " \[LineSeparator]",
 "gives the Mealy rule ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "822c8325-bd69-4444-98c8-a3b0b2e455ce"],
 " of the automaton numbered ",
 Cell[BoxData[
  StyleBox["code", "TI"]], "InlineFormula",ExpressionUUID->
  "0b6fa13a-82ea-47c5-a15a-80bc10f371ec"],
 " over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "95d30e34-5a0d-46e1-9dfe-7e6fb69cbab4"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "c3667619-1c41-4cc6-b842-8499343faefd"],
 " symbols."
}], "Usage",
 CellID->788205344,ExpressionUUID->"ef3ae587-0770-46d8-973e-4f9c83d3a72a"],

Cell[TextData[{
 "The code runs over 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["s", "TI"], " ", 
      StyleBox["k", "TI"]}], ")"}], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "263a0b5e-ff5e-4275-8147-e3a0a265d42c"],
 "; its base ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "53c00f01-6fbc-4bb9-9008-2945bacbe5f1"],
 " digits list the transitions."
}], "Notes",
 CellID->487513825,ExpressionUUID->"305595ae-8749-42dc-8623-bed85486442a"],

Cell[TextData[{
 "The rule has one transition per state-symbol pair, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "50a354a5-2c82-4771-9606-5abe833602a3"],
 " of them."
}], "Notes",
 CellID->103729502,ExpressionUUID->"96d04490-df84-40f4-877d-14037590dfe2"],

