Cell[CellGroupData[{
Cell["AutomatonRuleFromCode", "ObjectName",
 CellID->276921567,ExpressionUUID->"b0b43d90-284b-4535-a199-4fb2331a645a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"85379a8b-2148-4cff-9520-e16aef9f97b8"],
 Cell[BoxData[
  RowBox[{"AutomatonRuleFromCode", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["k", "TI"]}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"354e2236-7634-4323-ad69-f3dd79b8e949"],
 " \[LineSeparator]",
 "gives the Mealy rule ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "72911e37-d098-4de6-9526-2fcae673c736"],
 " of the automaton numbered ",
 Cell[BoxData[
  StyleBox["code", "TI"]], "InlineFormula",ExpressionUUID->
  "4a09069a-7cc2-42ea-b45b-473171215c5b"],
 " over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "5293688a-e3f2-416a-a191-4f854ab262c4"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "114e5da1-04c2-4a4e-87be-f164699c1ff2"],
 " symbols."
}], "Usage",
 CellID->907974080,ExpressionUUID->"0f3c65c0-c5ec-40b6-ba52-f21084c1a966"],

Cell[TextData[{
 "The code runs over 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["s", "TI"], " ", 
      StyleBox["k", "TI"]}], ")"}], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "f8abedd8-60b8-42cf-8120-15ff3e9993fe"],
 "; its base ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "1cb8945c-b1dc-47f5-a27d-38279b449381"],
 " digits list the transitions."
}], "Notes",
 CellID->378276700,ExpressionUUID->"27d143fc-d52d-47c2-bd90-425a50c2b1db"],

Cell[TextData[{
 "The rule has one transition per state-symbol pair, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"]}]], "InlineFormula",ExpressionUUID->
  "c5ecfb82-45de-4a5d-8819-ecf8d287d8e2"],
 " of them."
}], "Notes",
 CellID->236645867,ExpressionUUID->"67385738-5c0e-4c2e-b370-af0d50c802dd"],

