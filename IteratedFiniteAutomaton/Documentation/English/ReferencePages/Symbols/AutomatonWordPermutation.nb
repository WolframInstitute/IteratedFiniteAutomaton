Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordPermutation", "ObjectName",
 CellID->162145766,ExpressionUUID->"6cd10900-48f1-4323-b765-5461615f3254"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7286b0c7-b8e1-46de-a093-cdb3acebd722"],
 Cell[BoxData[
  RowBox[{"AutomatonWordPermutation", "[", 
   StyleBox["perms", "TI"], ",", 
   StyleBox["word", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e447f44b-eb5d-4268-a137-5b9ea47108f7"],
 " \[LineSeparator]",
 "gives the permutation of the level vertices induced by ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "c44b6f70-5634-4450-a04a-3159c68b69b0"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["perms", "TI"], "=", 
   RowBox[{"AutomatonLevelPermutations", "[", 
    RowBox[{
     StyleBox["automaton", "TI"], ",", 
     StyleBox["level", "TI"]}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "cec74dcd-e968-4d26-bda7-5ff641be466f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cce7c918-eb4f-4871-ac44-8018f241e7aa"],
 Cell[BoxData[
  RowBox[{"AutomatonWordPermutation", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], ",", 
   StyleBox["word", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3311d165-2e75-430a-ab6d-307f1e3d43fc"],
 " \[LineSeparator]",
 "builds ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "ef01c765-45fb-4b12-a16f-ddc13b581c4f"],
 " first."
}], "Usage",
 CellID->119611765,ExpressionUUID->"d4f423b6-2434-4e7e-84ad-b6580ebc8abb"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "dffaaec7-0a68-477c-b89f-1785a7890851"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "3dcb519f-b76c-4270-a015-03dc20c3ed23"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "0add559f-a467-40e3-a83e-342cf0f242e1"],
 "."
}], "Notes",
 CellID->176913367,ExpressionUUID->"500cea82-f90b-4053-ad05-09a7897894e3"],

Cell["\<\
The letters compose left to right, and an inverse letter acts by the inverse \
permutation.\
\>", "Notes",
 CellID->930787415,ExpressionUUID->"6b33707b-edee-4ce2-af0e-3b9f6ff03568"],

Cell[TextData[{
 "The empty word gives the identity permutation ",
 Cell[BoxData[
  RowBox[{"Range", "[", 
   SuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["level", "TI"]], "]"}]], "InlineFormula",ExpressionUUID->
  "1a107840-db34-40f4-8a7b-9591298bb391"],
 "."
}], "Notes",
 CellID->316634929,ExpressionUUID->"2b6e95b6-a0fe-46e9-becc-b4adb3974063"],

Cell[TextData[{
 "Passing ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "fe072f56-7730-46b0-8dbe-853ef22ec8f4"],
 " reuses one level computation across many words, which is what makes the \
ball and group-ring searches affordable."
}], "Notes",
 CellID->306807912,ExpressionUUID->"6a3cf884-61de-4fa2-9605-f71022b518c8"]
}, Open  ]],

