Cell["\<\
The three-argument form builds the level permutations itself:\
\>", "ExampleText",
 CellID->745665206,ExpressionUUID->"dd1a5909-727d-4f52-a52c-df60e165a1cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AutomatonWordPermutation", "[", 
   RowBox[{
    RowBox[{"AutomatonLevelPermutations", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8950703898", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "4"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "===", 
  RowBox[{"AutomatonWordPermutation", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"8950703898", ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->386948448,ExpressionUUID->"03986323-2568-4656-a311-2f113fbe6d98"],

