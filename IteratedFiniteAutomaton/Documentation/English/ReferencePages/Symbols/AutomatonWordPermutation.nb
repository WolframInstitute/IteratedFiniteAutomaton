Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordPermutation", "ObjectName",
 CellID->562528327,ExpressionUUID->"60cabb08-3c26-4408-8b98-ad32a93d9772"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"118134fe-b723-4798-b238-9090493497d6"],
 Cell[BoxData[
  RowBox[{"AutomatonWordPermutation", "[", 
   StyleBox["perms", "TI"], ",", 
   StyleBox["word", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "45345c66-8647-4cd3-841a-8cfb5e98dd84"],
 " \[LineSeparator]",
 "gives the permutation of the level vertices induced by ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "6c539de5-61aa-412b-9fe1-5d4b91e42e50"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["perms", "TI"], "=", 
   RowBox[{"AutomatonLevelPermutations", "[", 
    RowBox[{
     StyleBox["automaton", "TI"], ",", 
     StyleBox["level", "TI"]}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "c5843ad3-c522-4445-aeba-e1370c2b489d"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7aa3f07f-a181-4d61-8f25-4e7ef953d0ee"],
 Cell[BoxData[
  RowBox[{"AutomatonWordPermutation", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], ",", 
   StyleBox["word", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8b2d63be-e80d-4ee8-b0c8-cb8305ab1bfb"],
 " \[LineSeparator]",
 "builds ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "eed0a7e2-4ff3-45e9-94f9-df23ceeec012"],
 " first."
}], "Usage",
 CellID->973457623,ExpressionUUID->"29a358a5-f4c0-46fa-9b37-5fe48f6d82b5"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "fcface8a-b89e-40a6-a4a7-9e30813ec56c"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "3e67e7d6-45f1-4aaf-855f-eec55b51790f"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "c2fb38bc-72b8-41e8-bd5f-5c4df2fe8673"],
 "."
}], "Notes",
 CellID->208092061,ExpressionUUID->"fa0fd854-f512-406c-9b30-cb597af7dbf8"],

Cell["\<\
The letters compose left to right, and an inverse letter acts by the inverse \
permutation.\
\>", "Notes",
 CellID->923134106,ExpressionUUID->"95991c84-77fd-4747-8752-ac2f5a78371c"],

Cell[TextData[{
 "The empty word gives the identity permutation ",
 Cell[BoxData[
  RowBox[{"Range", "[", 
   SuperscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["level", "TI"]], "]"}]], "InlineFormula",ExpressionUUID->
  "b88c0c4b-424f-4e0f-bf06-760a578632c8"],
 "."
}], "Notes",
 CellID->200984644,ExpressionUUID->"6bc5f99f-b351-4122-b321-b59656c13a60"],

Cell[TextData[{
 "Passing ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "63d8ce9c-3f2c-46c6-86dd-9a309071cf14"],
 " reuses one level computation across many words, which is what makes the \
ball and group-ring searches affordable."
}], "Notes",
 CellID->414963102,ExpressionUUID->"85cdee06-6abd-4342-b4ff-4e82fa34c158"]
}, Open  ]],

