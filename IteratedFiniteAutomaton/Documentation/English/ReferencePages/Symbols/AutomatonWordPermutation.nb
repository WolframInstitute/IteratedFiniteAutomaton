Cell["\<\
The three-argument form builds the level permutations itself:\
\>", "ExampleText",
 CellID->875386051,ExpressionUUID->"8db43552-1d5e-4269-82e8-92214fd6f510"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AutomatonWordPermutation", "[", 
   RowBox[{
    RowBox[{"AutomatonLevelPermutations", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8950703898", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "4"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "===", 
  RowBox[{"AutomatonWordPermutation", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"8950703898", ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->479101543,ExpressionUUID->"b264e82e-f3b7-432a-be39-3517f1445241"],

