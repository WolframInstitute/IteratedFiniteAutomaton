Notebook[{

Cell[CellGroupData[{
Cell["AutomatonAbelianQ", "ObjectName",
 CellID->267862062,ExpressionUUID->"4fede2f0-49e4-4dc4-a5c0-b563f900bfbd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65e210f6-41f6-4f5a-a2d5-d04490ad4eb7"],
 Cell[BoxData[
  RowBox[{"AutomatonAbelianQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2707f7e8-62fd-4155-bcaf-0dee025eae7a"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "c373ca2d-e4de-42ef-94e7-edbe731d1fcc"],
 " if the generators commute in the level quotient."
}], "Usage",
 CellID->200531246,ExpressionUUID->"af5551b2-4468-421c-bd40-d95b04087b40"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "3b507776-669e-4501-b66d-d7a016d9bca3"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "21ef4020-8941-487d-bdf8-79c18ec910ed"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "6a1cf3a4-a643-4afa-9c64-e778cca1bf16"],
 "."
}], "Notes",
 CellID->695467442,ExpressionUUID->"cee23f9d-01bc-46a4-b139-9e3e3794446f"],

Cell["\<\
Only the generators are tested; that is enough, since generators that commute \
pairwise generate an abelian group.\
\>", "Notes",
 CellID->733903787,ExpressionUUID->"9d9d7ae3-b402-4b5d-982d-caa5ab55aabc"],

Cell["\<\
The level quotients are nested, so a group that is nonabelian at some level \
is nonabelian at every deeper one.\
\>", "Notes",
 CellID->826799159,ExpressionUUID->"caa1c22c-112c-4205-8fce-c737781d03d5"]
}, Open  ]],

