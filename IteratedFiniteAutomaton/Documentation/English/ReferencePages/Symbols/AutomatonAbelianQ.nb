Notebook[{

Cell[CellGroupData[{
Cell["AutomatonAbelianQ", "ObjectName",
 CellID->826667837,ExpressionUUID->"bb36a4b8-5548-4ecc-8543-74c1e3e8ef36"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"994a4b55-e4d1-4db3-9c78-ddcceaf7b3dc"],
 Cell[BoxData[
  RowBox[{"AutomatonAbelianQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3b96dfd7-166e-404a-a635-5438fbc152f7"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "02d3153d-7297-495e-91f6-e07ab9463b18"],
 " if the generators commute in the level quotient."
}], "Usage",
 CellID->557811485,ExpressionUUID->"125655ca-de96-4e8f-b4e0-1f55572cf5dd"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "386ae415-767a-425a-b11a-a4a966e7e5a1"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "dd8220ad-af76-4a2a-8e7a-cfdfd0262a87"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c4034a20-ba53-4d0c-90f6-7789cfdeb28b"],
 "."
}], "Notes",
 CellID->340513260,ExpressionUUID->"e53d0fae-6b6e-4f87-9ea9-7aa0876d57d4"],

Cell["\<\
Only the generators are tested; that is enough, since generators that commute \
pairwise generate an abelian group.\
\>", "Notes",
 CellID->205231377,ExpressionUUID->"652bb3ae-e3e8-4e5c-8d1d-5d3279f3583f"],

Cell["\<\
The level quotients are nested, so a group that is nonabelian at some level \
is nonabelian at every deeper one.\
\>", "Notes",
 CellID->985466441,ExpressionUUID->"d9315f73-e2f8-4fed-9516-6c4012c1ad64"]
}, Open  ]],

