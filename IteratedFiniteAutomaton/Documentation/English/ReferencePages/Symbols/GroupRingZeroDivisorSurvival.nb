Notebook[{

Cell[CellGroupData[{
Cell["GroupRingZeroDivisorSurvival", "ObjectName",
 CellID->224033161,ExpressionUUID->"ebde39af-d354-456e-b241-33c5913f6fac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ed36b1a-37bf-4cce-bda5-c9126979d597"],
 Cell[BoxData[
  RowBox[{"GroupRingZeroDivisorSurvival", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "26d4cec5-7ceb-4f30-8023-45ea6d629926"],
 " \[LineSeparator]",
 "searches over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "c196ac0b-c887-4667-a366-2dde8b60d6df"],
 " for elements ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "d0b6b3cc-c41f-474f-b400-170a59ffd596"],
 " supported on the radius ball whose left annihilator is nonempty in every \
level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "ff737c27-e653-4f99-95fa-a710765ba363"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Support\>\"", ",", "\"\<Counts\>\"", 
    ",", "\"\<Survivors\>\"", ",", "\"\<Annihilators\>\""}], 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "8aedc9ea-7564-402b-9e6a-55bc07c7ec16"],
 "."
}], "Usage",
 CellID->507471014,ExpressionUUID->"9bc33348-81a5-4ee9-9ba1-ea53558fe481"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "55021780-4a78-4e8d-884d-5e1b354d0b85"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "267ec144-17e6-48b7-b241-91a434c5c8fb"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "58756015-e02c-47c7-904a-48a15de57d72"],
 " is 1."
}], "Notes",
 CellID->197379841,ExpressionUUID->"df69dfc9-5eef-4f85-8618-18513bc640d7"],

Cell[TextData[{
 "Each surviving ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "aaf4f3ec-09f1-42ed-92a6-332b8fd2f08c"],
 " is paired with a witness ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",ExpressionUUID->
  "7bac8a63-9b95-4040-baf1-41352b102372"],
 " satisfying ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], " ", 
   StyleBox["B", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "d0550906-16d7-4ebe-87fa-124507b257ad"],
 " at every tested level, so a survivor is a candidate counterexample to the \
Kaplansky zero divisor conjecture and an empty \"Survivors\" refutes one \
radius over one field."
}], "Notes",
 CellID->397382808,ExpressionUUID->"8e466a4b-2afc-4d2d-9c8e-e5956838d118"],

Cell[TextData[{
 "Candidates are taken up to scale, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], " ", 
   StyleBox["B", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "e4f78e2d-6c2f-4c27-b00b-75b75a757e86"],
 " is scale invariant."
}], "Notes",
 CellID->523023824,ExpressionUUID->"ceb5da3b-d30f-4df1-b2e1-5d2d635a12eb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<Tower\>\""}]], 
  "InlineFormula",ExpressionUUID->"d82ebdb1-f626-44b3-8865-f16274317bc3"],
 " (the default) filters level by level using precomputed 0/1 matrices for \
left multiplication; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<Annihilator\>\""}]], 
  "InlineFormula",ExpressionUUID->"43b19041-446d-4a8e-8990-4877c25f81c2"],
 " instead takes one nullspace per candidate, stacked across all levels at \
once."
}], "Notes",
 CellID->381395891,ExpressionUUID->"d7b7c413-38d2-41cb-9a4c-9a8c62536f3b"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MaxTerms",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/MaxTerms"]], 
  "InlineFormula",ExpressionUUID->"b2f83ff5-e066-4a14-b2e3-b398a8e34301"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "bdcd7a51-6e23-4827-9300-7a61b69f4093"],
 " restricts ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "8e1bb623-e55d-40b4-bb62-0bf3dc304a86"],
 " to at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "1a6bbabc-efbf-49b1-bdb1-c5e55f2e43fe"],
 " nonzero terms; ",
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "fdaa68e3-fadc-4219-89d7-552f077f1f43"],
 " selects the field and defaults to 2."
}], "Notes",
 CellID->671315562,ExpressionUUID->"5be8a649-0ae5-4efd-9a10-3a47878fceb9"]
}, Open  ]],

