Notebook[{

Cell[CellGroupData[{
Cell["GroupRingZeroDivisorSurvival", "ObjectName",
 CellID->649754548,ExpressionUUID->"2a5a6df1-2f78-482d-97e8-adaf7a454b09"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cca450d3-e061-49b8-9c75-df3535c0c343"],
 Cell[BoxData[
  RowBox[{"GroupRingZeroDivisorSurvival", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ebba7425-cde9-47e4-bd7f-08b33d058e94"],
 " \[LineSeparator]",
 "searches over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "6e119409-0abb-4928-86f6-06de1d1aaab3"],
 " for elements ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "7a74393d-b3c6-45b2-a032-f0b582a9a943"],
 " supported on the radius ball whose left annihilator is nonempty in every \
level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "543e3afe-50cd-4e34-b907-19787f2d2d76"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Support\>\"", ",", "\"\<Counts\>\"", 
    ",", "\"\<Survivors\>\"", ",", "\"\<Annihilators\>\""}], 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "ba8a0e0b-8a9a-47dc-977f-31f5b5b8d71e"],
 "."
}], "Usage",
 CellID->657226678,ExpressionUUID->"a02e961f-8928-43a6-ad8e-d13a286396ba"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "192e6b0f-2399-4a1c-a189-4e2296910e51"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "57bcf6f6-1323-4008-bba4-e1ef8035960a"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "ddf3189c-ae30-4918-9f8f-eeb32ca07ab7"],
 " is 1."
}], "Notes",
 CellID->208264108,ExpressionUUID->"3a76fe63-1d1c-4aab-83e1-397652e979f5"],

Cell[TextData[{
 "Each surviving ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "1ec6da37-a5f2-4a74-beac-9d7bd3a3bae6"],
 " is paired with a witness ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",ExpressionUUID->
  "ce0fa22a-ca16-4426-9258-fa0ae091a226"],
 " satisfying ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], " ", 
   StyleBox["B", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "335a3591-18a0-484a-9111-076cc866ed9e"],
 " at every tested level, so a survivor is a candidate counterexample to the \
Kaplansky zero divisor conjecture and an empty \"Survivors\" refutes one \
radius over one field."
}], "Notes",
 CellID->447294136,ExpressionUUID->"8d3a208e-565f-45a0-9826-06b110fe6be3"],

Cell[TextData[{
 "Candidates are taken up to scale, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], " ", 
   StyleBox["B", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "88f21ef6-ddd6-4005-807a-8110d3a3e9ac"],
 " is scale invariant."
}], "Notes",
 CellID->517052987,ExpressionUUID->"caa215db-7027-435d-89fb-df7c2c23b68a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<Tower\>\""}]], 
  "InlineFormula",ExpressionUUID->"eb64c2e0-8b47-430d-bcde-00c230d93ced"],
 " (the default) filters level by level using precomputed 0/1 matrices for \
left multiplication; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<Annihilator\>\""}]], 
  "InlineFormula",ExpressionUUID->"285de2fa-e2e3-4d10-bd35-93438736b1bc"],
 " instead takes one nullspace per candidate, stacked across all levels at \
once."
}], "Notes",
 CellID->944076398,ExpressionUUID->"a993f0f6-5073-48be-afd3-1adcb2921ce0"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MaxTerms",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/MaxTerms"]], 
  "InlineFormula",ExpressionUUID->"9fbeaa1f-1bec-4727-be57-ea2f16cd5b8e"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "98a45a78-b84a-4e66-b97f-4529dd0a64a9"],
 " restricts ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",ExpressionUUID->
  "a12baba9-f6c0-4504-aec4-238b96d908b1"],
 " to at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "39c77c27-d8d3-40cf-bef2-3cd93b0b89b8"],
 " nonzero terms; ",
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "b7fe2a93-1f74-4b4c-81c0-eaafca1d157e"],
 " selects the field and defaults to 2."
}], "Notes",
 CellID->726132243,ExpressionUUID->"1f6c41df-f75c-4843-9333-5213b5344633"]
}, Open  ]],

