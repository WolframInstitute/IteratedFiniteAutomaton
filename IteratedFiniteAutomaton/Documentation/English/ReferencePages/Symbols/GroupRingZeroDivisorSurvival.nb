Cell["\<\
The Grigorchuk group has torsion, so zero divisors are expected and eight of \
them survive the whole tower:\
\>", "ExampleText",
 CellID->191139824,ExpressionUUID->"ed46a1b2-cdd1-4175-bdcb-0e0b210d1e62"],

