Cell["\<\
Any alphabet size is allowed; the 3-adic odometer a = (1, 2, 0; id, id, a) \
counts in base 3:\
\>", "ExampleText",
 CellID->510386879,ExpressionUUID->"1fe452c6-ad80-4de4-9c07-0a16e6d48ae3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"odometer", "=", 
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<a\>\""}], 
           "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<id\>\""}], 
           "}"}]}], "}"}]}]}], "]"}], ",", "\"\<a\>\""}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->357073415,ExpressionUUID->"98b35a0e-bf7d-4408-a2cc-33f8477d5426"],

