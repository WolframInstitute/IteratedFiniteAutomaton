Cell["\<\
Any alphabet size is allowed; the 3-adic odometer a = (1, 2, 0; id, id, a) \
counts in base 3:\
\>", "ExampleText",
 CellID->480554145,ExpressionUUID->"7c8fd766-bf61-4b71-9bab-e37cd03e7bc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"odometer", "=", 
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<a\>\""}], 
           "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<id\>\""}], 
           "}"}]}], "}"}]}]}], "]"}], ",", "\"\<a\>\""}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->580073626,ExpressionUUID->"711f4429-d188-4305-9a62-f73588bb890f"],

