Cell["\<\
The Mealy and wreath presentations of the adding machine compile to the same \
rule:\
\>", "ExampleText",
 CellID->365405966,ExpressionUUID->"7f6bca0b-e76c-408b-acf9-eba50a45331b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<id\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], "]"}], "===", 
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<lam\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
      ",", "\"\<eps\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->791600319,ExpressionUUID->"01360780-7d8b-40e4-a647-9cb298faaf4a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]=",
 CellID->884932790,ExpressionUUID->"e7006ce6-6a08-47fe-aa0e-d6fa69d5ffaf"]
}, Open  ]],

