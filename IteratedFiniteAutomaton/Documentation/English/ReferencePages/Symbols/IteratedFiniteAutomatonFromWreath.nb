Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromWreath", "ObjectName",
 CellID->205601449,ExpressionUUID->"8eb6ab4c-c9fb-49c5-a5de-6c82d4847fbf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4dd40c01-7b27-4545-8012-c4f3e0a79c18"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "8e666e4e-2f43-49f9-afa8-99c09c00b2ac"],
 " \[LineSeparator]",
 "converts a wreath recursion on symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "192e32af-ecae-409d-bc24-a9d0f07cea96"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->137451963,ExpressionUUID->"bd907dd1-5dd6-47f8-b6b3-234779d8974b"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "7c750f6a-3381-48d5-9eb0-e8197a36c83d"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "0d8a3328-049a-43ec-8e7e-4be29236c807"],
 " in the specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "9975ff8e-be4c-4290-9249-8b564fa514d8"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "935dc7bc-f94e-4249-bee0-c7c5cfe86b6e"],
 "."
}], "Notes",
 CellID->848484136,ExpressionUUID->"70f4d876-9f45-4dc2-ab34-0d242d0491c9"],

Cell[TextData[{
 "The wreath recursion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["o", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["o", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]], ";", 
     SubscriptBox[
      StyleBox["g", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"98052253-95f3-4805-9df9-f1298979f94f"],
 " is the standard presentation of automaton (self-similar) groups."
}], "Notes",
 CellID->875473866,ExpressionUUID->"74250b54-e51c-4b08-adb0-fdee91b7fd08"],

Cell[TextData[{
 "The result has the same form as that of ",
