Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromWreath", "ObjectName",
 CellID->748307806,ExpressionUUID->"34b6d07b-96f3-475b-9c4a-9991f3ee73e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f052e821-2b97-4bdd-8925-cf1857b96318"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "139a9533-6d82-4bd2-86df-9078c9a93da1"],
 " \[LineSeparator]",
 "converts a wreath recursion on symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "8c4d0d3f-6b00-4ee3-bd4c-6e82a5ae301f"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->128584611,ExpressionUUID->"25f29eaa-1174-479f-bdf2-6001d4a65f7c"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "933fb442-0b18-40a1-921a-3b26aa0bbd8e"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "e834a2e8-8f82-4bd6-b3de-95dad17ec034"],
 " in the specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "e998b077-c53f-4af5-9473-9f84c56dfe29"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "1c7658eb-20c4-4fd4-8fdb-54db82b7f772"],
 "."
}], "Notes",
 CellID->600001269,ExpressionUUID->"da47bbee-622e-4a7b-b6df-6fba40c8825c"],

Cell[TextData[{
 "The wreath recursion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["o", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["o", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]], ";", 
     SubscriptBox[
      StyleBox["g", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"4907d20c-10e1-4241-bb02-f3ecd50b78e8"],
 " is the standard presentation of automaton (self-similar) groups."
}], "Notes",
 CellID->459115019,ExpressionUUID->"3a67c53b-e926-4251-a802-e06966222982"],

Cell[TextData[{
 "The result has the same form as that of ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromStates",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromStates"]], "InlineFormula",ExpressionUUID->
  "92175eb9-aa09-4e70-9700-0dacf43d3397"],
 "."
}], "Notes",
 CellID->796149505,ExpressionUUID->"398ad7ee-4087-4936-8b3a-0dc5ef756bc7"]
}, Open  ]],

