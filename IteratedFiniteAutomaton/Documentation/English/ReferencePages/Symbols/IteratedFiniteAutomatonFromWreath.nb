Cell["\<\
The Mealy and wreath presentations of the adding machine compile to the same \
rule:\
\>", "ExampleText",
 CellID->486374040,ExpressionUUID->"230d6316-b296-4c96-9ba7-3649380d7b47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<id\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], "]"}], "===", 
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<lam\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
      ",", "\"\<eps\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->372043018,ExpressionUUID->"68dc1830-3b62-47ed-83e9-bb23dbaca8be"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]=",
 CellID->183973314,ExpressionUUID->"cc80cb7f-5f01-462d-bf16-0cc1c6abe598"]
}, Open  ]],

