Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromWreath", "ObjectName",
 CellID->420230890,ExpressionUUID->"a1bbbacc-9e0a-41b5-bc1d-0ec317bb44a6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9503340-222c-45f7-b20e-b07cec90555d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "c220f3c6-cdca-4930-a0d0-e2f8151da322"],
 " \[LineSeparator]",
 "converts a wreath recursion on symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "ad1bfb7c-9cfd-412e-b822-27e128901689"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->869027601,ExpressionUUID->"31d7df62-83b5-4c2b-b82e-34ad99c47dc8"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "d5ccd45c-3034-48d7-a116-1d9f8a4c55bd"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "29370d57-535c-408c-b94c-32d4e3bbed37"],
 " in the specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "6d68507b-db7b-4101-8539-e1d8c2daad68"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "c3b22ec4-8242-453e-9142-98030da77351"],
 "."
}], "Notes",
 CellID->441594040,ExpressionUUID->"c700281c-36a4-4091-9785-db99e44422ac"],

Cell[TextData[{
 "The wreath recursion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["o", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["o", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]], ";", 
     SubscriptBox[
      StyleBox["g", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"9c0d08ad-9abe-4380-a4fb-cb0422630f3a"],
 " is the standard presentation of automaton (self-similar) groups."
}], "Notes",
 CellID->515133145,ExpressionUUID->"69c49ab5-7b0e-463c-8dc7-ffe84562f3e6"],

Cell[TextData[{
 "The result has the same form as that of ",
