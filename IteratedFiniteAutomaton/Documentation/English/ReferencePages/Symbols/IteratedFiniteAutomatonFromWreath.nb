Cell["\<\
The adding machine as the wreath recursion a = (1, 0; id, a):\
\>", "ExampleText",
 CellID->901114165,ExpressionUUID->"4c4bd495-a741-4990-aded-cc3241288427"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wreath", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<id\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->370827090,ExpressionUUID->"b3f7dc3c-7cfa-4ce3-9e24-5266994ce9dc"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   RowBox[{"wreath", ",", "\"\<a\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->353896879,ExpressionUUID->"5fcaa797-4316-45cc-ab5e-2d8f3f97fb4b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"id\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->899500880,ExpressionUUID->"54fbf86d-e625-47dc-bd13-6f98ed3e61f8"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->170599223,ExpressionUUID->"6e07d377-45e5-44a0-a73a-0d886aecb0e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
