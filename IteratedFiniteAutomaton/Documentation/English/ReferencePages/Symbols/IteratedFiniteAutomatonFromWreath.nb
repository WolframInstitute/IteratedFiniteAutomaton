Cell["The Grigorchuk group as a five-state recursion:", "ExampleText",
 CellID->313760025,ExpressionUUID->"630c312e-3f49-4f60-9578-e96db797c7e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grigorchuk", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<b\>\"", "\[Rule]", 
      RowBox[{"{", 
