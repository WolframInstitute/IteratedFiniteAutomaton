Cell["\<\
The adding machine as the wreath recursion a = (1, 0; id, a):\
\>", "ExampleText",
 CellID->820440468,ExpressionUUID->"cdcf619e-6eff-4499-aaf8-0a55495bc97d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wreath", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<id\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->832362373,ExpressionUUID->"18d1b3d6-fd5f-49cb-84df-9da74247a77a"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   RowBox[{"wreath", ",", "\"\<a\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->386803742,ExpressionUUID->"3b807ee6-046f-4bd1-8af6-deb3ea286300"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"id\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->519173810,ExpressionUUID->"0b2044bd-5cef-4b69-9092-733ea5d180dd"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->202391269,ExpressionUUID->"fbb81674-d8d2-4f45-a086-8839b345b38a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
