 CellID->512175199,ExpressionUUID->"65f0ab31-4033-42b2-9194-93be9b984e79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grigorchuk", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
