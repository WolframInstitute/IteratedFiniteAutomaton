Cell["\<\
The adding machine as the wreath recursion a = (1, 0; id, a):\
\>", "ExampleText",
 CellID->243953034,ExpressionUUID->"00e04f68-c00f-44c5-9f7f-45b0face440d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wreath", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<id\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->361377628,ExpressionUUID->"d24290cd-4750-45b3-b4c3-36cf3ee62990"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   RowBox[{"wreath", ",", "\"\<a\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->690158445,ExpressionUUID->"719846e2-1d79-497e-b1ee-a33b03aed5da"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"id\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->629120729,ExpressionUUID->"1c252769-2f4c-43ee-92f4-82c85258c45b"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->645064403,ExpressionUUID->"963cbdf7-fa7b-4575-b88f-49312fb06319"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
