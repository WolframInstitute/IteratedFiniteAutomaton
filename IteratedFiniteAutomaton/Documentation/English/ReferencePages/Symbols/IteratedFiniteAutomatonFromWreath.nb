Cell["\<\
Any alphabet size is allowed; the 3-adic odometer a = (1, 2, 0; id, id, a) \
counts in base 3:\
\>", "ExampleText",
 CellID->579893394,ExpressionUUID->"b415dd32-7546-4802-ab80-b19d0153cc2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"odometer", "=", 
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<a\>\""}], 
           "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\"", ",", "\"\<id\>\""}], 
           "}"}]}], "}"}]}]}], "]"}], ",", "\"\<a\>\""}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->249232573,ExpressionUUID->"d165753b-47b9-4468-952e-7da6f8791170"],

