  ButtonBox["IteratedFiniteAutomatonFromStates",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromStates"]], "InlineFormula",ExpressionUUID->
  "674d032c-5860-4c6d-9852-545a07e67dbb"],
 "."
}], "Notes",
 CellID->606060500,ExpressionUUID->"26c03c13-f88b-4267-b70e-1fb23986924b"]
}, Open  ]],

