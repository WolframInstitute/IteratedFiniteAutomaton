Cell["\<\
The Mealy and wreath presentations of the adding machine compile to the same \
rule:\
\>", "ExampleText",
 CellID->849287865,ExpressionUUID->"a5058c9e-f200-417e-ba15-986a60712968"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<id\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], "]"}], "===", 
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<lam\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
      ",", "\"\<eps\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->638044591,ExpressionUUID->"6d2ad438-7758-4f95-89d7-1c3131471cc3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]=",
 CellID->337010464,ExpressionUUID->"3c3a3b4c-1103-4fe7-bbe9-2b905f36a490"]
}, Open  ]],

