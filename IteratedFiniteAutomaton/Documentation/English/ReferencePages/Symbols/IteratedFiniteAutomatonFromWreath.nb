Cell["\<\
The adding machine as the wreath recursion a = (1, 0; id, a):\
\>", "ExampleText",
 CellID->265303424,ExpressionUUID->"b01ca624-8a14-4f5c-95ad-72905f833303"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wreath", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<a\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<id\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->706899700,ExpressionUUID->"11440b92-8f33-4d2f-afb8-fb8a00240c49"],

Cell[BoxData[
 RowBox[{"conversion", "=", 
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   RowBox[{"wreath", ",", "\"\<a\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->986977096,ExpressionUUID->"82cc17ae-e5a9-4a1a-af5c-ebb9f608515e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rule\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "0"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ",", 
   RowBox[{"\<\"InitialState\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"StateIndex\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"a\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"id\"\>", "\[Rule]", "2"}]}], "\[RightAssociation]"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->831262355,ExpressionUUID->"3a2bb7f7-3f3f-45eb-b4f7-d6efdad14812"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->924280723,ExpressionUUID->"51dcd3ee-f608-473a-809c-153bbe1edc1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->926384552,ExpressionUUID->"6fe785f7-61d7-4c2e-be0f-360ca6a9ac3e"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"8c3ca313-00fb-4517-ae55-5b917537f742"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->281213502,ExpressionUUID->"ef1aae2b-01fd-4833-9d7d-95067d20a982"],

Cell["\<\
The Mealy and wreath presentations of the adding machine compile to the same \
rule:\
\>", "ExampleText",
 CellID->365391789,ExpressionUUID->"98356547-5b98-470a-9fcf-85b1df195e28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<id\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\"\<a\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], "]"}], "===", 
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
     RowBox[{
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<lam\>\"", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"0", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
           RowBox[{"1", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
      ",", "\"\<eps\>\""}], "]"}], "[", "\"\<Rule\>\"", "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->880417888,ExpressionUUID->"d237c827-c3ab-4dff-953c-6582d96b7840"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]=",
 CellID->112693838,ExpressionUUID->"68eeae78-7ae1-46f5-8243-6aab75f7ea3a"]
}, Open  ]],

