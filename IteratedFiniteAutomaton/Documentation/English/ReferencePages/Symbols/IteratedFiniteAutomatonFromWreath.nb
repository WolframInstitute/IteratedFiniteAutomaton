Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonFromWreath", "ObjectName",
 CellID->535600231,ExpressionUUID->"642c9958-6c9b-4af8-858e-240a6e3f18e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"613be439-ebe4-4ae1-bf56-590ebbfedc1e"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
   StyleBox["spec", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "6544c953-c80b-4b0a-9a4f-be94c6313907"],
 " \[LineSeparator]",
 "converts a wreath recursion on symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "ed2bc068-0e7d-4120-b59e-d49a0765cf0d"],
 " into an association with keys \"Rule\", \"InitialState\" and \
\"StateIndex\"."
}], "Usage",
 CellID->655368771,ExpressionUUID->"9c76ce32-65da-4c31-ad88-c35d0929d991"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "be4a7cbc-ef29-46e9-9b4e-64cb07d58100"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "dd48af9e-2148-4d00-ab96-ddf2386f3c50"],
 " in the specification ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "b0edc367-d779-4f32-b5a8-2c9bf1235464"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "79b3822b-8115-48a1-80fb-bb680c4e0b29"],
 "."
}], "Notes",
 CellID->600746799,ExpressionUUID->"c810e360-627f-4a59-b45b-69c97dbc554a"],

Cell[TextData[{
 "The wreath recursion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox[
      StyleBox["o", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["o", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]], ";", 
     SubscriptBox[
      StyleBox["g", "TI"], "0"], ",", "\[Ellipsis]", ",", 
     SubscriptBox[
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["k", "TI"], "-", "1"}]]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"9f7cfcb7-f413-45ac-8018-168fc4e0c96f"],
 " is the standard presentation of automaton (self-similar) groups."
}], "Notes",
 CellID->946726793,ExpressionUUID->"ddc7f21f-abd7-4698-ab78-52bb07465fb4"],

Cell[TextData[{
 "The result has the same form as that of ",
