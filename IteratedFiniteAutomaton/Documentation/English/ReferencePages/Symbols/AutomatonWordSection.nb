Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordSection", "ObjectName",
 CellID->799115229,ExpressionUUID->"aff19358-34b1-4774-9c6e-e96e4d330e77"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c2c045c9-2ebc-4711-b48d-d85ee81e692a"],
 Cell[BoxData[
  RowBox[{"AutomatonWordSection", "[", 
   StyleBox["sections", "TI"], ",", 
   StyleBox["word", "TI"], ",", 
   StyleBox["x", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3a3285ad-17bc-464f-b8d6-505fbdbf307d"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"section", " ", "of", " "}], 
    StyleBox["word", "TI"], 
    RowBox[{" ", "at", " "}], 
    StyleBox["x", "TI"], ",", 
    RowBox[{" ", 
     RowBox[{"image", " ", "of", " "}]}], 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "064add15-75c1-4d1c-9a26-3111c4e7ae52"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sections", "TI"], "=", 
   RowBox[{"AutomatonSectionTable", "[", 
    StyleBox["automaton", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "34409f8f-8a1c-4ac5-b097-0bc1c30dba35"],
 "."
}], "Usage",
 CellID->646032343,ExpressionUUID->"4308f73c-65e8-427d-ad96-2aa16a4b7e14"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "3985da50-321f-40f4-a100-7e1bbf092bae"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "82dcf589-3e42-4ecc-aa65-75ecd4a0eb03"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "aac9a3dd-1ae2-48a6-bae5-5208fc1d709e"],
 "."
}], "Notes",
 CellID->230032019,ExpressionUUID->"f3ff4be0-eb03-452e-ab5c-3a1b3ad5ae19"],

Cell["\<\
The section of a word is again a word, of the same length, in the generators \
and their inverses.\
\>", "Notes",
 CellID->838238059,ExpressionUUID->"77a33a45-96ad-4bff-9fbf-9a793bc885b9"],

Cell["\<\
The letters are consumed from the right, each one acting on the letter the \
ones to its right produced.\
\>", "Notes",
 CellID->340592808,ExpressionUUID->"9a242244-5c86-446c-9bde-25afd2992269"],

Cell[TextData[{
 "For a section at a vertex deeper than level 1, iterate, or use ",
 Cell[BoxData[
  ButtonBox["AutomatonSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonSection"]], 
  "InlineFormula",ExpressionUUID->"60c4ddb3-3412-445a-92e1-131511a65124"],
 "."
}], "Notes",
 CellID->174505518,ExpressionUUID->"e6b593ac-aeca-46d6-be62-da146e6b1004"]
}, Open  ]],

