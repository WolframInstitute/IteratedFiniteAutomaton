Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordSection", "ObjectName",
 CellID->183733413,ExpressionUUID->"9e2857a8-ffe2-40ef-9a4f-7568681ccc07"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"910f3850-c18e-4d5d-977d-4256ff1872f1"],
 Cell[BoxData[
  RowBox[{"AutomatonWordSection", "[", 
   StyleBox["sections", "TI"], ",", 
   StyleBox["word", "TI"], ",", 
   StyleBox["x", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d94cd488-2b64-4db9-a1fa-c5b427a30da1"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"section", " ", "of", " "}], 
    StyleBox["word", "TI"], 
    RowBox[{" ", "at", " "}], 
    StyleBox["x", "TI"], ",", 
    RowBox[{" ", 
     RowBox[{"image", " ", "of", " "}]}], 
    StyleBox["x", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "f4c14fa0-7a53-4f34-a8d3-7c9bd6108927"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sections", "TI"], "=", 
   RowBox[{"AutomatonSectionTable", "[", 
    StyleBox["automaton", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "8a152bed-346b-4648-bae8-a67dcb65aeb5"],
 "."
}], "Usage",
 CellID->151055951,ExpressionUUID->"311ad847-a844-4a69-9580-2d56bdce9e35"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "065b32a7-5c38-4e1e-8297-4411142c7cae"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "efee625b-240d-461d-b8aa-9f42771baf6d"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "a9fe1908-7cbd-4d9f-b3cd-a6c551feaf76"],
 "."
}], "Notes",
 CellID->373980503,ExpressionUUID->"b8358b2f-1a86-4c7c-8b23-9cc98064c671"],

Cell["\<\
The section of a word is again a word, of the same length, in the generators \
and their inverses.\
\>", "Notes",
 CellID->243745545,ExpressionUUID->"db24ec2a-4138-4641-825f-0012026b4074"],

Cell["\<\
The letters are consumed from the right, each one acting on the letter the \
ones to its right produced.\
\>", "Notes",
 CellID->192225203,ExpressionUUID->"71089db0-c702-485c-94ee-743a5626f7f7"],

Cell[TextData[{
 "For a section at a vertex deeper than level 1, iterate, or use ",
 Cell[BoxData[
  ButtonBox["AutomatonSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonSection"]], 
  "InlineFormula",ExpressionUUID->"8ee12d73-9043-4478-9a90-f843d374f8ce"],
 "."
}], "Notes",
 CellID->546400073,ExpressionUUID->"7dffd5bb-75ed-48d8-b10f-c0c63b01e134"]
}, Open  ]],

