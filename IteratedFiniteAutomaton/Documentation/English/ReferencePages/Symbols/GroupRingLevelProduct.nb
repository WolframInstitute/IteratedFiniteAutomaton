Cell[TextData[{
 "The keys are permutations, not words, so two words that agree in the level \
quotient have their coefficients merged. In the Grigorchuk group ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "36a4b9d6-ec59-4242-a762-490519549cbf"],
 " and ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",ExpressionUUID->
  "9f629c53-3687-4359-aa12-7d1ff166c52f"],
 " are distinct but act alike at level 2:"
}], "ExampleText",
 CellID->124149738,ExpressionUUID->"fcb7a789-51ab-4080-8737-8c970297ba4a"],

Cell[BoxData[
 RowBox[{"GroupRingLevelProduct", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8950703898", ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"{", "}"}]}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
