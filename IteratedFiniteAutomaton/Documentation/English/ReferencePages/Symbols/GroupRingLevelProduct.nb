Cell[CellGroupData[{
Cell["GroupRingLevelProduct", "ObjectName",
 CellID->163729913,ExpressionUUID->"b5b9c473-fde5-424d-a704-70f93abdcfea"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a1ffec17-4d46-4dde-bf59-b13d0c31b7a2"],
 Cell[BoxData[
  RowBox[{"GroupRingLevelProduct", "[", 
   StyleBox["perms", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8596efc6-6769-4d8b-aaa4-4dd876f9cc5c"],
 " \[LineSeparator]",
 "gives the product of the group-ring elements ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "06134921-1304-46f8-9a1b-b9421433adfb"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "cd3bc116-8cb2-4dbe-91d4-bf8f8eaa04b3"],
 " in the level quotient, as an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "3020a77d-3407-4421-b821-b146db5d73f4"],
 " from level permutation to coefficient.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d39e60a4-4dfc-4e4b-b6c6-c5c36b71c2af"],
 Cell[BoxData[
  RowBox[{"GroupRingLevelProduct", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cbf6734e-86cc-438c-a7ea-0c65cfc2e9c0"],
 " \[LineSeparator]",
 "builds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["perms", "TI"], "=", 
   RowBox[{"AutomatonLevelPermutations", "[", 
    RowBox[{
     StyleBox["automaton", "TI"], ",", 
     StyleBox["level", "TI"]}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "6af6ccde-3b9b-4c92-8c3e-6c779e1d502d"],
 " first."
}], "Usage",
 CellID->342393052,ExpressionUUID->"a879a7b7-c127-423a-b2f3-e07639d3128f"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "3ad3e092-cc1b-4899-a579-79bfbeed8e74"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "d51cf4d6-a3c3-48bf-9b47-71c40b9f43a0"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "7b8b7b8b-6f38-4203-b86e-82dc4c11cd3d"],
 " is 1."
}], "Notes",
 CellID->513819616,ExpressionUUID->"2cc294c9-01cb-43d5-913d-59237549edf8"],

Cell["\<\
Words multiply by concatenation, and two words are the same group element \
exactly when they induce the same level permutation \[LongDash] which is why \
the keys of the result are permutations rather than words.\
\>", "Notes",
 CellID->187667324,ExpressionUUID->"3d475db6-48ed-42ef-ba4e-8b1afdd497e9"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"04b01b38-046e-45bd-b0cd-95b063e12de8"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], " ", 
   StyleBox["b", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "817cd03a-4c61-457e-b33e-ab7411d587c1"],
 " in the level quotient, which is the test every zero-divisor search is \
built on."
}], "Notes",
 CellID->654982777,ExpressionUUID->"f62f0577-0132-46fc-85fe-5f9ad910bc1c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "04221553-5e61-4e26-a9d8-01a700446091"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "e1af71e7-b28f-469c-a668-30257296e402"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "6da01f89-c84f-4554-ae20-9d6cfc432ff2"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"ae2b145a-93ce-461d-a0dd-3e6ba95d8c3a"],
 " over the integers."
}], "Notes",
 CellID->204202631,ExpressionUUID->"7ae8e3c3-947a-4211-af88-5a0406b2b043"]
}, Open  ]],

