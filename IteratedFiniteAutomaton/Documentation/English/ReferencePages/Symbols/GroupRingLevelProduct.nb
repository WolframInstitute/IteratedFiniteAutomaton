    RowBox[{"1", "+", 
     StyleBox["a", "TI"]}], ")"}], "=", 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"]}], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "ac40bb15-997a-4517-b06d-603595faf607"],
 ":"
}], "ExampleText",
