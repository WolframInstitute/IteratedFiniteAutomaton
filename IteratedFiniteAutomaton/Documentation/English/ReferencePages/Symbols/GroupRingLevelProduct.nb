Cell[TextData[{
 "The keys are permutations, not words, so two words that agree in the level \
quotient have their coefficients merged. In the Grigorchuk group ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "c590b802-737d-43ee-90dd-f14911e65e2f"],
 " and ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",ExpressionUUID->
  "00484610-afb6-4623-9370-d575d59429ba"],
 " are distinct but act alike at level 2:"
}], "ExampleText",
 CellID->640812995,ExpressionUUID->"17f2c8aa-cef7-4c88-bd6e-9eb1b0204c40"],

Cell[BoxData[
 RowBox[{"GroupRingLevelProduct", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8950703898", ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "2", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"{", "}"}]}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]}], "}"}]}], "]"}]], "Input",
