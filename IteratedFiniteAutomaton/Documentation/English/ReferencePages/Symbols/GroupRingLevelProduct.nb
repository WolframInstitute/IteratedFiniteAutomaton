Notebook[{

Cell[CellGroupData[{
Cell["GroupRingLevelProduct", "ObjectName",
 CellID->844455630,ExpressionUUID->"b1eba370-a25d-4b65-899e-880f0eaba5b6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7b3604b1-1108-4e0d-b377-e2ca884fce99"],
 Cell[BoxData[
  RowBox[{"GroupRingLevelProduct", "[", 
   StyleBox["perms", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d208f624-5f88-47c6-8327-e7311315b5c3"],
 " \[LineSeparator]",
 "gives the product of the group-ring elements ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "c44574df-003f-421d-a3e2-9f62adbe4567"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "68745365-ee43-4c81-89a4-1383ef62c157"],
 " in the level quotient, as an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "9d0522fd-8a06-487c-8a93-bb8f6a9f1b90"],
 " from level permutation to coefficient.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"af9716b2-2d5e-4bf7-9ec9-a2758efc7758"],
 Cell[BoxData[
  RowBox[{"GroupRingLevelProduct", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "beab168f-ac72-4c7b-8676-9aa64182ef89"],
 " \[LineSeparator]",
 "builds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["perms", "TI"], "=", 
   RowBox[{"AutomatonLevelPermutations", "[", 
    RowBox[{
     StyleBox["automaton", "TI"], ",", 
     StyleBox["level", "TI"]}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "71f7faa8-5cc3-41bd-8d64-170662140507"],
 " first."
}], "Usage",
 CellID->471535386,ExpressionUUID->"47d4f60d-3636-46eb-8825-e62863338e25"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "f3c4b7c3-d212-4b8d-b986-ad9a9ff1c598"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "27898cb2-173c-42a7-bd04-263a606442f6"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "5a0cc313-b06b-4c5e-86dd-fca00fa4fddb"],
 " is 1."
}], "Notes",
 CellID->796407809,ExpressionUUID->"519ee16a-b938-469b-9729-63396ffe19de"],

Cell["\<\
Words multiply by concatenation, and two words are the same group element \
exactly when they induce the same level permutation \[LongDash] which is why \
the keys of the result are permutations rather than words.\
\>", "Notes",
 CellID->899437156,ExpressionUUID->"d2b9c815-cc10-4da6-9f52-356d954c6ebe"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"9926c60c-dc0f-4be1-b4e4-6024dcfb3625"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], " ", 
   StyleBox["b", "TI"], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "ac287dd7-c69e-4d0c-b15f-3d7e030aa132"],
 " in the level quotient, which is the test every zero-divisor search is \
built on."
}], "Notes",
 CellID->235285590,ExpressionUUID->"3a7f6e29-1539-4b61-a303-9e41aea624dd"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "2b870506-59b5-4ec5-8dd4-148b5ada5aa6"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "6a78fe2e-c77b-429b-a193-663d11a20b1a"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "784887c6-d273-4c62-a975-ae8e039e554a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"23d42db5-d8d3-4c81-9614-6e7a2d3b154a"],
 " over the integers."
}], "Notes",
 CellID->839499151,ExpressionUUID->"0e268657-8079-417d-a41e-5a416efc3cee"]
}, Open  ]],

