Notebook[{

Cell[CellGroupData[{
Cell["AutomatonLevelPermutations", "ObjectName",
 CellID->520121351,ExpressionUUID->"26926a3f-7c59-454d-84f4-a7047c5873bd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1dba1a61-1305-4c5d-af34-8f04baf83843"],
 Cell[BoxData[
  RowBox[{"AutomatonLevelPermutations", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ca768626-ff56-4d82-b908-626d10edf57e"],
 " \[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "06c523c5-ba1e-4a11-a342-b0b5571bbc2c"],
 " sending each state to its action on the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "216a21e8-b5c4-4f89-8460-35529e0e8c91"],
 " vertices at depth ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "133c4b53-eea0-4bcc-ad5a-bb322204f2cb"],
 ", as a permutation list."
}], "Usage",
 CellID->435771175,ExpressionUUID->"d95c99a1-e0c7-45a3-83de-71d6b435d36d"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "dd91bab1-505f-4823-baa6-ca33adda966a"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "fed3785d-f891-4865-8b90-256413481652"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "58bb9f5f-1c25-4332-b025-fae8520c0293"],
 "."
}], "Notes",
 CellID->287106139,ExpressionUUID->"defb506a-6ccc-4246-bf8a-0ba79da2c64d"],

Cell["\<\
At level 1 the permutation is the state's action on the symbols \[LongDash] \
the output row of its wreath recursion.\
\>", "Notes",
 CellID->630768912,ExpressionUUID->"fa15a8e8-1bfa-4cab-bdf2-a2e3ed5b2a53"],

Cell[TextData[{
 "The permutations generate the image of the automaton group in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "fa5966bb-96e9-420f-8498-95129239f28f"],
 ", the level quotient every group computation in this paclet works in."
}], "Notes",
 CellID->786846960,ExpressionUUID->"54867489-1586-4ad0-bb1c-8f7bcd117d73"],

Cell[TextData[{
 "The result is the ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "436225af-8044-4070-a702-abca1e73c385"],
 " argument of ",
 Cell[BoxData[
  ButtonBox["AutomatonWordPermutation",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonWordPermutation"]], "InlineFormula",ExpressionUUID->
  "4075a683-67dc-4aa4-9b56-1e494bf12b44"],
 " and ",
 Cell[BoxData[
  ButtonBox["GroupRingLevelProduct",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingLevelProduct"]], "InlineFormula",ExpressionUUID->
  "a869f007-a00b-4d64-808b-7c2c55ed0100"],
 "."
}], "Notes",
 CellID->563464026,ExpressionUUID->"62bbd991-4768-4843-94c6-643147f4f0c9"]
}, Open  ]],

