Cell[CellGroupData[{
Cell["AutomatonLevelPermutations", "ObjectName",
 CellID->720337678,ExpressionUUID->"ac85e0a1-4a18-4116-b7ea-2cc5ed1bfc71"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4f203eec-d265-46ff-a376-4682b371067e"],
 Cell[BoxData[
  RowBox[{"AutomatonLevelPermutations", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f02b49ca-d3c1-48c4-bdf5-b3ce3a1fd2fb"],
 " \[LineSeparator]",
 "gives an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "281656ef-e0a7-49df-b6bb-6c3aa169109f"],
 " sending each state to its action on the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "0ba58f4f-dc9b-4e1c-ad15-8cbe75feb67c"],
 " vertices at depth ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "fa75cc67-773f-4027-b95f-d6f9d356b677"],
 ", as a permutation list."
}], "Usage",
 CellID->240409338,ExpressionUUID->"dd5f7132-043a-4932-aaee-888177feedcd"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "21738799-224d-4f16-b7dc-c0a6a4950dc2"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "51c597c3-c11b-4f4a-9365-c7138581bb48"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "ca42b710-6028-4887-bf1d-ddc31a57daa1"],
 "."
}], "Notes",
 CellID->240196396,ExpressionUUID->"1df4ffbb-09ec-4395-87eb-6470f437b4aa"],

Cell["\<\
At level 1 the permutation is the state's action on the symbols \[LongDash] \
the output row of its wreath recursion.\
\>", "Notes",
 CellID->558133694,ExpressionUUID->"52adf660-b41a-4642-a4d5-f184a3abe79b"],

Cell[TextData[{
 "The permutations generate the image of the automaton group in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "65acd574-71d3-476c-a517-a2c5a6d2961f"],
 ", the level quotient every group computation in this paclet works in."
}], "Notes",
 CellID->885801791,ExpressionUUID->"2eda4267-a827-4107-9654-d2598e180236"],

Cell[TextData[{
 "The result is the ",
 Cell[BoxData[
  StyleBox["perms", "TI"]], "InlineFormula",ExpressionUUID->
  "9970ff31-8bd4-40d0-80a7-b56306396514"],
 " argument of ",
 Cell[BoxData[
  ButtonBox["AutomatonWordPermutation",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonWordPermutation"]], "InlineFormula",ExpressionUUID->
  "32084a17-681e-4245-a0ad-5321475d6f32"],
 " and ",
 Cell[BoxData[
  ButtonBox["GroupRingLevelProduct",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingLevelProduct"]], "InlineFormula",ExpressionUUID->
  "afa2c15d-7a62-4ab5-acc3-af467ecca7a8"],
 "."
}], "Notes",
 CellID->742771854,ExpressionUUID->"f5c17ec7-a098-4b88-b28b-44204c3e34dc"]
}, Open  ]],

