Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordBall", "ObjectName",
 CellID->717379090,ExpressionUUID->"2c5a44b1-ddbe-4cd7-b820-2b22b6348b44"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a86180c-252a-4b9f-8f32-74deec405c57"],
 Cell[BoxData[
  RowBox[{"AutomatonWordBall", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9aa09509-f5cd-49f9-9d27-e387a8e61f00"],
 " \[LineSeparator]",
 "gives the reduced words of length 1 to ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "082590d0-2bbb-4f36-a323-80ed20cd06f3"],
 " in the free group on the automaton's states."
}], "Usage",
 CellID->943841919,ExpressionUUID->"9aa106f9-d65e-4401-ae2e-410061e76242"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "5b3aba5d-a2f5-47dd-94bf-b8cb13f8c0bb"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "349fb752-d013-4697-ace7-85f7a5bf135d"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "0b30e714-322f-4ac9-8bb6-a147d8a65e20"],
 "."
}], "Notes",
 CellID->145018850,ExpressionUUID->"bcd2ae2f-ed55-4fc6-a578-fa3f65b12016"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "a6809a42-6579-4cb9-80e5-955d1237ef7f"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a8d579f4-7520-4232-965d-57794aa7066a"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "de0e480b-687c-4b08-a745-fe16b3fa253d"],
 "."
}], "Notes",
 CellID->865079725,ExpressionUUID->"8017811d-36e3-4269-97b6-581fc53fbfa8"],

Cell["\<\
Reduced means no letter is followed by its inverse; the empty word is not \
included.\
\>", "Notes",
 CellID->596940499,ExpressionUUID->"8bc3ab7f-597e-4394-822d-ae861548722e"],

Cell[TextData[{
 "The ball depends on the automaton only through its state count: there are \
",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["s", "TI"], "-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]]}]], "InlineFormula",ExpressionUUID->
  "60291c87-db7c-404f-aa31-20047e6a4b4e"],
 " words of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "e81cdbed-7673-451d-91ae-928beb57e221"],
 "."
}], "Notes",
 CellID->481877217,ExpressionUUID->"244226f3-5c8b-40c4-a405-4f25b74e7af3"],

Cell[TextData[{
 "For distinct group elements rather than distinct words, use ",
 Cell[BoxData[
  ButtonBox["AutomatonGroupBall",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonGroupBall"]]\
, "InlineFormula",ExpressionUUID->"8f8dd860-bfec-4a6d-99ac-c05831273681"],
 "."
}], "Notes",
 CellID->306369638,ExpressionUUID->"d3ff669e-7db6-4549-bff9-d65c6161a2ad"]
}, Open  ]],

