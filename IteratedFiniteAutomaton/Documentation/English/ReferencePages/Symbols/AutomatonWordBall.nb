Notebook[{

Cell[CellGroupData[{
Cell["AutomatonWordBall", "ObjectName",
 CellID->230136832,ExpressionUUID->"0c557776-b60a-4586-860a-c967a47ec872"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"41f2f2f0-18e5-4475-89ff-ee868f1c4945"],
 Cell[BoxData[
  RowBox[{"AutomatonWordBall", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e58b4df3-d38f-4fd7-8991-5e608e625991"],
 " \[LineSeparator]",
 "gives the reduced words of length 1 to ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "1a4c4ca6-eb7f-4ca3-a4b4-962fdbfce688"],
 " in the free group on the automaton's states."
}], "Usage",
 CellID->507977568,ExpressionUUID->"637f7727-fa51-4929-8b04-58e53286c174"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "aad812ee-2232-4f47-9a24-64b0ab5ef8f7"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "c4a9be49-03f7-4dc2-b754-0ced37d390f8"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "b2f5a5ec-c165-49c4-b5d7-8b36e0462f61"],
 "."
}], "Notes",
 CellID->915712567,ExpressionUUID->"c3ebc30b-c561-4c6c-9a5e-a0a6c7f537ae"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "107f25f9-355e-4d50-9f1d-ed371f048636"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "85c9bc63-b306-457e-b285-ba2be7b95b59"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "1310901b-29fe-40cf-b254-330a496cc297"],
 "."
}], "Notes",
 CellID->705829126,ExpressionUUID->"9f9fd0e1-6f43-4502-b439-c54e1a21c5fc"],

Cell["\<\
Reduced means no letter is followed by its inverse; the empty word is not \
included.\
\>", "Notes",
 CellID->244525364,ExpressionUUID->"8f1cdae4-1caf-4aca-a2df-731f8e877ec2"],

Cell[TextData[{
 "The ball depends on the automaton only through its state count: there are \
",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", 
      StyleBox["s", "TI"], "-", "1"}], ")"}], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]]}]], "InlineFormula",ExpressionUUID->
  "2dc03797-15ae-4402-b16c-b6c32770f11e"],
 " words of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "d58ce650-e158-405b-8dbb-4465d9d2d38b"],
 "."
}], "Notes",
 CellID->473679508,ExpressionUUID->"5ac8d070-436a-4164-a179-d31bde86971a"],

Cell[TextData[{
 "For distinct group elements rather than distinct words, use ",
 Cell[BoxData[
  ButtonBox["AutomatonGroupBall",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonGroupBall"]]\
, "InlineFormula",ExpressionUUID->"079c2ada-648e-4bed-9aed-39fdfc6121ed"],
 "."
}], "Notes",
 CellID->414262090,ExpressionUUID->"fb3fae90-7a25-43ad-be26-18a0dca2889a"]
}, Open  ]],

