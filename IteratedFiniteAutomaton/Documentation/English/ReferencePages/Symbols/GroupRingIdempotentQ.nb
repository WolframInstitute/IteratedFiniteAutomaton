Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentQ", "ObjectName",
 CellID->639274159,ExpressionUUID->"0155bdab-a676-4e9b-b364-a34dc2dc537e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d5bd4f50-7ae8-44ef-a561-f7f8e2cbcd95"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e5ff9e3d-cdfb-42d4-98ef-d62265301345"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "9d24dbfd-1fb6-48f9-af4f-c57d9a766eec"],
 " if ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], "-", "1"}], ")"}], "=", "0"}]], "InlineFormula",
  ExpressionUUID->"bb285fdb-9482-458a-8a0e-bf5ba24fe9e5"],
 " in the group ring of the level quotient."
}], "Usage",
 CellID->350502211,ExpressionUUID->"d9de3b71-cbf9-40e1-93ac-080d40dcb5bf"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "3e15925f-b7d9-4a0a-94f5-ba53334c87ff"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "62d307c4-9521-4167-abd5-0adc0fc4437d"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "3ba13bfa-675f-4a74-83d6-3c88f7e97ab7"],
 " is 1."
}], "Notes",
 CellID->728629029,ExpressionUUID->"d0843a3e-37e0-46eb-83da-e16f41743fde"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "d94b315f-0f40-43a0-8e21-a7e62567c8e3"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "6785dba0-b7b1-4cfb-aeca-71e73a957959"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "575a897c-5ec0-4809-977c-47b1f4511222"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"5f36fc16-9211-465f-8436-c975e6580ebb"],
 " over the integers."
}], "Notes",
 CellID->431927254,ExpressionUUID->"3d1e394a-8256-47a4-9cf2-7703f2d71996"],

Cell[TextData[{
 "0 and 1 are idempotent in every group ring; any other idempotent is a zero \
divisor, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], "-", "1"}], ")"}], "=", "0"}]], "InlineFormula",
  ExpressionUUID->"c41916d6-aa69-4641-8100-daa576a21110"],
 " with both factors nonzero."
}], "Notes",
 CellID->477111670,ExpressionUUID->"df168d0e-c86e-4bee-b2df-67d63cccc023"],

Cell["\<\
The Kaplansky idempotent conjecture asserts that a torsion-free group has no \
others, so a survivor here is a candidate counterexample.\
\>", "Notes",
 CellID->149526878,ExpressionUUID->"391f03ce-de4e-487d-b8a7-723317ccfdb5"]
}, Open  ]],

