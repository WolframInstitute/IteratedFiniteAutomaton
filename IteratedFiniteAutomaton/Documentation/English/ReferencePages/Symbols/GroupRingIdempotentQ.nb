Cell[TextData[{
 "Over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", "3"]], "InlineFormula",
  ExpressionUUID->"9777e46e-1921-4f7f-bfc7-d65dd0b8ade7"],
 " the element ",
 Cell[BoxData[
  RowBox[{"2", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     StyleBox["a", "TI"]}], ")"}]}]], "InlineFormula",ExpressionUUID->
  "d2106aa7-e292-4fc8-ae82-92753ef4372c"],
 " is idempotent in the Grigorchuk group, because 2 inverts 2 and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], "=", "1"}]], "InlineFormula",ExpressionUUID->
  "a3ebaffb-04c8-429d-aeae-e35a322030c5"],
 ":"
}], "ExampleText",
 CellID->193245632,ExpressionUUID->"58a08668-0fa7-40ac-b6cc-987e0a2373a7"],

