Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentQ", "ObjectName",
 CellID->625292816,ExpressionUUID->"ded521b5-4888-4b67-bc05-111d9997a470"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd57366e-be32-46c8-bea6-51347536517e"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dd11621e-b9bb-45f2-8f29-0c5698301ce1"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "834c57f5-e642-4a1c-ba4c-ce331dc53cb2"],
 " if ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], "-", "1"}], ")"}], "=", "0"}]], "InlineFormula",
  ExpressionUUID->"b259d5de-8081-4bb6-96cd-88e009b70688"],
 " in the group ring of the level quotient."
}], "Usage",
 CellID->818051352,ExpressionUUID->"956ca82c-bcd8-4512-b58f-937ddb85f3cd"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "3ef1ff19-576c-4494-8ce0-f9c60e282756"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "dad48489-b7b2-4115-a98b-23edf376d919"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "f46a3a4e-442b-4380-925f-44f63dded48e"],
 " is 1."
}], "Notes",
 CellID->768749170,ExpressionUUID->"01444366-d9df-4a45-8306-0a5d34daeecb"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "359a87c5-fdb8-4e7d-8a7a-b31b29683505"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "73a1c1c2-fc98-440b-a6f5-dc74808798a0"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "649a0553-f81f-4d08-bf10-f9b8fc50942a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"36020a07-62ca-4e52-9c25-562de50d4242"],
 " over the integers."
}], "Notes",
 CellID->141977428,ExpressionUUID->"015b9049-6c99-4ba8-9916-b7f0a0a795ea"],

Cell[TextData[{
 "0 and 1 are idempotent in every group ring; any other idempotent is a zero \
divisor, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], "-", "1"}], ")"}], "=", "0"}]], "InlineFormula",
  ExpressionUUID->"790b075c-a0b5-4463-b1ec-7aaa30be0d88"],
 " with both factors nonzero."
}], "Notes",
 CellID->523122176,ExpressionUUID->"4f8291e2-362f-4765-b8d7-0d83a8f3bfe6"],

Cell["\<\
The Kaplansky idempotent conjecture asserts that a torsion-free group has no \
others, so a survivor here is a candidate counterexample.\
\>", "Notes",
 CellID->601670168,ExpressionUUID->"a4ef2e9b-4eb5-49dc-bc33-3b64e66b74c9"]
}, Open  ]],

