Cell[TextData[{
 "Over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", "3"]], "InlineFormula",
  ExpressionUUID->"fc07e782-fc11-42f1-8442-b7cf4950893b"],
 " the element ",
 Cell[BoxData[
  RowBox[{"2", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     StyleBox["a", "TI"]}], ")"}]}]], "InlineFormula",ExpressionUUID->
  "20235a6f-25d9-483e-9027-1cb76eab2489"],
 " is idempotent in the Grigorchuk group, because 2 inverts 2 and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], "=", "1"}]], "InlineFormula",ExpressionUUID->
  "ba0f506e-b9a2-438f-a71a-4cddea2e7024"],
 ":"
}], "ExampleText",
 CellID->350999672,ExpressionUUID->"67a5b4aa-24a5-4d0b-8ae2-481027b4f080"],

