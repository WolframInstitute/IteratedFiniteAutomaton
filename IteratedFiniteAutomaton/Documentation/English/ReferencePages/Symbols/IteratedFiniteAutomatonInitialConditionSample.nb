Cell["IteratedFiniteAutomatonInitialConditionSample", "ObjectName",
 CellID->675894493,ExpressionUUID->"ff71c46a-43ab-462b-bb2c-1acb72f2bba1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aaaa9909-6929-4dde-bdca-a80ff04a9042"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonInitialConditionSample", "[", 
   StyleBox["k", "TI"], ",", 
   StyleBox["length", "TI"], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4c7607e7-e983-4ae4-997f-2ff3cb53f7b5"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "32f8eb28-e22d-4d2c-a002-c71cf965b66a"],
 " tapes of the given ",
 Cell[BoxData[
  StyleBox["length", "TI"]], "InlineFormula",ExpressionUUID->
  "8590863f-08ca-4fad-ba2a-c344bf5d25bb"],
 ", spread evenly over the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["length", "TI"]]], "InlineFormula",ExpressionUUID->
  "46efdea5-e2ba-4f07-a377-5249ac80933c"],
 " tapes on ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "eab63a16-4217-4806-a95b-b20b48cc03da"],
 " symbols."
}], "Usage",
 CellID->613943307,ExpressionUUID->"e28cabed-acc0-4f28-8676-e02c739bea04"],

Cell[TextData[{
 "Tape number ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "ef626f73-31c5-411e-b254-430fd266c93e"],
 " is the base-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "fc0895b5-de0e-4bfc-a2d8-cab9094e699a"],
 " digit list of the ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "2d45ae68-2ef4-4a81-9a0d-4556aa63951f"],
 "th entry of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Round",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Round"], "[", 
   RowBox[{
    ButtonBox["Subdivide",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Subdivide"], "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["length", "TI"]], "-", "1"}], ",", 
     StyleBox["n", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f9cd9e73-fff3-4a43-8bfa-7d38e7e9ddd2"],
 ", left-padded to ",
 Cell[BoxData[
  StyleBox["length", "TI"]], "InlineFormula",ExpressionUUID->
  "0803ef28-a0f4-496c-8e42-f451c9557f8b"],
 "."
}], "Notes",
 CellID->574410423,ExpressionUUID->"0d7f716e-73c8-4c94-bf5d-19562dcc19fb"],

Cell[TextData[{
 "The first tape is all 0s and the last is all ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "85087258-9a9f-4d8d-9fc5-549cc4318999"],
 "s."
}], "Notes",
 CellID->165827617,ExpressionUUID->"dd051143-0f05-4c14-817d-9122684bab45"],

Cell[TextData[{
 "Reading a tape back as a base-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "e0e59ac8-8195-4636-9e3e-96a884217db2"],
 " integer recovers the even subdivision it came from."
}], "Notes",
 CellID->238394595,ExpressionUUID->"0231d325-2d76-43d5-91d9-f17c129cc92c"]
}, Open  ]],

