Cell["IteratedFiniteAutomatonInitialConditionSample", "ObjectName",
 CellID->431105702,ExpressionUUID->"8766deba-1f40-4028-9791-cc4e2bfbee16"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10799a47-9f39-4bd0-9720-05e31bc75346"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonInitialConditionSample", "[", 
   StyleBox["k", "TI"], ",", 
   StyleBox["length", "TI"], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2a593ba7-9c57-41a0-b0a7-42b5b19285d0"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "ce82d1b7-f3d0-4cb0-a201-3ff4fd09cbd4"],
 " tapes of the given ",
 Cell[BoxData[
  StyleBox["length", "TI"]], "InlineFormula",ExpressionUUID->
  "dc406274-3ad0-4ceb-9021-5a8e0969bd07"],
 ", spread evenly over the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["length", "TI"]]], "InlineFormula",ExpressionUUID->
  "be92ff23-f0af-4186-9b35-60764480f7b9"],
 " tapes on ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "f3efe32f-de46-4908-af26-f0600bf00ce0"],
 " symbols."
}], "Usage",
 CellID->277540853,ExpressionUUID->"cf74093a-e060-471c-8b75-705c2fbad43d"],

Cell[TextData[{
 "Tape number ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "cc9139f1-1a8e-4b01-8d9c-026d5ed03d87"],
 " is the base-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "126707b5-778c-4479-af4f-96434d0b2291"],
 " digit list of the ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "213271a7-a08e-4e30-b5c8-550f43873878"],
 "th entry of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Round",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Round"], "[", 
   RowBox[{
    ButtonBox["Subdivide",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Subdivide"], "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["length", "TI"]], "-", "1"}], ",", 
     StyleBox["n", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "642c53ef-5d4e-43d3-8024-997a8b1bc3f7"],
 ", left-padded to ",
 Cell[BoxData[
  StyleBox["length", "TI"]], "InlineFormula",ExpressionUUID->
  "c51b8ce0-8143-42af-986f-66b902ff3fb9"],
 "."
}], "Notes",
 CellID->547265837,ExpressionUUID->"fe096a76-a2b7-4a25-8d45-9964cd47fba3"],

Cell[TextData[{
 "The first tape is all 0s and the last is all ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "44c2110c-56da-4637-8a34-39784ff05533"],
 "s."
}], "Notes",
 CellID->782102160,ExpressionUUID->"a4d29fee-f501-4a50-b244-62c88584413a"],

Cell[TextData[{
 "Reading a tape back as a base-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "981defdc-4eaa-44d9-a773-5fb50ad178ac"],
 " integer recovers the even subdivision it came from."
}], "Notes",
 CellID->253606547,ExpressionUUID->"60d8f011-6fef-447a-8823-5a3c4efc11e1"]
}, Open  ]],

