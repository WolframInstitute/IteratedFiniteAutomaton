Cell["\<\
The canonical code is a canonical form: it is idempotent, and never exceeds \
the code it came from:\
\>", "ExampleText",
 CellID->639677359,ExpressionUUID->"8b393c9f-529a-4412-9040-66962061c479"],

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"CanonicalAutomatonCode", "[", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "===", 
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"InvertibleAutomatonCodes", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->774390835,ExpressionUUID->"12bdcbfc-d28c-4213-8d1d-7a44f6bacecf"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->204551129,ExpressionUUID->"be8e1509-e226-4935-8366-d3279a2aacb4"],

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"CanonicalAutomatonCode", "[", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "\[LessEqual]",
      "m"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"InvertibleAutomatonCodes", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->379283654,ExpressionUUID->"ab1ec15b-42bb-471a-81f9-6994fdfd3728"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->322645864,ExpressionUUID->"50550e74-baaa-4833-805e-59d00403182a"]
}, Open  ]]
