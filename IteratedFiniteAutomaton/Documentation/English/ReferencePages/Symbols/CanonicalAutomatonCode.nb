Notebook[{

Cell[CellGroupData[{
Cell["CanonicalAutomatonCode", "ObjectName",
 CellID->537864280,ExpressionUUID->"d2902f57-3287-44c0-94ab-2e134f8e6371"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8099f19c-eb9d-4cd7-b7e3-11f1f44b671a"],
 Cell[BoxData[
  RowBox[{"CanonicalAutomatonCode", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "782d5ff5-cb14-41bc-b6a5-0aac2dbba1d7"],
 " \[LineSeparator]",
 "gives the least code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a1d7cb20-ac51-4ad3-80be-cfb61c309dfa"],
 " in the orbit of the automaton under relabelling its states and its symbols."
}], "Usage",
 CellID->957374237,ExpressionUUID->"3bcc720e-5599-4429-ac20-c67933434c4f"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "805c1d73-592b-42f3-8ca8-b5c7bb1d4ec7"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "28e9e0dc-bd9b-473f-b5fe-cfce86ccfc9f"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "2e56dfeb-ff88-47a3-88f6-36cb3251d4c9"],
 "."
}], "Notes",
 CellID->378333440,ExpressionUUID->"167d37c5-7e8e-4507-b346-34886cd5a011"],

Cell["\<\
Two automata that differ only by a relabelling get the same canonical code, \
so it is a complete invariant of the relabelling class.\
\>", "Notes",
 CellID->475826122,ExpressionUUID->"bc7cd400-7500-4751-91c4-f278755b6120"],

Cell[TextData[{
 "The orbit is taken over all ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["s", "TI"], "!"}], " ", 
   RowBox[{
    StyleBox["k", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "68578047-961b-4089-9b06-ccdc14ebbfd5"],
 " relabellings, so the cost grows quickly with the state count."
}], "Notes",
 CellID->992069605,ExpressionUUID->"ec60c80c-bfd9-47e0-8ac0-b06905e4d751"]
}, Open  ]],

