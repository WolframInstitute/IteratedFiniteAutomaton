Cell["\<\
The lamplighter automaton, code 156, is a relabelling of code 54:\
\>", "ExampleText",
 CellID->109950258,ExpressionUUID->"27f49651-b52d-4c86-9f11-1c36a032f882"],

Cell[BoxData[
 RowBox[{"CanonicalAutomatonCode", "[", 
  RowBox[{"{", 
   RowBox[{"156", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->862464254,ExpressionUUID->"0a30655a-b18a-4ab3-8d84-48728c85dc24"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"54", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->657543969,ExpressionUUID->"232a06d1-61d3-416a-b60b-9b7e14ec5657"],

Cell["\<\
Four of the 64 invertible automata on two states and two symbols share that \
canonical code:\
\>", "ExampleText",
 CellID->694793700,ExpressionUUID->"1c807c04-9506-446e-a43f-7154a2f16bd3"],

Cell[BoxData[
 RowBox[{"Pick", "[", 
  RowBox[{
   RowBox[{"InvertibleAutomatonCodes", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"CanonicalAutomatonCode", "[", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "\[Equal]", 
      "54"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"InvertibleAutomatonCodes", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->452746147,ExpressionUUID->"7db421e5-e744-44d6-9d01-3447a17341a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"54", ",", "99", ",", "156", ",", "201"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->556106249,ExpressionUUID->"5ceacfab-57c0-4bc4-b55d-d33139575ac6"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"72fbc1a1-1be1-45bd-97be-b8f05ce15d28"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->959570130,ExpressionUUID->"d2541eb3-ad1e-4ebd-a5e5-fe69da56b966"],

Cell["Those 64 automata fall into 24 relabelling classes:", "ExampleText",
 CellID->563852830,ExpressionUUID->"7f17228d-d1b7-4ffd-911b-844af2d70ab4"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Union", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"InvertibleAutomatonCodes", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->247903609,ExpressionUUID->"41b62111-c5e5-418a-8a27-6080f42044c9"],

Cell[BoxData["24"], "Output",
 CellLabel->"Out[3]=",
 CellID->699878934,ExpressionUUID->"a6ae1c00-8727-4541-90cd-b619b0667dbb"]
}, Open  ]],

