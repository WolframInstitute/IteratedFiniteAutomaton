Cell["\<\
The lamplighter automaton, code 156, is a relabelling of code 54:\
\>", "ExampleText",
 CellID->992333503,ExpressionUUID->"5cee9c0d-e4e2-447e-bc30-da8333ae96db"],

Cell[BoxData[
 RowBox[{"CanonicalAutomatonCode", "[", 
  RowBox[{"{", 
   RowBox[{"156", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->119299827,ExpressionUUID->"028fe67f-4e90-41ef-bac1-672c98b0dca5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"54", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->197037925,ExpressionUUID->"4cd37eeb-8fb6-4247-862b-ea511212568e"],

Cell["\<\
Four of the 64 invertible automata on two states and two symbols share that \
canonical code:\
\>", "ExampleText",
 CellID->700368118,ExpressionUUID->"cf5418ab-e961-40a3-9c5d-fad5ad36be1f"],

Cell[BoxData[
 RowBox[{"Pick", "[", 
  RowBox[{
   RowBox[{"InvertibleAutomatonCodes", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"CanonicalAutomatonCode", "[", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "\[Equal]", 
      "54"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"InvertibleAutomatonCodes", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->507140658,ExpressionUUID->"cea08324-e63d-4f37-a7c1-284e87f278be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"54", ",", "99", ",", "156", ",", "201"}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->247894682,ExpressionUUID->"84bd6f9c-fe24-4367-b3cd-1431478c299b"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"7f3fc1db-f3c7-48bd-be5b-ab8e57920563"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->939311773,ExpressionUUID->"91060c32-a803-4b5b-987d-778368b8a3a2"],

Cell["Those 64 automata fall into 24 relabelling classes:", "ExampleText",
 CellID->646476610,ExpressionUUID->"f5d98b23-13f9-4e6e-a5d6-8ee24e671807"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Union", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"InvertibleAutomatonCodes", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->199535770,ExpressionUUID->"8327c5af-1797-4b44-bd23-0a521e41feca"],

Cell[BoxData["24"], "Output",
 CellLabel->"Out[3]=",
 CellID->996304424,ExpressionUUID->"4eef2869-44ea-4f34-8c19-ecfae9aaff01"]
}, Open  ]],

