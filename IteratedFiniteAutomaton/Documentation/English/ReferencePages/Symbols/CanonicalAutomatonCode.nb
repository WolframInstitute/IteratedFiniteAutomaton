Notebook[{

Cell[CellGroupData[{
Cell["CanonicalAutomatonCode", "ObjectName",
 CellID->911676747,ExpressionUUID->"ef841bf4-cc61-4649-91c3-2db4643cdf18"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"926b5823-4fca-45e1-8706-fb27fed62ec0"],
 Cell[BoxData[
  RowBox[{"CanonicalAutomatonCode", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d974e690-0d94-46f6-ada8-140581a4b55b"],
 " \[LineSeparator]",
 "gives the least code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "fba74bac-ee7d-4b13-aabf-4691283130f3"],
 " in the orbit of the automaton under relabelling its states and its symbols."
}], "Usage",
 CellID->463307255,ExpressionUUID->"0ade0a57-544e-4ca4-92cf-2c14d4907184"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "9e8fff1f-0603-4efe-92b9-0c6546a44893"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "2dec9ff6-1775-4687-a800-958c4aef619a"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "50b02b31-5663-432a-bbe8-0bc9f1b259ce"],
 "."
}], "Notes",
 CellID->795622309,ExpressionUUID->"cce113da-2a38-464f-9b1c-08e893af64e7"],

Cell["\<\
Two automata that differ only by a relabelling get the same canonical code, \
so it is a complete invariant of the relabelling class.\
\>", "Notes",
 CellID->967788038,ExpressionUUID->"03b1e1aa-70e2-404f-9ede-a95f17ab359c"],

Cell[TextData[{
 "The orbit is taken over all ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["s", "TI"], "!"}], " ", 
   RowBox[{
    StyleBox["k", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "173e87e9-9ad0-4cb4-b0e3-f1ffcdfd3824"],
 " relabellings, so the cost grows quickly with the state count."
}], "Notes",
 CellID->190585345,ExpressionUUID->"b3a9fca5-0d1b-4f27-a0da-5880949909f0"]
}, Open  ]],

