Cell["\<\
The canonical code is a canonical form: it is idempotent, and never exceeds \
the code it came from:\
\>", "ExampleText",
 CellID->266549078,ExpressionUUID->"f9601033-3f62-46a6-9ccf-054e19a35631"],

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"CanonicalAutomatonCode", "[", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "===", 
     RowBox[{"CanonicalAutomatonCode", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"InvertibleAutomatonCodes", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->583023161,ExpressionUUID->"376b1cdd-8494-4256-b7d5-c73ed0fb45d0"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->589931742,ExpressionUUID->"6af8d188-de41-4bd9-9b2f-1c87c26c5177"],

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"CanonicalAutomatonCode", "[", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], "]"}], "\[LessEqual]",
      "m"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"InvertibleAutomatonCodes", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], "]"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->772382335,ExpressionUUID->"22a5a5f0-a55d-4fef-956b-2c10398c5291"],

Cell[BoxData[
 RowBox[{"{", "True", "}"}]], "Output",
