  ButtonBox["ArrayPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayPlot"]], "InlineFormula",ExpressionUUID->
  "8df0b598-f5cb-4270-84a4-25bb5c956b5a"],
 "."
}], "Usage",
 CellID->808968997,ExpressionUUID->"13aa7361-4108-4f27-a0f6-da64d4127848"],

Cell[TextData[{
 "The symbol 0 is always ",
 Cell[BoxData[
  ButtonBox["White",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/White"]], "InlineFormula",ExpressionUUID->
  "1e0fc852-a44d-4ecc-acf6-34ca23839c83"],
 "; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[Equal]", "2"}]], "InlineFormula",ExpressionUUID->
  "9678ac55-4cbb-4861-ab46-f447bc9c119d"],
 " the symbol 1 is ",
 Cell[BoxData[
  ButtonBox["Black",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Black"]], "InlineFormula",ExpressionUUID->
  "2e373d98-fcb1-4d89-9ea3-e55bf64ec261"],
 "."
}], "Notes",
 CellID->835323513,ExpressionUUID->"188cf49e-4717-4546-acda-b27d7891f609"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "2"}]], "InlineFormula",ExpressionUUID->
  "8d7c20ae-a863-4664-9763-d639993ac1a1"],
 " the symbols 1, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "9b49e1ca-5b7b-4f0c-9865-3e3ffe96e8fd"],
 " get the first colors of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ColorData",
