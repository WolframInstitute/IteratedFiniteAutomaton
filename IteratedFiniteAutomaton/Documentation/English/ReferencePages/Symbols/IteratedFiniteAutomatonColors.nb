Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"893d322a-ed8c-4b6d-8c1a-2b477d63c8ea"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonColors", "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7928c1a0-49be-4e63-a39a-f36665d9ced7"],
 " \[LineSeparator]",
 "gives color rules for ",
