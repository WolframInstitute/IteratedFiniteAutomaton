Cell["Color rules for two and for four symbols:", "ExampleText",
 CellID->492383817,ExpressionUUID->"026703e5-dd62-4958-975f-6bfeb1bb6649"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonColors", "[", "2", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->703873428,ExpressionUUID->"0ddbfd90-4b89-4b18-ba2f-83040462033a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", "\[Rule]", 
    TemplateBox[<|"color" -> GrayLevel[1]|>,
     "GrayLevelColorSwatchTemplate"]}], ",", 
   RowBox[{"1", "\[Rule]", 
    TemplateBox[<|"color" -> GrayLevel[0]|>,
     "GrayLevelColorSwatchTemplate"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->219495529,ExpressionUUID->"3318bb06-5d3b-4571-9619-983cfc08d59e"],

