  RowBox[{
   RowBox[{"0", "\[Rule]", 
    TemplateBox[<|"color" -> GrayLevel[1]|>,
     "GrayLevelColorSwatchTemplate"]}], ",", 
   RowBox[{"1", "\[Rule]", 
    TemplateBox[<|"color" -> RGBColor[0.368417, 0.506779, 0.709798]|>,
     "RGBColorSwatchTemplate"]}], ",", 
   RowBox[{"2", "\[Rule]", 
    TemplateBox[<|"color" -> RGBColor[0.880722, 0.611041, 0.142051]|>,
     "RGBColorSwatchTemplate"]}], ",", 
