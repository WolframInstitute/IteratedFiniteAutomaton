Cell["Color rules for two and for four symbols:", "ExampleText",
 CellID->637253443,ExpressionUUID->"be90e40c-c0f2-4a63-9350-605dad2c551c"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonColors", "[", "2", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->883260311,ExpressionUUID->"5375b780-f7ac-4a71-a7d1-7384c71d4431"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", "\[Rule]", 
    TemplateBox[<|"color" -> GrayLevel[1]|>,
     "GrayLevelColorSwatchTemplate"]}], ",", 
   RowBox[{"1", "\[Rule]", 
    TemplateBox[<|"color" -> GrayLevel[0]|>,
     "GrayLevelColorSwatchTemplate"]}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->885688456,ExpressionUUID->"90b92a3d-09b7-493f-8e88-5ab2f5ba266e"],

