Cell[CellGroupData[{
Cell["AutomatonWreathRecursion", "ObjectName",
 CellID->542900582,ExpressionUUID->"1ade4fcd-a351-4c62-b7fe-53d3dbe14fae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eabf8a87-38eb-4199-ae6b-c20d42c2d0c7"],
 Cell[BoxData[
  RowBox[{"AutomatonWreathRecursion", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6eeeeb2b-c39a-4543-a094-6200d464968b"],
 " \[LineSeparator]",
 "gives the wreath recursion as ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "aa0ed2b8-7a24-423d-809c-4db8e757d20c"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7201337e-5926-4e03-b06d-efbd2ad42c68"],
 Cell[BoxData[
  RowBox[{"AutomatonWreathRecursion", "[", 
   StyleBox["automaton", "TI"], ",", 
   RowBox[{
    ButtonBox["Method",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<String\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"e4968614-4c9d-41ed-aa40-97b89cc27b2f"],
 " \[LineSeparator]",
 "gives the printable rendering ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", 
   RowBox[{"\[Sigma]", "(", 
    RowBox[{
     StyleBox["b", "TI"], ",", 
     StyleBox["c", "TI"]}], ")"}]}]], "InlineFormula",ExpressionUUID->
  "869e6818-88e3-4e3a-8b0d-bbad08a30140"],
 " instead."
}], "Usage",
 CellID->276339641,ExpressionUUID->"29dd724f-a41d-4dd7-9a5f-4f3355adb1b1"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "bb0c3a93-8f42-46f7-84c7-6d121501a9ab"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "5d42d83b-b1da-427f-a30b-c774962ba745"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "ea0e0437-e12c-4eed-a996-6dd4038dfea2"],
 "."
}], "Notes",
 CellID->779454737,ExpressionUUID->"57633b8b-8725-40b2-8558-f124337ce612"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "c82f8e04-ff74-43a3-974a-a9330f8d742f"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "00e0086d-24af-4c3e-9efc-bc717b644af2"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "d9fa4981-ca88-43f1-8fba-22b98480dd37"],
 "."
}], "Notes",
 CellID->357378575,ExpressionUUID->"d795e6e5-90d6-46f4-8828-00de39ebcd88"],

Cell[TextData[{
 "The result is exactly the argument ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromWreath",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromWreath"]], "InlineFormula",ExpressionUUID->
  "0458b30b-4df6-471e-8f81-e445b92b7dae"],
 " consumes, so the two are mutually inverse."
}], "Notes",
 CellID->337671704,ExpressionUUID->"e5916429-fe31-45b9-9bfc-5e043ede56af"],

Cell[TextData[{
 "In the printable form the states are named ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "3472fb53-a4ed-4a02-8b42-371cb5b6442a"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "d009827c-c38f-4666-b547-5c8c6f59990a"],
 ", \[Ellipsis] in state order, ",
 Cell[BoxData[
 "\[Sigma]"], "InlineFormula",ExpressionUUID->
  "460b2af5-45c3-4017-8ba8-a9f4b5502ea0"],
 " marks a nontrivial action on the symbols, and a trivial one is omitted."
}], "Notes",
 CellID->667592550,ExpressionUUID->"f30f6e11-db20-43e0-9838-ea97a5a690c8"]
}, Open  ]],

