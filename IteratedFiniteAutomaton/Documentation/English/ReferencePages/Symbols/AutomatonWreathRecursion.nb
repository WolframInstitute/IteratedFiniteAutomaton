Cell[CellGroupData[{
Cell["AutomatonWreathRecursion", "ObjectName",
 CellID->898781132,ExpressionUUID->"4278e470-cd16-421c-819c-1619848b1e5f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0b34d9d0-334b-4019-8bfb-4fdd76ddb8ec"],
 Cell[BoxData[
  RowBox[{"AutomatonWreathRecursion", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "775aec01-7c8b-4226-be41-c363d89158b1"],
 " \[LineSeparator]",
 "gives the wreath recursion as ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    StyleBox["state", "TI"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["outputs", "TI"], ",", 
      StyleBox["sections", "TI"]}], "}"}]}], ",", "\[Ellipsis]", 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "d485be26-dd12-4d75-abcb-bcd2675bb0a1"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7fc10b14-8a5c-48d4-858b-fad7f6445453"],
 Cell[BoxData[
  RowBox[{"AutomatonWreathRecursion", "[", 
   StyleBox["automaton", "TI"], ",", 
   RowBox[{
    ButtonBox["Method",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Method"], "\[Rule]", "\"\<String\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"cdd8e5dd-551d-49e4-81e7-0e9c4238854a"],
 " \[LineSeparator]",
 "gives the printable rendering ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", 
   RowBox[{"\[Sigma]", "(", 
    RowBox[{
     StyleBox["b", "TI"], ",", 
     StyleBox["c", "TI"]}], ")"}]}]], "InlineFormula",ExpressionUUID->
  "601066d8-409f-48fb-8faf-6945c90a8659"],
 " instead."
}], "Usage",
 CellID->111445183,ExpressionUUID->"38f8794d-d49a-479d-8cb9-51652b715c89"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "ca0f7ba6-98b2-4f00-9492-f3e74d73bd77"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "ba96f428-98c3-4238-a7ad-f8f2526c13f0"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "b88ddf3e-c608-426d-96e2-ac6fff0915ff"],
 "."
}], "Notes",
 CellID->889933681,ExpressionUUID->"6f45f1e4-74af-4f0f-8921-ee99a0833734"],

Cell[TextData[{
 "A state ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "4da7a8f9-87f0-490d-a613-0c21002f24b1"],
 " with entry ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["outputs", "TI"], ",", 
    StyleBox["sections", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c80455c5-ef4a-4085-87fc-4c38ab05d2d0"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], " ", 
     StyleBox["w", "TI"]}], ")"}], "\[Equal]", 
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], 
     StyleBox["i", "TI"]], " ", 
    RowBox[{
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox["i", "TI"]], "(", 
     StyleBox["w", "TI"], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "493bd7aa-683b-4819-bed4-471d16ff5190"],
 "."
}], "Notes",
 CellID->228896255,ExpressionUUID->"3b4efc79-93ce-49c1-b294-4b8f29b64d88"],

Cell[TextData[{
 "The result is exactly the argument ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromWreath",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromWreath"]], "InlineFormula",ExpressionUUID->
  "d1e708b5-c308-40ec-be7d-bdc746927107"],
 " consumes, so the two are mutually inverse."
}], "Notes",
 CellID->102419050,ExpressionUUID->"044810a0-7579-4035-8b4e-581194f8699e"],

Cell[TextData[{
 "In the printable form the states are named ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "c39e1065-35b5-45f9-af50-2eee44d8caef"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "7b29abce-1f2c-462d-953e-a1045edee14d"],
 ", \[Ellipsis] in state order, ",
 Cell[BoxData[
 "\[Sigma]"], "InlineFormula",ExpressionUUID->
  "27febf18-cfc2-4e50-8eb0-a643e02effe2"],
 " marks a nontrivial action on the symbols, and a trivial one is omitted."
}], "Notes",
 CellID->365656669,ExpressionUUID->"81db21ec-3927-4270-b893-329f651b92f4"]
}, Open  ]],

