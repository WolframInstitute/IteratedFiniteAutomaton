Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "7d995006-fdfc-4d51-9177-44368c23aebd"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "1c117072-8da5-466b-b6d1-af65761cbee5"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "94803abc-787a-4121-9453-05cbfb886166"],
 "."
}], "Notes",
 CellID->661274123,ExpressionUUID->"b15d3da1-41eb-4016-8298-01c0c098c2ec"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "c100b277-e2da-45a3-8d15-4ab83c7af550"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "38603b7f-dba3-4671-afe0-c26d36cc004e"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "a0465544-2918-463d-b059-c162c3268edd"],
 "."
}], "Notes",
 CellID->638193909,ExpressionUUID->"ad875d90-4eef-4861-b3d9-a61499417dfe"],

Cell[TextData[{
 "The tree vertex ",
 Cell[BoxData[
  StyleBox["treeWord", "TI"]], "InlineFormula",ExpressionUUID->
  "e774f8a4-40f9-44c4-b529-7f16ca129b73"],
 " is a list of symbols; its length is the depth at which the section is \
taken."
}], "Notes",
 CellID->407247080,ExpressionUUID->"a7a8a3b0-f6f6-4182-950a-bbf8a7aec1f1"],

