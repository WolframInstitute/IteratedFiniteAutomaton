 "."
}], "Usage",
 CellID->869807305,ExpressionUUID->"a9625d1a-ff38-4fd5-b641-11a026174bae"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "f4efcec5-ffca-4796-ac0b-f2d439486493"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "f4217a81-48cd-40eb-81a4-bfe56d2769c4"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "da690c63-2e50-4b28-bbc7-bce980334299"],
 "."
}], "Notes",
 CellID->731094346,ExpressionUUID->"40a3b8db-467e-4c44-a3e8-a77dbea90a2b"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "4bc1592e-fcf0-4174-a62e-c0a3c5c6a5ef"],
 " is a list of state numbers, read left to right; a negative entry ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["g", "TI"]}]], "InlineFormula",ExpressionUUID->
  "306a6034-afbe-4361-9679-256350824859"],
 " means the inverse of generator ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "5a04af37-ffb6-4aef-a6dc-4fb286ef62ca"],
 "."
}], "Notes",
 CellID->290162983,ExpressionUUID->"080758b1-bee8-419c-8090-e4a5087b1a4d"],

Cell[TextData[{
 "The tree vertex ",
 Cell[BoxData[
  StyleBox["treeWord", "TI"]], "InlineFormula",ExpressionUUID->
  "27093a8d-27ac-4c6a-802f-2715d3640973"],
 " is a list of symbols; its length is the depth at which the section is \
taken."
}], "Notes",
 CellID->608585471,ExpressionUUID->"a64a6c67-488e-4dda-bb2b-0876c0fa383b"],

Cell[TextData[{
