   StyleBox["treeWord", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7819b223-7010-408d-8244-8598fd3cb190"],
 " \[LineSeparator]",
 "gives the section of ",
 Cell[BoxData[
  StyleBox["word", "TI"]], "InlineFormula",ExpressionUUID->
  "41770a2d-2c88-43a0-9ffa-baad0469632c"],
