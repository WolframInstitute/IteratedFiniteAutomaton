Cell["AutomatonSection", "ObjectName",
 CellID->118939942,ExpressionUUID->"4d0833bb-6b25-46a5-8ee1-49486b4d14db"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7f7eaf47-d6c7-41c1-be38-57992bbb53de"],
 Cell[BoxData[
  RowBox[{"AutomatonSection", "[", 
   StyleBox["automaton", "TI"], ",", 
