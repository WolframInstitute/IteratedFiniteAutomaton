Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentSurvival", "ObjectName",
 CellID->996160782,ExpressionUUID->"ff8732b0-8c53-4cc9-a50b-66027d61e23d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ac7f891c-40e8-4abe-9b71-1baff2339724"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentSurvival", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "34681c28-c9a3-4e91-9d74-ea36f198a810"],
 " \[LineSeparator]",
 "searches over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "2a4f171f-2133-42d0-925c-48caf76f2463"],
 " for elements supported on the radius ball that are idempotent in every \
level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "1ab6ee7f-5276-4676-b642-eb2bc84588b3"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Support\>\"", ",", "\"\<Counts\>\"", 
    ",", "\"\<Survivors\>\""}], "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"835d5eaf-c559-4e99-8e35-e052ca6042d4"],
 "."
}], "Usage",
 CellID->909679825,ExpressionUUID->"e8688568-fd9a-4917-aa39-11b8b568bdd7"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "b3543827-dbdb-4e4d-a93a-d7b073eb87cd"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "568018b5-632b-4952-b115-ffa8171f7dc2"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "fad918b0-a23e-4d56-8c34-e650d7e059e3"],
 " is 1."
}], "Notes",
 CellID->516010669,ExpressionUUID->"9126998b-a741-4b13-86d2-6b776bd96fad"],

Cell["\<\
\"Counts\" records how many candidates remain after each level, so it shows \
where the filter does its work; the search stops early once nothing is left.\
\>", "Notes",
 CellID->827697955,ExpressionUUID->"7c790d50-051d-4b0d-a3e5-f7071b6b915b"],

Cell["\<\
An idempotent other than 0 and 1 is a zero divisor, so an empty \"Survivors\" \
refutes one radius over one field.\
\>", "Notes",
 CellID->520524105,ExpressionUUID->"232679ff-bbb8-404a-adb7-9809243a5613"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MaxTerms",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/MaxTerms"]], 
  "InlineFormula",ExpressionUUID->"8015fb09-f426-43f4-acd5-94e69a112d92"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "c7236e00-c5b9-401b-bf67-db75aa9bad88"],
 " restricts candidates to at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "b5e8dbb6-1688-4ccf-b720-a405a072a7b3"],
 " nonzero terms; ",
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "9d368cc4-da70-405f-852d-f2cc9ed1eb96"],
 " selects the field and defaults to 2."
}], "Notes",
 CellID->575351907,ExpressionUUID->"95ec7e03-c8b0-48e1-a2ab-80317a723e7b"]
}, Open  ]],

