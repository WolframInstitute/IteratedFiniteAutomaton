Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentSurvival", "ObjectName",
 CellID->335639576,ExpressionUUID->"40a9f9a6-b21d-4868-ab54-6763679bd84b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a96f1cc0-e1eb-4d7a-a1d7-f4e4efea28f9"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentSurvival", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "47cfd1f8-06be-4b9e-8870-3667c465b5a7"],
 " \[LineSeparator]",
 "searches over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "e20f3c10-7047-4e00-9fc3-a1a91fefce7c"],
 " for elements supported on the radius ball that are idempotent in every \
level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "39851c4c-51ce-482a-a192-0e40960c1edd"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Support\>\"", ",", "\"\<Counts\>\"", 
    ",", "\"\<Survivors\>\""}], "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"ca1a8598-c134-441c-bece-f0d17d5ce917"],
 "."
}], "Usage",
 CellID->470790590,ExpressionUUID->"347b52b4-e720-4b7e-9437-23c4849b0058"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "e69536dd-3811-43db-b323-fcab945e1ecc"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "a0ca8bee-fa9f-4386-bb3c-15d9c9d41469"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "52ac16f3-0a42-4d98-b448-12f898aeb001"],
 " is 1."
}], "Notes",
 CellID->144928862,ExpressionUUID->"b01b2ef2-a617-4bba-a236-d0bdb2562996"],

Cell["\<\
\"Counts\" records how many candidates remain after each level, so it shows \
where the filter does its work; the search stops early once nothing is left.\
\>", "Notes",
 CellID->375942126,ExpressionUUID->"e4cc1a60-7c5b-4acc-8ede-6d692e9048bb"],

Cell["\<\
An idempotent other than 0 and 1 is a zero divisor, so an empty \"Survivors\" \
refutes one radius over one field.\
\>", "Notes",
 CellID->784673164,ExpressionUUID->"65fb7b72-f7c5-44fe-84fe-6ef1f2a39ac0"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MaxTerms",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/MaxTerms"]], 
  "InlineFormula",ExpressionUUID->"6447f4e9-0e92-4512-a98d-c9deaa95705a"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "c1081958-adc3-47f0-9fe5-28c90007d5e2"],
 " restricts candidates to at most ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "6c780c79-bfc3-4260-ba78-12f404a06ade"],
 " nonzero terms; ",
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "ce517e7a-4c6c-4a78-b7c4-3ea9af7ff485"],
 " selects the field and defaults to 2."
}], "Notes",
 CellID->490112108,ExpressionUUID->"8c2a2728-ef5d-4425-9884-7a4a2a1e126f"]
}, Open  ]],

