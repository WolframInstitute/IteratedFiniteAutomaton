Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonEvolve", "ObjectName",
 CellID->175025711,ExpressionUUID->"6e80b5fc-9de6-4ce1-9abe-aac76c5fa080"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d6149918-3211-4e19-bd97-f8e0d6387a82"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
   StyleBox["conv", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6f7648e1-78dd-4a26-9bf9-b5fc17777abe"],
 " \[LineSeparator]",
 "evolves the converted automaton ",
 Cell[BoxData[
  StyleBox["conv", "TI"]], "InlineFormula",ExpressionUUID->
  "6f712fac-61e5-4539-9664-853639e00aab"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "4160a820-60e5-48e6-b7fe-1e48a1a2d5e5"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "9ed5aa87-cf8c-4efe-95f5-11f58aef64b0"],
 " steps."
}], "Usage",
 CellID->170586903,ExpressionUUID->"8154f29b-e1d7-438f-b073-c90941475d7d"],

Cell[TextData[{
 "The conversion ",
 Cell[BoxData[
  StyleBox["conv", "TI"]], "InlineFormula",ExpressionUUID->
  "a354dc44-5b68-4df7-88ca-039a02589b06"],
 " is as returned by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromStates",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromStates"]], "InlineFormula",ExpressionUUID->
  "60309111-24f6-4bf0-a4bc-72fdf604d614"],
 " or ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromWreath",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromWreath"]], "InlineFormula",ExpressionUUID->
  "8a6f5527-1387-448d-8e9c-8fd39aa1d65a"],
 "."
}], "Notes",
 CellID->356409266,ExpressionUUID->"7cad250d-d657-4fbe-802f-03447b090fe4"],

Cell[TextData[{
 "Equivalent to ",
