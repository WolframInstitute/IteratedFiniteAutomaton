Cell["\<\
A Mealy transducer with named states, converted and evolved as a spacetime \
diagram:\
\>", "ExampleText",
 CellID->945563384,ExpressionUUID->"b510eaf4-606c-452d-939d-ed009d951ff4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"converted", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<eps\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<lam\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
     ",", "\"\<eps\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->998351869,ExpressionUUID->"24c964a1-fe7e-4a53-8e90-37ff6f3bdee8"],

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
    RowBox[{"converted", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "6"}], "]"}], ",", "32"}], "]"}], ",", 
   RowBox[{"ColorRules", "\[Rule]", 
    RowBox[{"IteratedFiniteAutomatonColors", "[", "2", "]"}]}], ",", 
   RowBox[{"Mesh", "\[Rule]", "True"}], ",", 
