Cell["Convert a wreath recursion and evolve it:", "ExampleText",
 CellID->295717044,ExpressionUUID->"a8c2bd6f-447d-4961-a8a2-cb0d1e6d99a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"conversion", "=", 
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], ",", "\"\<a\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->432783144,ExpressionUUID->"4a248a04-4d29-4128-ac6e-1fa9e67a7ab4"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->479257631,ExpressionUUID->"c3ba609e-deba-4a26-bb51-693945b4d79e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->262780206,ExpressionUUID->"08ef9fdc-713b-41dc-a293-c48f9f3986ec"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"f4010401-15fd-494f-a02e-52a1dd928ffb"],
