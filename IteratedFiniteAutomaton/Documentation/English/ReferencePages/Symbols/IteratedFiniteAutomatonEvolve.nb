Cell["Convert a wreath recursion and evolve it:", "ExampleText",
 CellID->508811168,ExpressionUUID->"2e32c61e-21d5-45bd-9671-cbaef27ed82c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"conversion", "=", 
   RowBox[{"IteratedFiniteAutomatonFromWreath", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<a\>\""}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<id\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<id\>\"", ",", "\"\<id\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], ",", "\"\<a\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->782542054,ExpressionUUID->"61d056ac-9ed9-400a-95cb-8adba6da656b"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
  RowBox[{"conversion", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "7"}], "]"}], ",", "3"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->151994834,ExpressionUUID->"af7c4432-e3b7-4ce1-8738-3125288386ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}],
     "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->255129025,ExpressionUUID->"f34c0f9f-2d54-43e2-910e-c29bcc191fc6"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t",ExpressionUUID->"c2e5cae9-26a1-40b3-9855-166c64e9dee0"],
  $Line = 0; Null]], "ExampleDelimiter",
