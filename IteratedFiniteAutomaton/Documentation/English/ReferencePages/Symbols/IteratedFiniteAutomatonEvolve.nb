Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonEvolve", "ObjectName",
 CellID->550557279,ExpressionUUID->"8439f804-7235-475b-9057-4080e8ea1d38"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f5ec08b-e5f7-4719-9b1b-4fc862431652"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
   StyleBox["conv", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "94d0aad0-51f1-453a-8023-d6426dcb2077"],
 " \[LineSeparator]",
 "evolves the converted automaton ",
 Cell[BoxData[
  StyleBox["conv", "TI"]], "InlineFormula",ExpressionUUID->
  "bf09af43-64b6-41aa-9bcc-5902c1f57afa"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "931ef308-b27c-4ea1-9f14-2e432dca22ac"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "f9d46f8f-63bb-4bdd-977b-7fdffcb83684"],
 " steps."
}], "Usage",
 CellID->261447434,ExpressionUUID->"bd550144-a5f6-4b86-a839-99308a08dbf3"],

Cell[TextData[{
 "The conversion ",
 Cell[BoxData[
  StyleBox["conv", "TI"]], "InlineFormula",ExpressionUUID->
  "b712ff32-a740-4d66-89ca-02a475b2abb6"],
 " is as returned by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromStates",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromStates"]], "InlineFormula",ExpressionUUID->
  "513ce814-29a5-4f92-bcaa-a5aca79fcf06"],
 " or ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonFromWreath",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonFromWreath"]], "InlineFormula",ExpressionUUID->
  "ab6d8efa-713e-4d34-ad3a-3c9ea7e31911"],
 "."
}], "Notes",
 CellID->944303706,ExpressionUUID->"9e06f93f-62e6-4873-ae93-232044b1fb30"],

Cell[TextData[{
 "Equivalent to ",
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   RowBox[{
    RowBox[{
     StyleBox["conv", "TI"], "[", "\"\<Rule\>\"", "]"}], ",", 
    RowBox[{
     StyleBox["conv", "TI"], "[", "\"\<InitialState\>\"", "]"}], ",", 
    StyleBox["init", "TI"], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c46c5813-5af1-4677-a56d-c0b2d2329ba8"],
 "."
}], "Notes",
 CellID->527608219,ExpressionUUID->"a3b9948e-0145-41c2-ac11-123404b6e276"]
}, Open  ]],

