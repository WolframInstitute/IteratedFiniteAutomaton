Cell["\<\
A Mealy transducer with named states, converted and evolved as a spacetime \
diagram:\
\>", "ExampleText",
 CellID->571423442,ExpressionUUID->"3e57a5e9-4496-4be6-bccd-6ac7a8983b71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"converted", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<eps\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<lam\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
     ",", "\"\<eps\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->894752858,ExpressionUUID->"c8afef00-d57f-41e9-a088-a265b159e0a0"],

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
    RowBox[{"converted", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "6"}], "]"}], ",", "32"}], "]"}], ",", 
   RowBox[{"ColorRules", "\[Rule]", 
    RowBox[{"IteratedFiniteAutomatonColors", "[", "2", "]"}]}], ",", 
   RowBox[{"Mesh", "\[Rule]", "True"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "160"}]}], "]"}]], "Input",
