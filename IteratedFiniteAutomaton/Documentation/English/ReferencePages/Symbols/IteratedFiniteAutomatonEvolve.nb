Cell["\<\
A Mealy transducer with named states, converted and evolved as a spacetime \
diagram:\
\>", "ExampleText",
 CellID->649438577,ExpressionUUID->"cdce2286-db4b-4a2f-ad13-982221f4bd6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"converted", "=", 
   RowBox[{"IteratedFiniteAutomatonFromStates", "[", 
    RowBox[{
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<eps\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<eps\>\""}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<lam\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\"\<lam\>\""}], "}"}]}], ",", 
          RowBox[{"1", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "\"\<lam\>\""}], "}"}]}]}], "}"}]}]}], "]"}], 
     ",", "\"\<eps\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->498634357,ExpressionUUID->"26e3925d-e6e3-4cff-b15b-58af6a7234d0"],

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"IteratedFiniteAutomatonEvolve", "[", 
    RowBox[{"converted", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "6"}], "]"}], ",", "32"}], "]"}], ",", 
   RowBox[{"ColorRules", "\[Rule]", 
    RowBox[{"IteratedFiniteAutomatonColors", "[", "2", "]"}]}], ",", 
   RowBox[{"Mesh", "\[Rule]", "True"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "160"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->814256360,ExpressionUUID->"6646cae2-e34e-4db6-bc07-e6aa3caf8c10"],

