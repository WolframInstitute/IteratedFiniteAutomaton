Cell["\<\
The adding machine is invertible; the automaton that writes 0 everywhere is \
not:\
\>", "ExampleText",
 CellID->109817369,ExpressionUUID->"7b3c85ce-519c-44cd-8a9a-e82d80ef308b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InvertibleAutomatonQ", "[", 
    RowBox[{"{", 
     RowBox[{"62", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
   RowBox[{"InvertibleAutomatonQ", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->177018712,ExpressionUUID->"6dcc4dbb-638d-4cfb-b4c3-19c2377cf6c3"],

