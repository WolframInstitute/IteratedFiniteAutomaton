Notebook[{

Cell[CellGroupData[{
Cell["InvertibleAutomatonQ", "ObjectName",
 CellID->250857901,ExpressionUUID->"9a031e79-f2f6-4930-9cdc-4e5b0290e991"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"904b6f6d-d34f-4129-b98d-68dc0dc45b78"],
 Cell[BoxData[
  RowBox[{"InvertibleAutomatonQ", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "eb1b6057-6865-44da-8672-c769f81bdc4f"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "1959dbf6-1f64-4240-bb72-8af98263439b"],
 " if the outputs at each state permute the symbols."
}], "Usage",
 CellID->948729999,ExpressionUUID->"1f13486a-6e6b-4c26-ba7f-e12c39c46296"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "c9b73842-250f-4447-b1ca-4ca8ea3feda5"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "0a3738a8-41ac-41f5-b945-a31ed3d3b2fa"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "1c45a72a-67ff-447f-b6d8-b84762bab010"],
 "."
}], "Notes",
 CellID->572320738,ExpressionUUID->"c0befb6a-c6b4-416d-b1b7-7e86edb31e8f"],

Cell[TextData[{
 "An invertible automaton acts on the infinite rooted ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "1897c49a-72d0-4b92-abf1-f6fe373eaab5"],
 "-ary tree by automorphisms, so its states generate a group \[LongDash] this \
is what makes an automaton group."
}], "Notes",
 CellID->519291995,ExpressionUUID->"e51ee5f4-40d3-4b63-8697-3b5cc5be762a"],

Cell[TextData[{
 "There are ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "!"}], ")"}], 
    StyleBox["s", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "792ff014-74ac-4509-9b64-f3fb296ea956"],
 " invertible automata over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "750936da-b97b-4df8-aabc-f98289b16f97"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "7ce895c9-2072-441b-888e-08e1cfbcdf43"],
 " symbols."
}], "Notes",
 CellID->833206389,ExpressionUUID->"ec78385a-f51d-467c-8544-ebcad9aa10ad"]
}, Open  ]],

