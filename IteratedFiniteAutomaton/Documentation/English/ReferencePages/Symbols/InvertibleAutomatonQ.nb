 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->202834543,ExpressionUUID->"6e38e250-667e-4dad-abf2-c48d8144a872"],

