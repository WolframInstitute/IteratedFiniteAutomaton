Cell["\<\
Exactly 64 of the 256 automata on two states and two symbols are invertible:\
\>", "ExampleText",
 CellID->397003397,ExpressionUUID->"a5aeb025-5f7f-45ba-8e9b-547f1ea40672"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"Boole", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InvertibleAutomatonQ", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->415160598,ExpressionUUID->"ff4118ec-a261-40d4-b59c-7f5b7a359fce"],

