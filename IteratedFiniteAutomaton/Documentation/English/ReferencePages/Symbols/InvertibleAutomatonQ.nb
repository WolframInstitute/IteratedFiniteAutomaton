Notebook[{

Cell[CellGroupData[{
Cell["InvertibleAutomatonQ", "ObjectName",
 CellID->663364598,ExpressionUUID->"57cd0630-250a-4df5-936c-1dfb742af6cf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"33bd52e9-4a05-447b-8d03-9686db900853"],
 Cell[BoxData[
  RowBox[{"InvertibleAutomatonQ", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6e13015c-2666-4340-81a8-a0fb133a23dc"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "ff767609-798f-4ab4-a5e4-e6b0ec81d80a"],
 " if the outputs at each state permute the symbols."
}], "Usage",
 CellID->427087319,ExpressionUUID->"91fcf1b7-d353-4209-9df6-e8c34cc47569"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "a022ec8d-d5aa-4d9f-b49b-3ae2c1616f9b"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "d7443e52-7d81-4f89-b5a8-dc550be37534"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "271cbaf2-0a4d-474e-b712-a48e9c61f15e"],
 "."
}], "Notes",
 CellID->390887945,ExpressionUUID->"de57a00a-e2e0-4420-98d8-a04d299509a0"],

Cell[TextData[{
 "An invertible automaton acts on the infinite rooted ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "f1b87ba0-9942-4499-8c34-737cb0817927"],
 "-ary tree by automorphisms, so its states generate a group \[LongDash] this \
is what makes an automaton group."
}], "Notes",
 CellID->445215557,ExpressionUUID->"f2e5b2a8-181c-4785-8557-1ff53bd2872d"],

Cell[TextData[{
 "There are ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "!"}], ")"}], 
    StyleBox["s", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "d7f13f82-96c3-4987-8d23-ca81ddcd2e1c"],
 " invertible automata over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "b761105a-5936-411c-a675-5a0bdcc76d73"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "0ed3c877-2475-444f-91b6-be322ed82d8a"],
 " symbols."
}], "Notes",
 CellID->200494088,ExpressionUUID->"c43ba96e-8577-4eea-b8e5-5f0272394de4"]
}, Open  ]],

