Cell["\<\
Exactly 64 of the 256 automata on two states and two symbols are invertible:\
\>", "ExampleText",
 CellID->923929947,ExpressionUUID->"b71ec4a1-b8a8-4a7b-bb06-7bc56b316b93"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"Boole", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"InvertibleAutomatonQ", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
