Cell["\<\
The adding machine is invertible; the automaton that writes 0 everywhere is \
not:\
\>", "ExampleText",
 CellID->142037765,ExpressionUUID->"ca35f1fd-838b-4da4-b0a2-638d9f2d243e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InvertibleAutomatonQ", "[", 
    RowBox[{"{", 
     RowBox[{"62", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}], ",", 
   RowBox[{"InvertibleAutomatonQ", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->436191685,ExpressionUUID->"0ea71a63-7969-41b4-aa1e-bfc58bbaaa19"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->183075694,ExpressionUUID->"0c7a9441-3fb0-4939-a4ff-32094eb7b2e0"],

