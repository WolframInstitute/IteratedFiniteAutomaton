Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateSubgraph", "ObjectName",
 CellID->174129938,ExpressionUUID->"b58f3e18-63c4-4fda-9e92-34e079033b88"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"acd1b01c-b2fc-4e91-9762-ce9e3f06298d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateSubgraph", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["s0", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "102c7357-b67d-4752-816e-fd6280f004b3"],
 " \[LineSeparator]",
 "gives the sub-digraph of the Moore diagram whose edges the tape ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "ea0998a6-9ffb-4c71-9bf6-3d2d24e2b903"],
 " traverses in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "150e563e-0398-4068-89b3-0a9e31b10974"],
 " steps, as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "46965d93-d073-40bd-9b40-faf53f5cf144"],
 " on every state of the automaton.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9d975e58-1eaa-44ec-ac69-c97af4b36075"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateSubgraph", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["s0", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "34522964-5719-47b0-a229-02f7e0c770ab"],
 " \[LineSeparator]",
 "uses one step.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f9c2aa3-ee80-4b8e-9b41-795b2c57b378"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateSubgraph", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["s0", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1e683528-22bb-493c-8319-b547976d1722"],
 " \[LineSeparator]",
 "is the operator form."
}], "Usage",
 CellID->712569998,ExpressionUUID->"6ec2fd43-239b-4c91-8e84-3e0c5ddcc1b5"],

Cell["\<\
Every state stays a vertex, so an isolated vertex is exactly a state this \
tape never visits.\
\>", "Notes",
 CellID->794416841,ExpressionUUID->"90e2fc69-ff24-4a4c-b1c7-5f890a5aea48"],

Cell[TextData[{
 "The edge sets are nested in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "bef9f022-1e7e-4e86-8942-6d864ee7e81e"],
 ": what a tape traverses in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "e4936624-bd7d-4d63-960b-a95db77ba3de"],
 " steps it traverses in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "69fe6b50-179e-44ad-830a-33f63dec71aa"],
 " steps as well."
}], "Notes",
 CellID->108505165,ExpressionUUID->"9c0d81b3-f49f-41f9-80a9-af90dfe382a0"],

Cell[TextData[{
 "The default step count is one, which is the regime where the subgraph \
depends on the tape most; as ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "33177865-450b-4ba4-9d85-855fa720004b"],
 " grows the tapes saturate the diagram."
}], "Notes",
 CellID->269681338,ExpressionUUID->"e9e41cd6-ff2c-491c-856c-df739e0f074f"]
}, Open  ]],

