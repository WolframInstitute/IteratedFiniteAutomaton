Cell["\<\
The part of the adding machine's diagram that a tape of zeros traverses:\
\>", "ExampleText",
 CellID->866674428,ExpressionUUID->"1c5bd57e-0d93-4e12-8ba8-3a7ef9724105"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomatonStateSubgraph", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}], ",", "1", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->799739387,ExpressionUUID->"6f2f78de-4c3f-489e-a87f-0e378040c14b"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2}, {{{1, 2}, {2, 2}}, Null, {0 -> 1, 0 -> 0}}, {
      EdgeLabels -> {"EdgeTag"}, VertexLabels -> {Automatic}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
        Medium], {
         ArrowBox[{{1., 0.}, {0., 1.2246467991473532`*^-16}}, 0.01273], 
         InsetBox[
          RowBox[{"0", "\[Rule]", "1"}], {0.5, 6.123233995736766*^-17}, 
          ImageScaled[{0.5, 0.5}],
          BaseStyle->"Graphics"]}, {
         ArrowBox[
          BezierCurveBox[{{0., 
           1.2246467991473532`*^-16}, {-0.08847925546738626, \
-0.19078353238547577`}, {-0.287357733005158, -0.2471797748461211}, \
{-0.4145283574797309, -0.18822269607119427`}, {-0.41452835747973094`, 
