Cell[CellGroupData[{
Cell["AutomatonTreePortrait", "ObjectName",
 CellID->556203962,ExpressionUUID->"b09bb773-bff9-4737-a768-cee347b27fc2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e3a96acc-c28a-4055-8ae0-6bf1b2a51daa"],
 Cell[BoxData[
  RowBox[{"AutomatonTreePortrait", "[", 
   StyleBox["automaton", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b8a52c4c-a59c-4f84-acd5-c04bc2994806"],
 " \[LineSeparator]",
 "gives the depth-",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "2b2669af-01bb-460d-a98e-b22092884237"],
 " prefix of the rooted tree as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "ace33906-e454-4edf-9fb3-9267cb24e0c2"],
 ", each vertex colored by the section of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "a47380fd-0cee-4807-a870-3e7fa41938c0"],
 " there and enlarged when that section permutes its symbols."
}], "Usage",
 CellID->966190201,ExpressionUUID->"1d8219bb-9b83-4f79-a6c7-6040404626dc"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "89efef33-edf6-447f-9e5f-a62d36a1f59f"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "29b52781-ebdc-439a-b47c-4e724b50aacd"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "207c1ca6-4e31-42de-bef7-b976fac5a4ee"],
 "."
}], "Notes",
 CellID->781295861,ExpressionUUID->"dcd5a13c-8f6e-4f0a-bde2-a0a7973abfc3"],

Cell[TextData[{
 "Vertices are the words of length at most ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "0ede379a-b4dc-4f85-b365-acf6353c7556"],
 " over the symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "e4b32682-0c46-4e67-b587-1003d486e4fa"],
 "; the root is the empty word and the children of ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "71a9074d-6134-445c-87cb-fc918b0c4d06"],
 " are ",
 Cell[BoxData[
  RowBox[{"Append", "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cc7bf72a-e251-427b-85cc-db1ea85f470e"],
 "."
}], "Notes",
 CellID->803052115,ExpressionUUID->"0a6e0693-97db-4d4a-8519-4d00096b2c2e"],

Cell[TextData[{
 "The color at ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "7d4bcdcc-e13c-475d-b00d-43d0e037803b"],
 " is the state that ",
 Cell[BoxData[
  ButtonBox["AutomatonSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonSection"]], 
  "InlineFormula",ExpressionUUID->"34f1c624-801f-40f8-aefd-bb21f47496ae"],
 " returns for the one-letter word ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "}"}]], "InlineFormula",ExpressionUUID->
  "51290723-d0b3-41a8-b0ce-6c0c0bf4f4a4"],
 " at the tree vertex ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "c223c7ca-1d19-4a06-9e55-443e2a316bf6"],
 "."
}], "Notes",
 CellID->317996024,ExpressionUUID->"e3810ed1-cef5-40d9-ba4c-e7a80b2a3aed"],

Cell["\<\
A vertex is drawn large exactly when its section is active \[LongDash] it \
moves at least one symbol; sections acting trivially on the alphabet stay \
small.\
\>", "Notes",
 CellID->629079539,ExpressionUUID->"f151894d-1bbe-4585-b0dd-38e142ef85f2"],

Cell[TextData[{
 "The result is a tree: ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], 
     RowBox[{
      StyleBox["level", "TI"], "+", "1"}]], "-", "1"}], 
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}]]], "InlineFormula",ExpressionUUID->
  "f79a16f4-9adb-44a3-aa28-bb4dffc805ea"],
 " vertices and one edge fewer."
}], "Notes",
 CellID->789646446,ExpressionUUID->"ea7b372d-2359-4aaf-850c-a5bdd1adc078"]
}, Open  ]],

