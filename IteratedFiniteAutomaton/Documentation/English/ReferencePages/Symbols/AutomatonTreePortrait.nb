Cell[CellGroupData[{
Cell["AutomatonTreePortrait", "ObjectName",
 CellID->658718839,ExpressionUUID->"63df04e3-15a0-4db5-a934-97bfed7468a1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d3a72673-c67f-4a26-975c-b68d8b0082ad"],
 Cell[BoxData[
  RowBox[{"AutomatonTreePortrait", "[", 
   StyleBox["automaton", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5911d670-7a47-4934-ba24-3e8881e86d23"],
 " \[LineSeparator]",
 "gives the depth-",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "784dd620-c5dc-48fc-814e-7185da33d35d"],
 " prefix of the rooted tree as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "6f71da56-07df-44ae-81e1-ef08437ac170"],
 ", each vertex colored by the section of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "bfea0ad3-ae47-42cc-9095-dc0e216a7531"],
 " there and enlarged when that section permutes its symbols."
}], "Usage",
 CellID->927192263,ExpressionUUID->"6ab42a91-c54a-4253-9651-584234d44f3d"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "17877202-2eb3-4f32-9038-1d9c8b85aa18"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "f378e99f-a819-452e-8146-3d42c79cb2de"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "097a8af2-0cae-4fa5-aa17-7f2e37adb8e2"],
 "."
}], "Notes",
 CellID->735250454,ExpressionUUID->"cd0b5dac-0a2e-41aa-9fc6-94b765ce4350"],

Cell[TextData[{
 "Vertices are the words of length at most ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "59cf462d-3385-46bd-802d-e446d768266c"],
 " over the symbols 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "b2777e1b-b8d3-406f-9c63-92f811cc4f94"],
 "; the root is the empty word and the children of ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "8ac10f78-510e-49be-ac59-083988f6f0b7"],
 " are ",
 Cell[BoxData[
  RowBox[{"Append", "[", 
   RowBox[{
    StyleBox["w", "TI"], ",", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "54521066-04bf-43bd-9e42-08b92f5de8f6"],
 "."
}], "Notes",
 CellID->763850127,ExpressionUUID->"289040bf-d590-4e2e-8426-7eb2cdead0b8"],

Cell[TextData[{
 "The color at ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "2d332810-1209-4243-90f7-0824e8eca0c7"],
 " is the state that ",
 Cell[BoxData[
  ButtonBox["AutomatonSection",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/AutomatonSection"]], 
  "InlineFormula",ExpressionUUID->"cf32a945-6f7d-47e9-8051-02e245789092"],
 " returns for the one-letter word ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "}"}]], "InlineFormula",ExpressionUUID->
  "80df0b6e-7dbc-4ce1-add6-4efc055337e1"],
 " at the tree vertex ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "8b5da177-b2f9-4cb5-bc40-057c76894d7d"],
 "."
}], "Notes",
 CellID->505712598,ExpressionUUID->"cb6e90a6-d048-42a6-af12-722a1d4d6122"],

Cell["\<\
A vertex is drawn large exactly when its section is active \[LongDash] it \
moves at least one symbol; sections acting trivially on the alphabet stay \
small.\
\>", "Notes",
 CellID->209174235,ExpressionUUID->"afbd64cc-878f-4e57-b05b-35eaca4a98e3"],

Cell[TextData[{
 "The result is a tree: ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["k", "TI"], 
     RowBox[{
      StyleBox["level", "TI"], "+", "1"}]], "-", "1"}], 
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}]]], "InlineFormula",ExpressionUUID->
  "b11c6604-c0d9-4904-9f99-d8bc060f8eef"],
 " vertices and one edge fewer."
}], "Notes",
 CellID->580985029,ExpressionUUID->"767362bd-f169-43eb-a68e-c6819a0ed287"]
}, Open  ]],

