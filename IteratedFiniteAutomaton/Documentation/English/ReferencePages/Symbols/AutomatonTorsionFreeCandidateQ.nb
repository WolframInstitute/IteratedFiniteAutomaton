Notebook[{

Cell[CellGroupData[{
Cell["AutomatonTorsionFreeCandidateQ", "ObjectName",
 CellID->519227778,ExpressionUUID->"ca4428a0-0f74-444a-a63b-aebff177427e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f94154df-a1f9-4558-83dd-89bf2dab2f64"],
 Cell[BoxData[
  RowBox[{"AutomatonTorsionFreeCandidateQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["wordLength", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5c9a6e8f-9e83-428c-9bf3-41aeec9023f0"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "c42a07a9-4bc1-4b16-a013-992015b91a49"],
 " if some word of length at most ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "28cb5674-287c-4270-aa96-9ff1fcd0aec6"],
 " acts nontrivially at the deepest of ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "5f8b7298-7e4c-4e62-954c-e6c9d1b8f431"],
 " and no word's order has stopped growing there."
}], "Usage",
 CellID->384375930,ExpressionUUID->"ea6d0e0e-69dc-45bd-b8de-1dd26ba81b53"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "82edf775-056c-40a0-b0bf-3e533f2cd9f4"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "f2c7abee-15c0-4fef-958c-e297ce6a3a84"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "241499d0-63bc-40f2-b126-fae65eb16d84"],
 "."
}], "Notes",
 CellID->896471049,ExpressionUUID->"9a708f98-f537-4e7c-9a33-c718278def06"],

Cell["\<\
The condition is necessary but not sufficient for torsion-freeness: orders \
can plateau and later resume, as they do for the lamplighter group.\
\>", "Notes",
 CellID->879832590,ExpressionUUID->"75defe75-d1a9-423a-8413-16eb75575483"],

Cell[TextData[{
 "It is a filter, not a proof \[LongDash] a ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "beb7d1d2-e5b0-48cd-bdaa-afba57b59f8f"],
 " refutes torsion-freeness, while a ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "33956eeb-614a-46c5-a41d-61ceb963456b"],
 " only means the candidate survives to that depth."
}], "Notes",
 CellID->228730722,ExpressionUUID->"bf24baa9-d4fb-4c0b-acb4-ed2aa3a55d79"],

Cell[TextData[{
 "Only the last two entries of ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "ca0693f8-f23a-44d4-841a-f2e65116e42f"],
 " decide the answer, so a pair such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"5", ",", "7"}], "}"}]], "InlineFormula",ExpressionUUID->
  "51595ecf-926f-4d63-8af0-f6f3f7995367"],
 " is the usual argument."
}], "Notes",
 CellID->401551763,ExpressionUUID->"bf57d8c5-f054-4b6c-a563-f50937bfa4ab"]
}, Open  ]],

