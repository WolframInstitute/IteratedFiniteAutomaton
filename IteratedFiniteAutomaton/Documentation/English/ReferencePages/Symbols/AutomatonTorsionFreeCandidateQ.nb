Notebook[{

Cell[CellGroupData[{
Cell["AutomatonTorsionFreeCandidateQ", "ObjectName",
 CellID->221185750,ExpressionUUID->"efdf8fe0-2199-4ca4-bd3e-5cb6064064bf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4d66ae12-79a3-43f3-927f-0f2fb2774949"],
 Cell[BoxData[
  RowBox[{"AutomatonTorsionFreeCandidateQ", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["wordLength", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3b74cf19-b75b-40f8-bb34-7b4dac3b6d3f"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "d7625173-313a-4ff2-82c2-adb3027ae9f0"],
 " if some word of length at most ",
 Cell[BoxData[
  StyleBox["wordLength", "TI"]], "InlineFormula",ExpressionUUID->
  "b4b37d62-ec8b-4cf3-8ff6-9f4234de42ca"],
 " acts nontrivially at the deepest of ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "ce5be321-03fb-4491-8fd2-6022f05128d4"],
 " and no word's order has stopped growing there."
}], "Usage",
 CellID->640147732,ExpressionUUID->"3db72f17-709f-4dcb-907e-814d7c43fe5b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "2488398a-e1a7-4f5b-863f-c792969ff8b3"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "08298c1b-116e-49b1-9daf-0b6940002a19"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "d1fe4b46-ba83-4a68-8388-a1ccf7376491"],
 "."
}], "Notes",
 CellID->482933638,ExpressionUUID->"bf5739e0-2f14-4d35-aa6d-0ce2e0809957"],

Cell["\<\
The condition is necessary but not sufficient for torsion-freeness: orders \
can plateau and later resume, as they do for the lamplighter group.\
\>", "Notes",
 CellID->878297491,ExpressionUUID->"b71e59bf-9a56-4d58-93db-848c315cbeb2"],

Cell[TextData[{
 "It is a filter, not a proof \[LongDash] a ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "2e0c94df-1727-4754-963a-d94791549d6c"],
 " refutes torsion-freeness, while a ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "43c05da1-8393-46ae-99ee-48a31cd7f82d"],
 " only means the candidate survives to that depth."
}], "Notes",
 CellID->486626495,ExpressionUUID->"687edbee-aa83-4004-915e-6e8730af38b3"],

Cell[TextData[{
 "Only the last two entries of ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "2fb134ee-eda5-4595-b5bc-c8f59629a8c6"],
 " decide the answer, so a pair such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"5", ",", "7"}], "}"}]], "InlineFormula",ExpressionUUID->
  "27e034c5-b95a-49dc-8f80-746843cc0380"],
 " is the usual argument."
}], "Notes",
 CellID->689393255,ExpressionUUID->"a5fe9a9d-64f8-4739-9f50-73451f317674"]
}, Open  ]],

