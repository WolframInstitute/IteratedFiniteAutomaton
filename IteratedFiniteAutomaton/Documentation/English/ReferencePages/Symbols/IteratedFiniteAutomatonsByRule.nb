  StyleBox["rules", "TI"]], "InlineFormula",ExpressionUUID->
  "be34de0f-7788-4261-9902-fc021b5eaced"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4591d604-262f-469f-a23f-7adbf05ce602"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonsByRule", "[", 
