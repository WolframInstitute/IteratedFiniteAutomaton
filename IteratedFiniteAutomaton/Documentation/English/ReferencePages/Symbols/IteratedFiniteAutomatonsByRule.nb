Cell[TextData[{
 "The plot for a code is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArrayPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/ArrayPlot"], "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomaton", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["rule", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["s", "TI"], ",", 
          StyleBox["k", "TI"]}], "}"}]}], "}"}], ",", 
      StyleBox["init", "TI"], ",", 
      StyleBox["t", "TI"]}], "]"}], ",", 
    RowBox[{
     ButtonBox["ColorRules",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/ColorRules"], "\[Rule]", 
     RowBox[{"IteratedFiniteAutomatonColors", "[", 
      StyleBox["k", "TI"], "]"}]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e50d9f3a-ede6-45f0-9383-8817f382f18b"],
 "."
}], "Notes",
 CellID->488890987,ExpressionUUID->"8385d1e9-3c86-490f-a4cc-c93cc0ae1abb"],

Cell[TextData[{
 "All the codes in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",ExpressionUUID->
  "1b77679a-c791-485d-80f0-4d3c8badb54b"],
 " are read at the same shape ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["k", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "bd7c1712-ef0c-444b-8625-b451428ce1e5"],
 "; ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomatonSample",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomatonSample"]], "InlineFormula",ExpressionUUID->
  "711f2c82-3d0b-497c-a224-6213ee5a9704"],
 " supplies an even sweep of them."
}], "Notes",
 CellID->213808598,ExpressionUUID->"53ac7c5d-1ab9-43a1-b2da-fb9853a29041"],

