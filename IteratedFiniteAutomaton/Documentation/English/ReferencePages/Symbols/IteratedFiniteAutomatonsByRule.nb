Cell[TextData[{
 "The plot for a code is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArrayPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/ArrayPlot"], "[", 
   RowBox[{
    RowBox[{"IteratedFiniteAutomaton", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["rule", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["s", "TI"], ",", 
          StyleBox["k", "TI"]}], "}"}]}], "}"}], ",", 
      StyleBox["init", "TI"], ",", 
      StyleBox["t", "TI"]}], "]"}], ",", 
    RowBox[{
     ButtonBox["ColorRules",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/ColorRules"], "\[Rule]", 
     RowBox[{"IteratedFiniteAutomatonColors", "[", 
      StyleBox["k", "TI"], "]"}]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9110ebbe-5aa5-434f-87f2-d907181adc8b"],
 "."
}], "Notes",
 CellID->367468525,ExpressionUUID->"ca010d6a-cbad-4c36-8895-70bafe028e15"],

Cell[TextData[{
 "All the codes in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",ExpressionUUID->
  "4cf94ca6-681a-46dc-a8a7-381fc41fe5e8"],
 " are read at the same shape ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["k", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a5631bd3-47e5-4adb-a2fa-4301804de1da"],
