   RowBox[{"Length", "/@", 
    RowBox[{"ConnectedComponents", "[", 
     RowBox[{"UndirectedGraph", "[", 
      RowBox[{"AutomatonBoundaryGraph", "[", 
       RowBox[{"addingMachine", ",", "1", ",", "level"}], "]"}], "]"}], 
     "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"level", ",", "1", ",", "5"}], "}"}]}], "]"}]], "Input",
