Cell[CellGroupData[{
Cell["AutomatonBoundaryGraph", "ObjectName",
 CellID->896836103,ExpressionUUID->"9cec6baf-4059-43e5-92d3-897359720937"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ad7af8e-cef3-4722-866a-ba01064053d6"],
 Cell[BoxData[
  RowBox[{"AutomatonBoundaryGraph", "[", 
   StyleBox["automaton", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5fe147f7-c06f-47ad-b3ae-3e4d0c1b86ff"],
 " \[LineSeparator]",
 "gives the permutation of the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "21d47f80-97bb-43a9-8b40-c3c4334a5881"],
 " vertices at depth ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "366a65e8-dc9b-42a3-b6d5-2303ca2c1324"],
 " induced by the state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "b04feb7a-055e-41a5-b039-4b0f52d2feb0"],
 ", drawn as its functional graph."
}], "Usage",
 CellID->860785190,ExpressionUUID->"521580bb-5e4a-46a4-a6b4-fafe2cc0a7ec"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "8cbb1bc7-c732-4faa-9aee-969a217c8c01"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "2f7829fb-efdb-4c51-b188-56b5e9809c44"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "cc96a1e6-c929-4444-8152-04981cbfa58e"],
 "."
}], "Notes",
 CellID->841013162,ExpressionUUID->"693da823-810b-4f51-b5c7-bef81f1bd40a"],

Cell[TextData[{
 "Vertices are 1, \[Ellipsis], ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "42a0dce1-a894-434a-a7de-c5d5e579eeb0"],
 ", and the one edge leaving ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "ab661341-695f-4a8a-b8b5-29611b635f95"],
 " goes to the image of ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "eeecc8d5-3159-4c35-8aa8-bf510feaace2"],
 " under ",
 Cell[BoxData[
  ButtonBox["AutomatonLevelPermutations",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonLevelPermutations"]], "InlineFormula",ExpressionUUID->
  "09ce0ade-19a4-4c0e-8a5d-fa633663356d"],
 "; every vertex has out-degree 1, so the graph has as many edges as vertices."
}], "Notes",
 CellID->555265870,ExpressionUUID->"3a1d0320-44ac-4950-8684-c3b46c4f8fd3"],

Cell[TextData[{
 "The connected components are the cycles of that permutation, and the least \
common multiple of their lengths is the order of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "73427164-ef4d-4089-b21d-42f8461dcb97"],
 " in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "719d44cf-5b12-4243-aeb0-77a976d6e604"],
 "."
}], "Notes",
 CellID->749442835,ExpressionUUID->"3c34a578-ef82-4d44-955d-42cc16c61a5f"],

Cell[TextData[{
 "A state acting trivially at ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "c401c97b-6063-4138-aa8f-6039ee11cea4"],
 " gives ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "92f09acf-4367-4536-870c-9a9384a30cb9"],
 " self-loops."
}], "Notes",
 CellID->577000029,ExpressionUUID->"07eda81e-7eed-4bdf-8dbd-0332ddf3b668"]
}, Open  ]],

