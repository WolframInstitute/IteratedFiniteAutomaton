Cell[CellGroupData[{
Cell["AutomatonBoundaryGraph", "ObjectName",
 CellID->525931700,ExpressionUUID->"18af1847-6811-4813-9693-c870ab590372"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"14c0e8b9-9462-4dc1-91ac-38862fda2e23"],
 Cell[BoxData[
  RowBox[{"AutomatonBoundaryGraph", "[", 
   StyleBox["automaton", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9f2f6b22-86a8-47d4-9067-0584b0bd9302"],
 " \[LineSeparator]",
 "gives the permutation of the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "851c263c-56e2-4c5d-bc62-3006c7f969d9"],
 " vertices at depth ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "913bdc67-e24c-4e0f-8e9c-0bc7caa27b3a"],
 " induced by the state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "cc2189e3-1395-4d08-a4be-8c1904d4bbea"],
 ", drawn as its functional graph."
}], "Usage",
 CellID->236684216,ExpressionUUID->"0016bf6e-5118-441c-86eb-ec597f02b710"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "a2e0ab1c-ba22-4745-a5d3-99f5563e8b9c"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "1a859416-f92c-4e0e-9a37-d98a7fbb0e65"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c8be9c9b-b546-4dad-a12e-f49b8f98c402"],
 "."
}], "Notes",
 CellID->927851304,ExpressionUUID->"47a29fe1-490a-43ae-9555-ca52fbfeb7cb"],

Cell[TextData[{
 "Vertices are 1, \[Ellipsis], ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "222ae494-6261-43d8-ae18-d2cb28e7d26c"],
 ", and the one edge leaving ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "7a756e81-21f2-4502-a497-56dd37b54d6e"],
 " goes to the image of ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "e68647f7-a791-4d15-9819-f9aab317a0ae"],
 " under ",
 Cell[BoxData[
  ButtonBox["AutomatonLevelPermutations",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonLevelPermutations"]], "InlineFormula",ExpressionUUID->
  "ce387368-b019-4f94-9193-040d64d4a7c3"],
 "; every vertex has out-degree 1, so the graph has as many edges as vertices."
}], "Notes",
 CellID->473884395,ExpressionUUID->"4da91b0c-8670-4729-8b83-cb0f505dccb1"],

Cell[TextData[{
 "The connected components are the cycles of that permutation, and the least \
common multiple of their lengths is the order of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "7f728f29-9dd8-4540-ace1-2125cc027f3f"],
 " in ",
 Cell[BoxData[
  RowBox[{"Aut", "(", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["level", "TI"]], ")"}]], "InlineFormula",ExpressionUUID->
  "c300c822-eb2b-4b8e-9303-c34bedc6dc64"],
 "."
}], "Notes",
 CellID->611096719,ExpressionUUID->"3d1f634e-8268-458d-bc06-814671b617f3"],

Cell[TextData[{
 "A state acting trivially at ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "f8dd320a-9272-49ea-874f-655dd644d467"],
 " gives ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["level", "TI"]]], "InlineFormula",ExpressionUUID->
  "b534b856-e42a-4032-98f0-694c6c16de94"],
 " self-loops."
}], "Notes",
 CellID->298173461,ExpressionUUID->"11a31d58-a649-4cc2-b678-561cfdeece71"]
}, Open  ]],

