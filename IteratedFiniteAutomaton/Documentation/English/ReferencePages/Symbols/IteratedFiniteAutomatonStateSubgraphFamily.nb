Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateSubgraphFamily", "ObjectName",
 CellID->948694767,ExpressionUUID->"38448d7d-ff4d-4143-8ba6-99b159daf657"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"071d792b-17ce-4b87-a2c4-6f0203e4e795"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateSubgraphFamily", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["s0", "TI"], ",", 
   StyleBox["n", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "608a3fd1-b7d6-40fb-a33f-42e70552ea2f"],
 " \[LineSeparator]",
 "gives the family of exercised sub-digraphs over all ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "7af0b90c-f14f-45f8-aafd-286550b0ce9e"],
 " tapes of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "fd07bda9-73f7-407e-8b81-5585388ae132"],
 ", as an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "65c275be-dc12-4af0-8f13-77839cfc7f97"],
 " sending each traversed edge set to the tapes that traverse it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3a07bd10-05d3-4e6b-a861-4636a9c3304d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateSubgraphFamily", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["s0", "TI"], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a9874380-d0d8-4020-9429-d7eef46a40ce"],
 " \[LineSeparator]",
 "uses one step."
}], "Usage",
 CellID->258759298,ExpressionUUID->"418c89b8-0bb2-4a04-82b0-c46570c38063"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["Length",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Length"]], "InlineFormula",ExpressionUUID->
  "455866e9-9538-4a3c-a8e3-403222776edb"],
 " of the result counts the distinct subgraphs, and ",
 Cell[BoxData[
  RowBox[{"Union", "@@", 
   RowBox[{"Keys", "[", 
    StyleBox["family", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "3ac20f03-aa8b-448a-a707-f8f11ce5bb0e"],
 " gives the edges some tape reaches."
}], "Notes",
 CellID->821513215,ExpressionUUID->"174b5fa9-5cdd-4a59-aac1-a33598872904"],

Cell[TextData[{
 "The family is keyed by edge set rather than by ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "1ed3cfe2-aa86-4d90-af3f-a699e370aecf"],
 ": two graphs with the same edges need not be the same expression, while the \
sorted edge list is canonical."
}], "Notes",
 CellID->152414285,ExpressionUUID->"c28c0302-9049-4b4a-b37d-db57688529d1"],

Cell["\<\
At one step the family depends only on the transition function, since the \
outputs decorate edges the transitions have already chosen.\
\>", "Notes",
 CellID->680443256,ExpressionUUID->"a0799740-8a96-48c5-afbc-78e2edc7916f"]
}, Open  ]],

