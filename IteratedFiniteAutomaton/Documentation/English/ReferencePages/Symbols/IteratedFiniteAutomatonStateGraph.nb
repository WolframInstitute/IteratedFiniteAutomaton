Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateGraph", "ObjectName",
 CellID->689208504,ExpressionUUID->"3212192e-298a-4827-b9e7-b920d12b4e76"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee2395e9-5db0-43d7-82ff-c8c0e2b31252"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["k", "TI"]}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"b4628862-ddb0-4615-a77a-b894d106009f"],
 " \[LineSeparator]",
 "gives the state transition diagram of the coded automaton as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "5306352b-4818-409f-838b-c395c9f4161e"],
 " with edge tags ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "c123508f-e275-47d5-b9d4-9801fa02d6e4"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bfcbd359-a35d-4447-9c92-246342df3a07"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   StyleBox["rule", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "15e1fe72-f2f3-4e8d-b24a-7742a71989b0"],
 " \[LineSeparator]",
 "accepts an explicit list of transitions."
}], "Usage",
 CellID->997466462,ExpressionUUID->"ec493d65-da0e-47d9-adcb-a06eb362d226"],

Cell[TextData[{
 "Vertices are the states 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "d35964f1-1fd8-40a0-a224-13aebae6435f"],
 "; each transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "b9ae4168-4c02-4439-99d8-5cc8e2f3c908"],
 " contributes the edge ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c6bfd009-de7f-4257-82e4-93173cebbe9e"],
 "."
}], "Notes",
 CellID->273171701,ExpressionUUID->"ff79dcd8-d963-4640-a054-0d92de9e5bcf"],

Cell[TextData[{
 "Edge labels show the tags ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "4d34c4b0-9eaa-4795-a3fd-7d4b83fae17d"],
 "; the result is the Moore diagram of the automaton."
}], "Notes",
 CellID->966746477,ExpressionUUID->"86320948-108c-4a93-9da0-66bdd6c5bb5e"]
}, Open  ]],

