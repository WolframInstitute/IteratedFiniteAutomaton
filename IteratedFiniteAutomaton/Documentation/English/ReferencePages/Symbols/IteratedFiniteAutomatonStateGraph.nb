Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5ac153e0-a597-41a3-a6d3-6de9ea082897"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["k", "TI"]}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"d7616a5e-295f-4455-aec4-bb3c7b874d1a"],
 " \[LineSeparator]",
 "gives the state transition diagram of the coded automaton as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "dc14cda4-f1e7-4cc8-80dd-d3f0671e9698"],
 " with edge tags ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "f3c71951-65a8-4f23-a534-8bf48c64a072"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0b18cc3b-5b6b-4532-9046-b15ebe045568"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   StyleBox["rule", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3efe9587-fdf0-43b5-8c0d-712148b45c62"],
 " \[LineSeparator]",
 "accepts an explicit list of transitions."
}], "Usage",
 CellID->906925661,ExpressionUUID->"b5a2f2b0-b3b0-48f1-b650-1a9ebafe1bc9"],

Cell[TextData[{
 "Vertices are the states 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "8ee798be-b2c4-40f6-ba75-9efa632ed5b2"],
 "; each transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "7cea28ee-8c89-46ba-95a3-6f1ddf1cb620"],
 " contributes the edge ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "776d4453-54ab-467c-8d44-248f50eedead"],
 "."
}], "Notes",
 CellID->823781554,ExpressionUUID->"e59d8c8d-683a-4a9b-8fe8-b9a54e1d4765"],

Cell[TextData[{
 "Edge labels show the tags ",
