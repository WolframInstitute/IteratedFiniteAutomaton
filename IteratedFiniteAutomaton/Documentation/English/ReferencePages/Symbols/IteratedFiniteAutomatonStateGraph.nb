  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "d28273f2-0e1c-48ab-999a-1e4aca7298d2"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c65f77eb-6295-429b-b658-bb6c689af1ee"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   StyleBox["rule", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "82bd6c1f-f14d-421d-8376-2476e269887c"],
 " \[LineSeparator]",
 "accepts an explicit list of transitions."
}], "Usage",
 CellID->123386570,ExpressionUUID->"3ed13778-d827-4bbb-8e24-61a544e95a04"],

Cell[TextData[{
 "Vertices are the states 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "1b6844ef-5122-4fca-95ab-c4300c02ac4e"],
