 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "bf95e255-de93-4fc3-86cf-7532566cf2cd"],
 " contributes the edge ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0c4d4196-fbdb-42ec-9dc4-c16d75ba1492"],
 "."
}], "Notes",
 CellID->897558489,ExpressionUUID->"4a1be07f-23b5-4df8-b649-1274616d75bd"],

Cell[TextData[{
 "Edge labels show the tags ",
 Cell[BoxData[
  RowBox[{
