 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
