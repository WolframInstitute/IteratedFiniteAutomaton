Cell["IteratedFiniteAutomatonStateGraph", "ObjectName",
 CellID->254725449,ExpressionUUID->"048e91cb-8a37-4cf6-a596-60585ea09bf2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"958a15f1-508c-4a91-a132-6ee7a8bf50c5"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["code", "TI"], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["s", "TI"], ",", 
       StyleBox["k", "TI"]}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"b82ff7ff-323c-4752-999c-cd9e1b416a59"],
 " \[LineSeparator]",
 "gives the state transition diagram of the coded automaton as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "66e1ea72-1ad0-4486-a84e-2a552c1100ec"],
 " with edge tags ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "d1ea50a4-b6ce-4e4d-8fdc-133509d3f29b"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c7b2f84e-14d0-4eb1-a410-333256337192"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateGraph", "[", 
   StyleBox["rule", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dfc1c3ee-f7fd-48a7-adf4-2cf980e3e896"],
 " \[LineSeparator]",
 "accepts an explicit list of transitions."
}], "Usage",
 CellID->283366762,ExpressionUUID->"f880e64a-d309-46b7-8f5f-6972ae8bfa23"],

Cell[TextData[{
 "Vertices are the states 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "5cce94ff-abf9-4f5f-afc9-e8144ca5bd0b"],
 "; each transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "37280d0d-bffb-43e3-94b9-23fc853b5e9f"],
 " contributes the edge ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f350652a-0a91-42b6-9501-145b5c72a2b3"],
 "."
}], "Notes",
 CellID->239226333,ExpressionUUID->"74ec254a-956b-48c4-8b15-fa0991d775e5"],

Cell[TextData[{
 "Edge labels show the tags ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[Rule]", 
   StyleBox["o", "TI"]}]], "InlineFormula",ExpressionUUID->
  "325b53e2-fc8d-43cc-9bf1-64f33341c58f"],
