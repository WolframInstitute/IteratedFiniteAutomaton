Cell[TextData[{
 "The diagram is deterministic and complete: every state has exactly one \
outgoing edge per symbol, so a coded automaton always gives ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "ab991a12-eed9-4574-a50f-abf513406a7b"],
