Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateTransitions", "ObjectName",
 CellID->604675999,ExpressionUUID->"9216a323-515e-4f48-8914-e9da62fd4952"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"478b38d7-5d8b-48cc-ac2a-2e1e0b618876"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8c9cacc0-975d-4b7d-b151-6e3c5657b308"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton recording at each cell the transition \
",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3de603e6-c231-4a24-83bd-a928fc70fcab"],
 " that produced it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"72e89d6a-b19d-4af7-b92b-7bb9d5c83b1b"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9723abbe-df60-4a45-b289-aa58767f12f3"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "cbd711f1-5db2-42ba-bb70-a3b191b6af42"],
 "."
}], "Usage",
 CellID->854080922,ExpressionUUID->"584b42ca-52b4-443d-978e-36562fc6b042"],

Cell[TextData[{
 "Each cell of the evolution is ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "64a6a152-28df-4894-a452-426393d3fd3c"],
 ", recording that the automaton read ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "70c62003-2b89-4741-b92f-7f42bdfb04c3"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "5e333dbf-1671-4e4d-8850-31519664ce3c"],
 ", wrote ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "08fe2cbb-295a-4d7a-9ebf-ce9872827e6d"],
 " and moved to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "30ab225d-ee94-4da2-93ed-c7c3fb8d8b5f"],
 "."
}], "Notes",
 CellID->569087420,ExpressionUUID->"0c870350-344f-486e-9bdc-afde0b76b5af"],

Cell[TextData[{
 "In the initial row every cell ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->
  "918a7463-13fe-41fd-9869-bfc418cd7b7c"],
 " is wrapped as ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    RowBox[{"0", "\[Rule]", 
     StyleBox["v", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "60b70e82-23a6-4382-980c-83ea01d0dc4d"],
 "."
}], "Notes",
 CellID->502263853,ExpressionUUID->"b65093a1-899f-4c9d-84c7-1827b1640496"],

Cell[TextData[{
 "The written symbols at parts ",
 Cell[BoxData[
  RowBox[{"[", "[", "All", ",", "All", ",", "3", ",", "2", "]", "]"}]], 
  "InlineFormula",ExpressionUUID->"929d3ff3-6353-4e20-95d8-020d5dcfed1e"],
 " reproduce the evolution given by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "2b6d8138-f460-48c5-9b94-599352d92b7f"],
 "."
}], "Notes",
 CellID->564131686,ExpressionUUID->"51460dc1-3a29-4881-a7bd-8d56a410dd76"]
}, Open  ]],

