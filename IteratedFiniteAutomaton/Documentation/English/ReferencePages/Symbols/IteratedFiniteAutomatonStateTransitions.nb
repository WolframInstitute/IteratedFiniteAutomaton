Cell["Track the state transitions of the adding machine:", "ExampleText",
 CellID->768571855,ExpressionUUID->"c7650331-44b2-44bb-bb41-7c9eca9addc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->592821927,ExpressionUUID->"32fec253-5b55-4a64-ac31-7efcebc080ed"],

Cell[BoxData[
 RowBox[{"transitions", "=", 
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->915601367,ExpressionUUID->"17dd392b-02ab-41d7-befa-21478c023671"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->742080158,ExpressionUUID->"416025f8-42a7-4a79-b668-51bb39c0a73d"],

