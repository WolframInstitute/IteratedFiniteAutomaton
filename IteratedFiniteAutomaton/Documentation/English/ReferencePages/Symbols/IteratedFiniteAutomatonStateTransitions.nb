Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateTransitions", "ObjectName",
 CellID->929146135,ExpressionUUID->"1d3ccad3-e31d-4c50-b533-4a12a350211f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"792a1134-5d38-4946-beb3-138ca7a55469"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "41f6c19b-41f1-4da2-a2a1-a95eca14c869"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton recording at each cell the transition \
",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8dd642d7-ef37-4a95-a95c-33972120c014"],
 " that produced it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f5ff6ed1-7283-43c3-aa5e-4a06266f9969"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7c4b80a1-9a4d-486a-b992-8faa0ac45e74"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "c1fc4685-b0e8-4190-8f80-65958b85e179"],
 "."
}], "Usage",
 CellID->567703057,ExpressionUUID->"e2148bbc-925d-4832-a169-d93605a88ad3"],

Cell[TextData[{
 "Each cell of the evolution is ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "11d22278-f96c-4511-8ff1-bfe90f491713"],
 ", recording that the automaton read ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "bf30f25d-e62a-40ac-ad26-bd627aebc872"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "abd9796c-0e6a-47d0-9a34-13b4dc552845"],
 ", wrote ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "1b3d2923-f1ab-4ee8-b677-bed62212f2c9"],
 " and moved to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "3221a39f-4fcc-4d73-a158-c6967c591831"],
 "."
}], "Notes",
 CellID->126380349,ExpressionUUID->"bbb6c6dd-7fa6-4ce0-b9f4-58ad9fc0c607"],

Cell[TextData[{
 "In the initial row every cell ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->
  "6315d5b1-a250-4b2d-a512-6152de12c661"],
 " is wrapped as ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    RowBox[{"0", "\[Rule]", 
     StyleBox["v", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b41eee1f-0782-4e4a-94d6-a08a025da2c1"],
 "."
}], "Notes",
 CellID->115332927,ExpressionUUID->"ce5539f7-9e9e-474c-b566-184a41b3fe2f"],

Cell[TextData[{
 "The written symbols at parts ",
 Cell[BoxData[
  RowBox[{"[", "[", "All", ",", "All", ",", "3", ",", "2", "]", "]"}]], 
  "InlineFormula",ExpressionUUID->"1d5afe05-2cec-488d-93a5-579ebc89aa02"],
 " reproduce the evolution given by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "d5d9a0a3-7612-4007-bd61-dcab5f077331"],
 "."
}], "Notes",
 CellID->358913731,ExpressionUUID->"d1f4aa63-53e7-4426-9c65-c7445bacffc3"]
}, Open  ]],

