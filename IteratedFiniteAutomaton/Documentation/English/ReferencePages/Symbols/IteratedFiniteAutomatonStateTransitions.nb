Cell["Track the state transitions of the adding machine:", "ExampleText",
 CellID->232442855,ExpressionUUID->"8b13c62f-85d8-4452-84e6-4b8478ca24bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->995058205,ExpressionUUID->"851184bc-673a-4058-b531-fc1edb627e23"],

Cell[BoxData[
 RowBox[{"transitions", "=", 
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->613641612,ExpressionUUID->"fe077ccc-9a2f-4157-9370-4bd34db0d8e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->921198134,ExpressionUUID->"ea505d52-c3c5-4ee9-a395-91e8d3e7f879"],

