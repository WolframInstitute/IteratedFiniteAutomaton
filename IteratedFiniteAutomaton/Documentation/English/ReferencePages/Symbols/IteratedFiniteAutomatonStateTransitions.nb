Cell["Track the state transitions of the adding machine:", "ExampleText",
 CellID->762843950,ExpressionUUID->"07878c11-b07e-4ede-bd98-fd769e7812c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->149917763,ExpressionUUID->"dd883957-48ac-4080-a9ea-8680a4161cbe"],

Cell[BoxData[
 RowBox[{"transitions", "=", 
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->971308019,ExpressionUUID->"3a7403dc-8263-4e06-963f-0fa7b6335fc8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->474044885,ExpressionUUID->"2ea77655-55e2-43c8-aba4-3a9a2adf7c2c"],

