Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateTransitions", "ObjectName",
 CellID->742209372,ExpressionUUID->"fe85aad0-3c2a-442e-bd69-89cd1d92e6d0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"483cbec3-3e93-44c6-a40f-2787b5321e49"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "13c1fd3f-1bfc-4364-a8f5-386095c0222c"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton recording at each cell the transition \
",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d8d6c426-0864-4dd0-ab93-fe0ea6dea4c9"],
 " that produced it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"52f14eb2-e988-4d23-bd32-c02c6eb476cb"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9f49ed5c-fea3-475d-b7ca-7c731b745738"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "e800ce0d-6cbf-4eb4-b1e3-ae0ba15ad77b"],
 "."
}], "Usage",
 CellID->780638359,ExpressionUUID->"a9fe3c9b-118d-4a30-9b72-56db48748149"],

Cell[TextData[{
 "Each cell of the evolution is ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f38c82ed-e049-4356-9c2f-c0b768ec94f0"],
 ", recording that the automaton read ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c6153f13-990c-4c3b-8eb8-ef7e33cf2277"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "c339ed9a-b395-4df5-aa79-0f81cfad264e"],
 ", wrote ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "e4376e6d-c3d6-4651-914a-14d2dc123b05"],
 " and moved to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "bb516f85-22b1-474a-83c2-a2c115b1cd34"],
 "."
}], "Notes",
 CellID->577864772,ExpressionUUID->"e0d1c463-7a3e-426c-80fe-690fd174b83f"],

Cell[TextData[{
 "In the initial row every cell ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->
  "2fb630ad-d5d9-49ae-980a-33171eaa7599"],
 " is wrapped as ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    RowBox[{"0", "\[Rule]", 
     StyleBox["v", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b6a4b696-3fab-4c33-a79e-44de05782b35"],
 "."
}], "Notes",
 CellID->430449637,ExpressionUUID->"6820c33a-a0e1-40a0-8052-b9a3b79fca8d"],

Cell[TextData[{
 "The written symbols at parts ",
 Cell[BoxData[
  RowBox[{"[", "[", "All", ",", "All", ",", "3", ",", "2", "]", "]"}]], 
  "InlineFormula",ExpressionUUID->"4a0f4634-ca5b-4b24-b867-7d0b0efb1b05"],
 " reproduce the evolution given by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "7ca4d436-a772-4b0c-8752-785040c6d4fa"],
 "."
}], "Notes",
 CellID->986781391,ExpressionUUID->"459d97f4-cc57-4c42-82a5-47e955b18d8b"]
}, Open  ]],

