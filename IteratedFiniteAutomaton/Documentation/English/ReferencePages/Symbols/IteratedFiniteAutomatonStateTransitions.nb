Cell["Track the state transitions of the adding machine:", "ExampleText",
 CellID->108188053,ExpressionUUID->"3914122a-b491-4ed4-8b2a-a134c145c007"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->412268844,ExpressionUUID->"bbb882a1-7990-471d-8f8e-c8557320df4f"],

Cell[BoxData[
 RowBox[{"transitions", "=", 
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->822943576,ExpressionUUID->"1a89153d-bfce-4efe-b0c6-fe6ee257eca4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"0", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "1", 
       RowBox[{"1", "\[Rule]", "0"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"1", "2", 
       RowBox[{"0", "\[Rule]", "1"}]},
      "DirectedEdge"], ",", 
     TemplateBox[{"2", "2", 
       RowBox[{"1", "\[Rule]", "1"}]},
      "DirectedEdge"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->759200385,ExpressionUUID->"82f3ec3b-4cc6-4227-9f8b-ce44bf721dcd"],

Cell["The written symbols reproduce the evolution:", "ExampleText",
 CellID->301931912,ExpressionUUID->"3de0e1da-cf1d-4225-9c31-594cc86dbdc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transitions", "\[LeftDoubleBracket]", 
   RowBox[{"All", ",", "All", ",", "3", ",", "2"}], "\[RightDoubleBracket]"}],
   "===", 
  RowBox[{"IteratedFiniteAutomaton", "[", 
   RowBox[{"addingMachine", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->613740535,ExpressionUUID->"5d0be5a5-00c4-441d-8db0-232b5da5b792"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]=",
 CellID->839304548,ExpressionUUID->"43071688-4188-4839-8c29-9e2068ff240a"]
}, Open  ]],

