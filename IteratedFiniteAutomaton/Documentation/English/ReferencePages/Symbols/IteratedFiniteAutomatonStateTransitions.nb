Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonStateTransitions", "ObjectName",
 CellID->489881940,ExpressionUUID->"a1243392-238c-4ee1-bbf6-9ece81ced42a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"75b1998e-1f07-4fc3-b072-0a2b1dcd8e25"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4afdfed1-8898-4c76-a097-6a6867d681db"],
 " \[LineSeparator]",
 "evolves the iterated finite automaton recording at each cell the transition \
",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "46ff4d08-072f-429f-8264-2717564af05b"],
 " that produced it.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ad62d90d-6737-4b64-b93a-3c2e8fce2fb4"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonStateTransitions", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "31fb44da-5621-462b-a968-0ea8bfe99772"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "93042671-d789-482c-906a-2b740e10ece3"],
 "."
}], "Usage",
 CellID->929972443,ExpressionUUID->"c2955c54-66bb-4308-b013-1ce4db085ff8"],

Cell[TextData[{
 "Each cell of the evolution is ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["f", "TI"], ",", 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["o", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "78180d5a-c880-4a64-bce8-dc0c5b290534"],
 ", recording that the automaton read ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "75a8a745-e805-4be8-bf83-4986fbca509e"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "db35d031-fb6a-44a0-b114-501bd50e7dab"],
 ", wrote ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "9eddf7ce-754f-4c0d-8ff9-a82df9c4f98c"],
 " and moved to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "957e8b6a-8989-46d5-b1d4-7fbec292b313"],
 "."
}], "Notes",
 CellID->609970389,ExpressionUUID->"3fefedbd-30ad-47b2-b991-7c87d26bb4d1"],

Cell[TextData[{
 "In the initial row every cell ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->
  "b49e2feb-ce8b-471e-82cb-7af53315da64"],
 " is wrapped as ",
 Cell[BoxData[
  RowBox[{"DirectedEdge", "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["s", "TI"], "0"], ",", 
    RowBox[{"0", "\[Rule]", 
     StyleBox["v", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4df6b68c-52f2-4fdb-a357-3712e16808d6"],
 "."
}], "Notes",
 CellID->598952456,ExpressionUUID->"670f87d6-b91e-494f-b6ab-831ec342e729"],

Cell[TextData[{
 "The written symbols at parts ",
 Cell[BoxData[
  RowBox[{"[", "[", "All", ",", "All", ",", "3", ",", "2", "]", "]"}]], 
  "InlineFormula",ExpressionUUID->"77114be9-8712-4551-8c67-f1658f6a9db2"],
 " reproduce the evolution given by ",
 Cell[BoxData[
  ButtonBox["IteratedFiniteAutomaton",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
IteratedFiniteAutomaton"]], "InlineFormula",ExpressionUUID->
  "fb5e314b-2bbb-48ff-8bcd-17cc8a5344d4"],
 "."
}], "Notes",
 CellID->211261635,ExpressionUUID->"363b71f8-09b9-4b72-9728-a31707a82a5b"]
}, Open  ]],

