Notebook[{

Cell[CellGroupData[{
Cell["AutomatonAdderCascade", "ObjectName",
 CellID->621709035,ExpressionUUID->"317e78c5-42ad-4c0f-8b7d-ef4311cfaa58"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dd35e39e-216c-4d3b-af78-122b4ce9f4a1"],
 Cell[BoxData[
  RowBox[{"AutomatonAdderCascade", "[", 
   StyleBox["s", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "26372994-9365-420d-92cf-e76aeedadbe2"],
 " \[LineSeparator]",
 "gives the rule of the cascade of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "4463ccce-ca6d-487b-add8-e9e3e4fba528"],
 " binary odometers in series: each state advances the symbol it reads and \
passes the carry one state along, and the carry dies in the identity state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "1880ad1a-ed5a-4cd3-a74b-9a76f4ec20e4"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"665aa09d-ed4a-468b-a267-a5667dc9a159"],
 Cell[BoxData[
  RowBox[{"AutomatonAdderCascade", "[", 
   StyleBox["s", "TI"], ",", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "314ed7a9-022d-43b1-bc91-486d24da84dc"],
 " \[LineSeparator]",
 "uses ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "c0001844-6849-45b5-9ec3-0ef333aed2e8"],
 " symbols."
}], "Usage",
 CellID->766104346,ExpressionUUID->"640488e3-4d8f-4cf7-83cb-e53c6f888cce"],

Cell[TextData[{
 "State ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "5f156e08-caf7-461b-a73b-714eb4835b1f"],
 " is the odometer truncated at depth ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "d7de3ff9-33f4-4636-ad38-bea19692d487"],
 ", so it is finitary of that depth and has order ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], 
   RowBox[{
    StyleBox["s", "TI"], "-", 
    StyleBox["i", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "ee28e202-9086-4ec0-918c-c10746f02f07"],
 "."
}], "Notes",
 CellID->904636064,ExpressionUUID->"cbf723c0-9b0e-47e3-afe2-b048ad5f833b"],

Cell[TextData[{
 "The group is therefore finite: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[Equal]", "2"}]], "InlineFormula",ExpressionUUID->
  "79b6da0f-db0b-4644-93d0-e3dc8b94adb5"],
 " it is the whole automorphism group of the tree truncated at depth ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "f8b22c31-8980-493d-b80a-a9612a2bf103"],
 ", and in general the iterated wreath product of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "3cad4bdc-60ea-49a3-a182-7f1d65d42148"],
 " cyclic groups of order ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "8721fdbf-f22a-4b0c-ac65-3006ddd537b2"],
 "."
}], "Notes",
 CellID->790771817,ExpressionUUID->"c4940e0e-8572-4a45-8cd4-af71e77953c6"],

Cell[TextData[{
 "The family is a construction for the regime where the ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}], ")"}], 
   RowBox[{
    StyleBox["s", "TI"], " ", 
    StyleBox["k", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "67fa500f-794b-48d5-ab5d-a6f999856619"],
 " automata cannot be enumerated."
}], "Notes",
 CellID->859238563,ExpressionUUID->"fafd1402-6bc6-43ba-97c9-5c35fa0e4e20"]
}, Open  ]],

