Cell[CellGroupData[{
Cell["AutomatonGroupFingerprint", "ObjectName",
 CellID->294116482,ExpressionUUID->"ca436bdc-1878-4e46-bc3a-9b62adefcf42"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"326ffac0-f5f5-4b8c-8c45-23cf92659c1f"],
 Cell[BoxData[
  RowBox[{"AutomatonGroupFingerprint", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b8ce6b8d-d124-4ea7-a55d-6dae23f9b273"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Abelian\>\"", 
    ",", "\"\<BallGrowth\>\""}], "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"501a2b3f-8a60-499a-982d-8efcefccf31a"],
 " for the level quotient."
}], "Usage",
 CellID->452208765,ExpressionUUID->"9b29e28e-6766-4cdc-8397-a237a333149a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "f64de9d0-6b72-43d4-8731-c8a30407231d"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "1b575422-9856-463d-839d-dfaccf514ce1"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a9d26cc6-a28d-4eb8-8185-8a1147c82de8"],
 "."
}], "Notes",
 CellID->716668246,ExpressionUUID->"f5cb4ef7-33f1-4196-963f-e47e4ed5a8c6"],

Cell[TextData[{
 "\"BallGrowth\" counts the elements represented by words of length 1 to 4, \
as given by ",
 Cell[BoxData[
  ButtonBox["AutomatonElementCount",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonElementCount"]], "InlineFormula",ExpressionUUID->
  "b34a6e3b-16a0-4146-a60e-677ca45caaf3"],
 "."
}], "Notes",
 CellID->610434371,ExpressionUUID->"45f75aa1-6600-49bb-9426-4d57fb2d2fd0"],

Cell["\<\
Distinct fingerprints certify distinct groups; equal fingerprints do not \
certify an isomorphism.\
\>", "Notes",
 CellID->894415317,ExpressionUUID->"f0b24103-7b24-4f66-aa64-664ff0606e3e"]
}, Open  ]],

