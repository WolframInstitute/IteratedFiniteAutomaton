Cell[CellGroupData[{
Cell["AutomatonGroupFingerprint", "ObjectName",
 CellID->689735628,ExpressionUUID->"e3b3f404-d8b1-41be-ac5a-4496380e295d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"26fc5864-20cb-4741-b2d3-8f1df2aa4b29"],
 Cell[BoxData[
  RowBox[{"AutomatonGroupFingerprint", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dcfe1845-69f1-4fd4-9c79-21889b4926fd"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Code\>\"", ",", "\"\<Abelian\>\"", 
    ",", "\"\<BallGrowth\>\""}], "\[RightAssociation]"}]], "InlineFormula",
  ExpressionUUID->"83df6c27-e629-4ff3-a380-cec49b0d959e"],
 " for the level quotient."
}], "Usage",
 CellID->122292942,ExpressionUUID->"65167120-d6dc-453c-8307-ceb08b66b681"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "75ba072f-631c-4337-9297-68adcbd8f9d1"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "63dd142a-ab3a-414b-a13f-18d7f5ea0683"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "8a936962-5cbf-4556-bb6c-7a8a199d5029"],
 "."
}], "Notes",
 CellID->573740604,ExpressionUUID->"d51fc689-b177-4f34-a958-d6c5f52ee686"],

Cell[TextData[{
 "\"BallGrowth\" counts the elements represented by words of length 1 to 4, \
as given by ",
 Cell[BoxData[
  ButtonBox["AutomatonElementCount",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
AutomatonElementCount"]], "InlineFormula",ExpressionUUID->
  "367cd472-2f00-4ee3-8609-93087aaa64ac"],
 "."
}], "Notes",
 CellID->139208505,ExpressionUUID->"bf9995b3-e41c-4e7d-b3e3-c10a7b906d3c"],

Cell["\<\
Distinct fingerprints certify distinct groups; equal fingerprints do not \
certify an isomorphism.\
\>", "Notes",
 CellID->417231561,ExpressionUUID->"172da884-a78e-4c6e-97d4-4c7c6151fff0"]
}, Open  ]],

