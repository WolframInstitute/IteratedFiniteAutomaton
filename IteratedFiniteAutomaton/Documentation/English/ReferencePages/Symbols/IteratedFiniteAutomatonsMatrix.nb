  ButtonBox["ArrayPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayPlot"]], "InlineFormula",ExpressionUUID->
  "ade1fec3-7bcc-4d97-89bd-8126ff28dc53"],
 "s with one row per code in ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",ExpressionUUID->
  "73883686-0187-48d1-9517-9a6ce4acbf83"],
 " and one column per initial condition in ",
 Cell[BoxData[
  StyleBox["inits", "TI"]], "InlineFormula",ExpressionUUID->
  "bbe9abd8-6604-43e4-bf59-c35dfc9e1172"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"25e53b71-fa28-44fa-917f-4188e51dc198"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonsMatrix", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], ",", 
   StyleBox["rules", "TI"], ",", 
   StyleBox["inits", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7dd9e4d4-f7b3-4e22-af64-391344964281"],
 " \[LineSeparator]",
 "runs ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "81952f22-2d0b-449f-8899-298e444b2432"],
 " steps instead of ",
 Cell[BoxData[
  RowBox[{"Length", "[", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "df15350d-1378-4c2f-b8c4-7b7621d6d832"],
 "."
}], "Usage",
 CellID->633185404,ExpressionUUID->"df4e8063-c59f-40bc-9d13-0396569ba502"],

Cell[TextData[{
