Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aba791bd-cd0e-44b9-b587-96d6cf1db79c"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonsMatrix", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], ",", 
