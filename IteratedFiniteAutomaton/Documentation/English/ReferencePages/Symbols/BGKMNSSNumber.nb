Notebook[{

Cell[CellGroupData[{
Cell["BGKMNSSNumber", "ObjectName",
 CellID->607644820,ExpressionUUID->"abc75f60-da3d-450e-8ae1-169bf28ecdef"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"af9eabc1-6fd9-492c-9a7f-321b2cf55973"],
 Cell[BoxData[
  RowBox[{"BGKMNSSNumber", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e1140d25-a9a7-48ed-8d27-571aa9f485f0"],
 " \[LineSeparator]",
 "gives the number of a 3-state binary automaton in the classification of \
Bondarenko, Grigorchuk, Kravchenko, Muntyan, Nekrashevych, Savchuk and \
Sunic."
}], "Usage",
 CellID->515549009,ExpressionUUID->"c9d9a9e4-0b72-4b63-bf46-7ed42d25c081"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "f0215baa-92c0-46d4-9f36-4a137fb85cbd"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "3428f2f7-3df7-495c-ac01-b4feb59fffd9"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "911c7538-a05f-4ab3-8ecf-cc4a7d4c4ad7"],
 "."
}], "Notes",
 CellID->776616327,ExpressionUUID->"e37a9c52-4a7e-4be5-a048-493ba2371429"],

Cell[TextData[{
 "The numbering is the one of arXiv:0803.3555 Section 6, where state ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "fe6b51ab-1bf5-4c87-a3cc-480873a177f8"],
 " is written ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Sigma]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "1"}]]], "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "2"}]], ",", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "3"}]]}], ")"}]], "InlineFormula",ExpressionUUID->
  "026a1cdb-8d4c-4076-9958-8c4d151941f2"],
 "."
}], "Notes",
 CellID->104065084,ExpressionUUID->"bbb5084f-1f6f-4937-9e87-bb71b90d82dd"],

Cell["\<\
It is a bijection from the 5832 automata on three states and two symbols onto \
1, \[Ellipsis], 5832.\
\>", "Notes",
 CellID->950959361,ExpressionUUID->"bfc6027e-54b2-49ff-956f-98b0954e7f9e"],

Cell["\<\
Defined only for three states and two symbols; other shapes stay unevaluated.\
\
\>", "Notes",
 CellID->119770187,ExpressionUUID->"73bbc0d5-08f5-46cb-bb3c-f00485a75363"]
}, Open  ]],

