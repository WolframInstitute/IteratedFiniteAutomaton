Notebook[{

Cell[CellGroupData[{
Cell["BGKMNSSNumber", "ObjectName",
 CellID->373728182,ExpressionUUID->"c8542f49-f651-4a71-95f2-6935202ac97f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"375d29cf-acfc-4675-ad0d-1e28c89de40f"],
 Cell[BoxData[
  RowBox[{"BGKMNSSNumber", "[", 
   StyleBox["automaton", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f1a415cc-e18f-4730-87e1-1b42581e93a5"],
 " \[LineSeparator]",
 "gives the number of a 3-state binary automaton in the classification of \
Bondarenko, Grigorchuk, Kravchenko, Muntyan, Nekrashevych, Savchuk and \
Sunic."
}], "Usage",
 CellID->982557137,ExpressionUUID->"63e60150-56c6-4bac-85cb-e63aa1ccc834"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "31cecf5e-5160-472d-8116-d365167fd5b5"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "a9feda1a-d099-45c1-bea3-092efe5b9408"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "8e3e5655-3717-48d5-bdb2-bf371f0c2ade"],
 "."
}], "Notes",
 CellID->933524554,ExpressionUUID->"a2deb3fc-bf86-42d3-8dcf-5d3b38c7e700"],

Cell[TextData[{
 "The numbering is the one of arXiv:0803.3555 Section 6, where state ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "956bbb27-1dcd-4cfc-81ab-a17bbd59886c"],
 " is written ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Sigma]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "1"}]]], "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "2"}]], ",", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "3"}]]}], ")"}]], "InlineFormula",ExpressionUUID->
  "4add3297-856b-41d9-929c-ff34cdd5128a"],
 "."
}], "Notes",
 CellID->861898197,ExpressionUUID->"099f2414-592b-4ffe-9462-b123cd41bc7a"],

Cell["\<\
It is a bijection from the 5832 automata on three states and two symbols onto \
1, \[Ellipsis], 5832.\
\>", "Notes",
 CellID->597398864,ExpressionUUID->"342fbf60-3f58-4552-92bc-845fb2c280aa"],

Cell["\<\
Defined only for three states and two symbols; other shapes stay unevaluated.\
\
\>", "Notes",
 CellID->682602122,ExpressionUUID->"77a41b22-22a5-4886-82be-2706ed7ed625"]
}, Open  ]],

