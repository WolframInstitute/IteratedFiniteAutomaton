Notebook[{

Cell[CellGroupData[{
Cell["AutomatonNucleus", "ObjectName",
 CellID->585716738,ExpressionUUID->"fb68b57c-74aa-4b2a-a47a-aa95dbd8d9f4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fbe91e8e-53b6-4bc5-b30f-128b24bf42a5"],
 Cell[BoxData[
  RowBox[{"AutomatonNucleus", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["depth", "TI"], ",", 
   StyleBox["refLevel", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f7a776a8-6454-4b15-a817-a1e0619c7afd"],
 " \[LineSeparator]",
 "gives, for each ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", 
   RowBox[{"0", ",", "\[Ellipsis]", ",", 
    StyleBox["depth", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "dcbb3adb-802b-4d69-9b51-a10490ee3b8c"],
 ", the sections at depth ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "bde150b6-b3ed-47cd-8cc6-99a8c5c3eec7"],
 " of the words of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "97fdd379-5cd0-4fe8-914b-b50dd951c024"],
 ", kept distinct as automorphisms of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["refLevel", "TI"]]], "InlineFormula",ExpressionUUID->
  "7199e028-e9c0-4dc5-9016-1412ccfd4afc"],
 "."
}], "Usage",
 CellID->605963415,ExpressionUUID->"7fde82c1-03ce-48a6-8cbc-998d83230692"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "0ac14c57-6707-4aa4-8912-21c39cb4e025"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "04c87749-2074-467e-aa77-efef31f4f786"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "7fbf8858-472d-4168-9f78-1faed59ca172"],
 "."
}], "Notes",
 CellID->655431816,ExpressionUUID->"0da8f286-db4f-4153-a8c4-c90963cacc19"],

Cell["\<\
The depth-0 entry is the radius ball itself, with the identity prepended.\
\>", "Notes",
 CellID->308393155,ExpressionUUID->"21aaad62-2de6-4255-8be6-21cd41cecba5"],

Cell["\<\
The list stabilizes exactly when the automaton is contracting, and its limit \
is the nucleus \[LongDash] the finite set every section eventually falls into.\
\>", "Notes",
 CellID->177001793,ExpressionUUID->"866ca233-c02f-4e4b-a486-9e47cfcef65d"],

Cell[TextData[{
 "Elements are compared through their action on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["refLevel", "TI"]]], "InlineFormula",ExpressionUUID->
  "c94e5613-a7d6-4281-aa98-6e8cf8d60bea"],
 ", so ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "67c5c5c8-37e4-46d6-8851-9985624c50d3"],
 " must be deep enough to separate them."
}], "Notes",
 CellID->729953823,ExpressionUUID->"e70cc14a-d558-4baf-a974-0ee8ad99666a"]
}, Open  ]],

