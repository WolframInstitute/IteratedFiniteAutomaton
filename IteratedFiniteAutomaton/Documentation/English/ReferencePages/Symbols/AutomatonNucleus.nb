Notebook[{

Cell[CellGroupData[{
Cell["AutomatonNucleus", "ObjectName",
 CellID->715801649,ExpressionUUID->"99b69918-9523-4521-aad5-61ef43368e3a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b964977c-462d-4abb-96b0-791744ffbf40"],
 Cell[BoxData[
  RowBox[{"AutomatonNucleus", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["depth", "TI"], ",", 
   StyleBox["refLevel", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "62664047-009f-419d-8685-073f41ef543c"],
 " \[LineSeparator]",
 "gives, for each ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", 
   RowBox[{"0", ",", "\[Ellipsis]", ",", 
    StyleBox["depth", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "e8b5cb2f-2367-4b3b-839f-379765fce4e8"],
 ", the sections at depth ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "66b19ed1-a44f-483e-894b-0cc32747b6e9"],
 " of the words of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "1dec1e9c-4c43-4371-936b-5ad304eb1b9e"],
 ", kept distinct as automorphisms of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["refLevel", "TI"]]], "InlineFormula",ExpressionUUID->
  "5525a924-af72-4cd9-a7a0-2c6d990c8b92"],
 "."
}], "Usage",
 CellID->512973063,ExpressionUUID->"71bbae5e-0c94-4d57-8d93-72d92b9564db"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "5efec56f-faeb-407a-9676-15fe72d246c5"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "bdc02634-aa3a-445f-b71c-9502e8d2e058"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "34479c5c-b64f-46e5-852f-6572147800e9"],
 "."
}], "Notes",
 CellID->421046758,ExpressionUUID->"7b96439f-bbb1-45b9-b7e1-9922e45b3e08"],

Cell["\<\
The depth-0 entry is the radius ball itself, with the identity prepended.\
\>", "Notes",
 CellID->332807196,ExpressionUUID->"5e93fc90-e3c0-4515-a473-33010288bcf8"],

Cell["\<\
The list stabilizes exactly when the automaton is contracting, and its limit \
is the nucleus \[LongDash] the finite set every section eventually falls into.\
\>", "Notes",
 CellID->356357711,ExpressionUUID->"af94166c-f4f4-4655-a50a-09091bd88d4d"],

Cell[TextData[{
 "Elements are compared through their action on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["refLevel", "TI"]]], "InlineFormula",ExpressionUUID->
  "d376d1c2-437b-4e3d-9f79-6913b7a45d04"],
 ", so ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "1fc7fefd-8ee2-48dc-bf65-3f7b639e794c"],
 " must be deep enough to separate them."
}], "Notes",
 CellID->268105289,ExpressionUUID->"df25dbf8-5505-4aa3-a9ea-d1ac8f9cc47e"]
}, Open  ]],

