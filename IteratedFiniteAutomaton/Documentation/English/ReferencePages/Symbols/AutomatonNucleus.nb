Cell["\<\
The Grigorchuk automaton is contracting: the eleven words of length at most 2 \
collapse to five sections after one step, and stay there:\
\>", "ExampleText",
 CellID->923823382,ExpressionUUID->"c20cc419-e042-410e-892f-97362fa75817"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", "level", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"level", ",", 
     RowBox[{"AutomatonNucleus", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "2", ",", "6", ",", 
       "5"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->551889482,ExpressionUUID->"bc299799-f400-47c3-87ed-46b987628722"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"11", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->317576493,ExpressionUUID->"ddc56add-fc9c-44dd-a0c0-b94a676fb1d6"],

Cell["\<\
The limit is the nucleus \[LongDash] the identity and the four generators, \
written as inverse letters:\
\>", "ExampleText",
 CellID->986060236,ExpressionUUID->"a3014516-ee7e-4d5c-aee1-f77d446fa6d3"],

