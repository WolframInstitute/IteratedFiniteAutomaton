Cell["\<\
The Grigorchuk automaton is contracting: the eleven words of length at most 2 \
collapse to five sections after one step, and stay there:\
\>", "ExampleText",
 CellID->271813054,ExpressionUUID->"015db782-ffab-4718-a6e3-a96444725a3a"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", "level", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"level", ",", 
     RowBox[{"AutomatonNucleus", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8950703898", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "2"}], "}"}]}], "}"}], ",", "2", ",", "6", ",", 
       "5"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->216779182,ExpressionUUID->"bdc8a984-0358-47d8-a3b9-11ef19efc08a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"11", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->259932114,ExpressionUUID->"c3b6fe23-7a1c-48e9-a371-8c5d166b51cf"],

Cell["\<\
The limit is the nucleus \[LongDash] the identity and the four generators, \
written as inverse letters:\
\>", "ExampleText",
 CellID->100575686,ExpressionUUID->"e43321c2-e86c-4980-a1ff-f23c5be3d77a"],

