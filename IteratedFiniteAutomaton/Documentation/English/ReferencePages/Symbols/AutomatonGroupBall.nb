Cell[CellGroupData[{
Cell["AutomatonGroupBall", "ObjectName",
 CellID->243041895,ExpressionUUID->"242c19d2-e5c1-4f83-9404-a0a9d8aef9a0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"71e37fc5-cbc6-48a2-9100-04bf68b58720"],
 Cell[BoxData[
  RowBox[{"AutomatonGroupBall", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["refLevel", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "563b1d9f-013f-4d2b-93fb-01bf8b26ad05"],
 " \[LineSeparator]",
 "gives one shortest word for each distinct nontrivial element of the \
level-",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "b5b67e9f-2c84-40fc-9b6b-d23abed14596"],
 " quotient represented by a word of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "833e66d3-1c1b-4c60-a45d-01f6c75f1ed2"],
 "."
}], "Usage",
 CellID->849896791,ExpressionUUID->"a2ab1969-5d39-45d8-8f2c-551268aae244"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "7ecf29ab-f7cb-447f-abfe-4ae937f11a0d"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "cf6a1aaf-6ae8-4902-a814-48de8bbbf1c2"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "86f03a94-5738-4293-837a-12a70992482c"],
 "."
}], "Notes",
 CellID->171250301,ExpressionUUID->"4d68a7a2-6426-4b54-8093-4f59ac408c47"],

Cell[TextData[{
 "Two words are the same element exactly when they induce the same \
permutation of the ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "8dd40029-2e89-44ad-b933-57de6ceb3a70"],
 " vertices, so ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "bc59bfa5-c089-4780-a7ab-f591fdb47f13"],
 " must be deep enough to separate them."
}], "Notes",
 CellID->913510436,ExpressionUUID->"10c65a29-abf7-487d-b013-88a0ee7827e5"],

Cell[TextData[{
 "The identity is excluded; prepending ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "4a9060f8-fd3a-4e50-806c-3e27590eface"],
 " gives the support the group-ring searches use."
}], "Notes",
 CellID->199560965,ExpressionUUID->"24b4a5dd-524f-4139-8842-e3965eff7a32"]
}, Open  ]],

