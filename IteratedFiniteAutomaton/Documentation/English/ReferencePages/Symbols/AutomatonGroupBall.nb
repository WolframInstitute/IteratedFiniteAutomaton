Notebook[{

Cell[CellGroupData[{
Cell["AutomatonGroupBall", "ObjectName",
 CellID->507776036,ExpressionUUID->"16d79f1a-31e2-47ff-a975-3a4e4b1c4a49"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca8daa94-57a2-4ac6-bdee-d1479b86989d"],
 Cell[BoxData[
  RowBox[{"AutomatonGroupBall", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["refLevel", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a424a732-036a-49b7-8190-b47b272d6bf5"],
 " \[LineSeparator]",
 "gives one shortest word for each distinct nontrivial element of the \
level-",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "e70dfdd6-4ef2-4c19-a9a4-ab759bddee9d"],
 " quotient represented by a word of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "4a7c06be-337e-4acb-915f-f2d2b924be0f"],
 "."
}], "Usage",
 CellID->399894495,ExpressionUUID->"8d458600-7dec-41e8-9a4c-88d03d293d00"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "afc6cc11-05d8-4515-bcb0-14dc7f2441fd"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "6ae550cb-b160-448d-ba8b-cf66e6417eac"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "7484ce3e-4b63-4529-86a7-31443ed5f7f5"],
 "."
}], "Notes",
 CellID->836372658,ExpressionUUID->"6a29e573-d431-41eb-a8de-3597accb5b37"],

Cell[TextData[{
 "Two words are the same element exactly when they induce the same \
permutation of the ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "85596276-e4f3-457b-9652-8c39958a0710"],
 " vertices, so ",
 Cell[BoxData[
  StyleBox["refLevel", "TI"]], "InlineFormula",ExpressionUUID->
  "2ed89431-ab29-4412-9dfd-26e344ca51e8"],
 " must be deep enough to separate them."
}], "Notes",
 CellID->276325670,ExpressionUUID->"51a358c2-3d42-403e-9240-fb26710385d8"],

Cell[TextData[{
 "The identity is excluded; prepending ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "7314903c-9dd8-41ab-b9aa-e2c2c57390a6"],
 " gives the support the group-ring searches use."
}], "Notes",
 CellID->871234512,ExpressionUUID->"d77d72a4-6baa-4fcf-9172-bde318db0c5f"]
}, Open  ]],

