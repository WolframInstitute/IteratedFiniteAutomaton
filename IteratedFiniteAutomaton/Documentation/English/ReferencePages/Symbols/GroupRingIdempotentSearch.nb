Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentSearch", "ObjectName",
 CellID->473611166,ExpressionUUID->"8eb0fe3f-cc65-4f90-894e-cf3478a5bc88"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a8b9cd7d-da0f-4edf-af5b-c9e40036da28"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentSearch", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["coefficients", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c4da99b4-5f16-48bb-8207-843369e1b006"],
 " \[LineSeparator]",
 "gives the idempotents of the group ring of the level quotient supported on \
words of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "eba3b6f4-2744-4649-884f-0ae492adf1ec"],
 " with coefficients drawn from ",
 Cell[BoxData[
  StyleBox["coefficients", "TI"]], "InlineFormula",ExpressionUUID->
  "aec56480-f41c-4289-88a0-3186227c00e0"],
 "."
}], "Usage",
 CellID->347052929,ExpressionUUID->"5f75645d-a3cb-44a9-a3e3-3a6c7abc28c6"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "f6fc4817-6c92-4c76-a0b1-076c887b049a"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "83618261-46b8-4e03-8fa6-5cda73d29bf7"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "79f8c0dc-b1fb-4db2-8b66-af6ddb109148"],
 " is 1."
}], "Notes",
 CellID->326516015,ExpressionUUID->"67e1ff74-253d-4140-8c44-78f637c42b46"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "bdbdb314-faa7-4616-9237-f24792d326fa"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "4b316e78-e466-4481-b3c8-4b8708fd0279"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "49d51073-f28d-4746-9659-f7512184ab3b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"5d5d97ff-fd00-4c80-9e57-19446ed90dd4"],
 " over the integers."
}], "Notes",
 CellID->899429044,ExpressionUUID->"632753b1-2612-4ad5-9a0c-d36ff00a5133"],

Cell["\<\
0 and 1 are excluded, and elements that agree in the level quotient are \
returned once.\
\>", "Notes",
 CellID->362621402,ExpressionUUID->"86feda7e-3928-4057-b655-70226f9a1c6a"],

Cell[TextData[{
 "The search is exhaustive over ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"|", 
    StyleBox["coefficients", "TI"], "|"}], 
   RowBox[{"|", "support", "|"}]]], "InlineFormula",ExpressionUUID->
  "126c5867-745b-4d29-a6c7-0e7ddb85ebf1"],
 " candidates, so it is meant for small radii; for a tower of levels use ",
 Cell[BoxData[
  ButtonBox["GroupRingIdempotentSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingIdempotentSurvival"]], "InlineFormula",ExpressionUUID->
  "51d95e36-d262-4965-9680-2dfdc3a84f8b"],
 "."
}], "Notes",
 CellID->895918961,ExpressionUUID->"199f683f-1d01-41e2-ab52-f310386d1599"]
}, Open  ]],

