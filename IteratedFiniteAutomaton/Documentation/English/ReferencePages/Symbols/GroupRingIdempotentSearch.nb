Notebook[{

Cell[CellGroupData[{
Cell["GroupRingIdempotentSearch", "ObjectName",
 CellID->253085119,ExpressionUUID->"138cf13e-ee98-477c-973f-922ebe50d7a9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0d32676-8668-4813-be17-793ec2eb1461"],
 Cell[BoxData[
  RowBox[{"GroupRingIdempotentSearch", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["radius", "TI"], ",", 
   StyleBox["coefficients", "TI"], ",", 
   StyleBox["level", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8accc678-3570-4465-b129-9fd1534c1f6d"],
 " \[LineSeparator]",
 "gives the idempotents of the group ring of the level quotient supported on \
words of length at most ",
 Cell[BoxData[
  StyleBox["radius", "TI"]], "InlineFormula",ExpressionUUID->
  "a382be36-afcc-41be-9238-50c0d17ca934"],
 " with coefficients drawn from ",
 Cell[BoxData[
  StyleBox["coefficients", "TI"]], "InlineFormula",ExpressionUUID->
  "5df2ede5-b88f-45e3-bf64-0a4a94adb6aa"],
 "."
}], "Usage",
 CellID->200722951,ExpressionUUID->"f85bcbb3-e8a7-4922-996b-61f7d526acb2"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "592b7046-0b0f-4193-9c36-d584279730c8"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "1b69bcf2-a172-490a-92aa-a4bd70844f09"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "1e79db22-e71e-49b4-9090-be0d948b5506"],
 " is 1."
}], "Notes",
 CellID->238429989,ExpressionUUID->"84f54b1a-da6e-49ba-a287-9e5055326d35"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Modulus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Modulus"]], "InlineFormula",ExpressionUUID->
  "44b3dac5-984a-41e0-8b8c-237f7b17df7b"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "85be7b06-e509-4db5-8845-fbc915f7601e"],
 " computes over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "dc083ae8-72a9-4fe5-b26e-01e66af966e6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Modulus",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Modulus"], "\[Rule]", "0"}]], "InlineFormula",
  ExpressionUUID->"d9506b77-dabc-4a6b-ba10-cb716910389a"],
 " over the integers."
}], "Notes",
 CellID->210569946,ExpressionUUID->"703fa830-e120-43cc-a510-fe5779ce4449"],

Cell["\<\
0 and 1 are excluded, and elements that agree in the level quotient are \
returned once.\
\>", "Notes",
 CellID->280003640,ExpressionUUID->"816f85b1-05aa-42d4-ae39-ec5fa775a6bd"],

Cell[TextData[{
 "The search is exhaustive over ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"|", 
    StyleBox["coefficients", "TI"], "|"}], 
   RowBox[{"|", "support", "|"}]]], "InlineFormula",ExpressionUUID->
  "955409c0-93fd-443a-b070-88bc08098de8"],
 " candidates, so it is meant for small radii; for a tower of levels use ",
 Cell[BoxData[
  ButtonBox["GroupRingIdempotentSurvival",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
GroupRingIdempotentSurvival"]], "InlineFormula",ExpressionUUID->
  "b679c209-7f6c-4f82-8ecc-f206a2271e4f"],
 "."
}], "Notes",
 CellID->785348613,ExpressionUUID->"32284ac5-bca4-44f2-9957-18f4ea1c3d9d"]
}, Open  ]],

