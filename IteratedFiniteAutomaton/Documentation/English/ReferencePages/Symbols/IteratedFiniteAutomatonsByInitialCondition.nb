Cell["\<\
An explicit transition list works just as well \[LongDash] the adding machine \
from four tapes:\
\>", "ExampleText",
 CellID->733581234,ExpressionUUID->"21104d84-562a-4937-aa32-c82659f08894"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->196291532,ExpressionUUID->"db0bea36-b2d2-4eb2-b82c-8e62fa507744"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"IteratedFiniteAutomatonsByInitialCondition", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"IteratedFiniteAutomatonInitialConditionSample", "[", 
      RowBox[{"2", ",", "16", ",", "3"}], "]"}], ",", "16"}], "]"}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->437337514,ExpressionUUID->"729f9f39-620e-4e86-b05e-48e0ce8d794a"],

