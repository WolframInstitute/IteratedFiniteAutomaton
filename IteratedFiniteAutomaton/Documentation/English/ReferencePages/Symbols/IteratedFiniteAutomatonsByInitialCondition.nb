  ButtonBox["ArrayPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayPlot"]], "InlineFormula",ExpressionUUID->
  "5f699dcd-c2bf-4db1-8152-58a3410ff68a"],
 " of the evolution of the ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "51c7afac-35ad-4241-8d4f-35bd246ca9d7"],
 " for each initial condition in ",
 Cell[BoxData[
  StyleBox["inits", "TI"]], "InlineFormula",ExpressionUUID->
  "8f20ebaf-9a2f-483c-bf0f-4ab7caa2c36a"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"96d32c6a-096c-4dc7-b91d-acad6ab1833d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonsByInitialCondition", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["inits", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e73797c6-ae32-42e2-9b09-80df543658ca"],
 " \[LineSeparator]",
 "runs ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "365e75df-c767-4501-bd27-db55cc78dc15"],
 " steps instead of ",
 Cell[BoxData[
  RowBox[{"Length", "[", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8ef9c3fb-30a1-48f4-945e-39e3a4e7b744"],
 "."
}], "Usage",
 CellID->439067461,ExpressionUUID->"e2e25a47-0084-4bec-ada7-5794a8ad737b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "ffce931a-3333-428d-ae07-6848e077154a"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "c8ca0077-a187-4433-b85d-3817a7e979d2"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a8cbbced-4cc6-422e-b39b-fd6ba69383b0"],
 "."
}], "Notes",
 CellID->408852892,ExpressionUUID->"3c92069d-9549-46a1-8ebf-cfd6fe56d4c1"],

Cell[TextData[{
 "The alphabet size ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a39fa207-bcd5-4593-b613-4c06140c45f9"],
 " is read off the automaton, so the plots are colored by ",
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonColors", "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "bfdb1404-d5a3-4fd2-b834-5973465ac596"],
 " without being told it."
}], "Notes",
 CellID->197273007,ExpressionUUID->"1e264542-2fd5-4612-bfe1-e1e6c289d101"],

