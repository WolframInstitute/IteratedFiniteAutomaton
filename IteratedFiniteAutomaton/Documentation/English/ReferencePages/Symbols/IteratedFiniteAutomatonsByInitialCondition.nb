Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["automaton", "TI"]], "InlineFormula",ExpressionUUID->
  "351d5382-b002-4fb3-87a1-f34da5a7dd0e"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "c95b57ed-6302-4322-891a-282f2e3042d5"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "58dc143f-f5e5-4a98-a32d-d94147dfaed5"],
 "."
}], "Notes",
 CellID->214780723,ExpressionUUID->"c0f3681a-a508-4424-bbcd-75b8d6097733"],

Cell[TextData[{
 "The alphabet size ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "8fd28aac-786f-4ac0-b46a-b093b6b2c3d7"],
 " is read off the automaton, so the plots are colored by ",
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonColors", "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e346ac92-a191-44c7-bfd6-bd170df6a48b"],
 " without being told it."
}], "Notes",
 CellID->370611439,ExpressionUUID->"0b1a23de-e516-4b2d-a416-60510143fe3a"],

