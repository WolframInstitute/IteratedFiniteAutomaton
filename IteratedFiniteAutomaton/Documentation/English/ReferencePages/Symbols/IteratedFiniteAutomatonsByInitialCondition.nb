Cell["\<\
An explicit transition list works just as well \[LongDash] the adding machine \
from four tapes:\
\>", "ExampleText",
 CellID->257593358,ExpressionUUID->"a5c13d15-c976-4b50-af75-b4ddcfec01c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->754883822,ExpressionUUID->"285733c6-f4d4-4d52-b259-f87861a0343f"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"IteratedFiniteAutomatonsByInitialCondition", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"IteratedFiniteAutomatonInitialConditionSample", "[", 
      RowBox[{"2", ",", "16", ",", "3"}], "]"}], ",", "16"}], "]"}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->639696353,ExpressionUUID->"4408ad7c-e6de-4e2f-8cd1-9620a92f99b4"],

