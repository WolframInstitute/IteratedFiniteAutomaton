Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ec2bc44f-de61-405e-8d6a-9255c32212ae"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonsByInitialCondition", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["inits", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7334e7c7-4d58-4efb-b6f2-780a0e9f4661"],
 " \[LineSeparator]",
 "gives one ",
