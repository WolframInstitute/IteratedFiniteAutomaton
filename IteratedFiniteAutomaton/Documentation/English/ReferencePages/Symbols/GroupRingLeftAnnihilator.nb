Cell[CellGroupData[{
Cell["GroupRingLeftAnnihilator", "ObjectName",
 CellID->145190509,ExpressionUUID->"42fb2a40-7595-450c-bcc8-fecf7af31e91"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f5b36d49-1d6c-4c73-8571-94473aedb96d"],
 Cell[BoxData[
  RowBox[{"GroupRingLeftAnnihilator", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["support", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3f3d1f47-a1b8-4d05-ba9e-dbd464b7d249"],
 " \[LineSeparator]",
 "gives a basis of the coefficient vectors ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "498dc96f-087a-4a1b-9fde-d4023c51fc2d"],
 ", in the basis ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "2c7212a4-06bb-4e25-aa88-644d643f51cb"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"\[Sum]", 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["support", "TI"], 
      StyleBox["j", "TI"]]}]}], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "93f051ff-3787-4183-b3d0-f36ee97ecb9a"],
 " in every level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "d3cae2f9-171b-42dd-846b-f5c638c116a6"],
 "."
}], "Usage",
 CellID->686832037,ExpressionUUID->"91e0f463-f60c-4093-8465-aba200587b5c"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "e3050a2f-28ee-4a67-91ed-bf3288e9100e"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "053b8f16-4d64-4b2c-aa93-6686d13a464a"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "dd3c5b5e-2e60-4adc-b0fa-3c40f18723c6"],
 " is 1."
}], "Notes",
 CellID->546781565,ExpressionUUID->"5173a62f-340b-4789-940d-bbf7a265cd02"],

Cell[TextData[{
 "The condition is linear in ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "dbf0da46-0dac-458c-9221-7121636424ea"],
 ", so this is a ",
 Cell[BoxData[
  ButtonBox["NullSpace",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NullSpace"]], "InlineFormula",ExpressionUUID->
  "c6e39297-7270-45b3-a7b9-9a2f0df4b995"],
 " over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "2a421517-4f21-4849-9308-e4e43d60daad"],
 " of the matrix whose columns are the products ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], " ", 
   SubscriptBox[
    StyleBox["support", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "842a8d2e-bedd-4bfd-a879-38df1be08769"],
 ", stacked over all levels."
}], "Notes",
 CellID->375467948,ExpressionUUID->"b31c3684-4a15-4645-98c6-104905df2c27"],

Cell[TextData[{
 "An empty result means ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "2daaa7f5-d740-4a40-9fdf-d6052087ac74"],
 " is not a left zero divisor with support in ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "ad8152f0-5aad-41b0-ad1e-b4ffd9bef0fb"],
 " at those levels."
}], "Notes",
 CellID->288089511,ExpressionUUID->"dc691495-d71b-4933-bc87-73206921d1bb"],

Cell[TextData[{
 "The usual ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "c03ff7a1-080a-4e1b-b9fb-f49c44605915"],
 " is ",
 Cell[BoxData[
  RowBox[{"Prepend", "[", 
   RowBox[{
    RowBox[{"AutomatonGroupBall", "[", 
     RowBox[{
      StyleBox["automaton", "TI"], ",", 
      StyleBox["radius", "TI"], ",", 
      StyleBox["refLevel", "TI"]}], "]"}], ",", 
    RowBox[{"{", "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e992a60f-0f7c-4fb5-89a2-2a73b4e1053e"],
 "."
}], "Notes",
 CellID->727854179,ExpressionUUID->"47b450ae-448d-4255-badd-1b9bcb703e5c"]
}, Open  ]],

