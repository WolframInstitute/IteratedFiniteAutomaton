Cell[CellGroupData[{
Cell["GroupRingLeftAnnihilator", "ObjectName",
 CellID->503144137,ExpressionUUID->"cdee86b2-dc8a-4dce-b079-a1be6fff2ad5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cfa40820-8fcb-4066-9754-44ea6ad7d0cc"],
 Cell[BoxData[
  RowBox[{"GroupRingLeftAnnihilator", "[", 
   StyleBox["automaton", "TI"], ",", 
   StyleBox["a", "TI"], ",", 
   StyleBox["support", "TI"], ",", 
   StyleBox["levels", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9f57f82e-2c35-4315-ac4c-6130254fcc45"],
 " \[LineSeparator]",
 "gives a basis of the coefficient vectors ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "b8178e6b-b45d-4c13-a525-6ab0854ecf1b"],
 ", in the basis ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "339e97b4-3275-43ed-8a79-e8b66f9920c5"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   RowBox[{"\[Sum]", 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["j", "TI"]], 
     SubscriptBox[
      StyleBox["support", "TI"], 
      StyleBox["j", "TI"]]}]}], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "e63ed645-8d08-49f1-848e-3ec60f5a7a4e"],
 " in every level quotient in ",
 Cell[BoxData[
  StyleBox["levels", "TI"]], "InlineFormula",ExpressionUUID->
  "6fcc4920-f5db-429a-9024-cab877051d64"],
 "."
}], "Usage",
 CellID->886308762,ExpressionUUID->"d2dd2fa4-b8de-439d-9263-c3d2fef692e9"],

Cell[TextData[{
 "A group-ring element is a list of coefficient-word pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["w", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "ff612090-4f23-41c4-b49e-191297ecc237"],
 ", so ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "23344c71-4726-458a-a2ef-66e88de7597e"],
 " is 0 and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", "}"}]}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "e80f1fd8-9791-4dd9-8316-8f8e4055e057"],
 " is 1."
}], "Notes",
 CellID->913891584,ExpressionUUID->"38aa679e-b3cf-4c3d-abea-a9fb96a1ae09"],

Cell[TextData[{
 "The condition is linear in ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "d68b4f80-54b0-4798-8e27-a319bcfee84c"],
 ", so this is a ",
 Cell[BoxData[
  ButtonBox["NullSpace",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NullSpace"]], "InlineFormula",ExpressionUUID->
  "9605f856-2f8e-483e-982d-ccd8f9f29879"],
 " over ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", 
   StyleBox["p", "TI"]]], "InlineFormula",ExpressionUUID->
  "c28b24db-a0ab-4114-91e5-49e9fbcee4a5"],
 " of the matrix whose columns are the products ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], " ", 
   SubscriptBox[
    StyleBox["support", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "2fd4ec65-5cf0-44dd-94dd-24dbb79a64fd"],
 ", stacked over all levels."
}], "Notes",
 CellID->707025322,ExpressionUUID->"173c47f2-5e60-4b55-b892-1bf47bd2a018"],

Cell[TextData[{
 "An empty result means ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "ac0f9433-7dea-49b2-99ce-3761b0e4827d"],
 " is not a left zero divisor with support in ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "87cc80fb-a05d-4ba8-a6e7-cd532135434e"],
 " at those levels."
}], "Notes",
 CellID->722444643,ExpressionUUID->"90f0459d-1eab-4d4a-b9cd-559c7b7c6e91"],

Cell[TextData[{
 "The usual ",
 Cell[BoxData[
  StyleBox["support", "TI"]], "InlineFormula",ExpressionUUID->
  "658c0018-c4eb-4b52-ba9d-230f8c868e99"],
 " is ",
 Cell[BoxData[
  RowBox[{"Prepend", "[", 
   RowBox[{
    RowBox[{"AutomatonGroupBall", "[", 
     RowBox[{
      StyleBox["automaton", "TI"], ",", 
      StyleBox["radius", "TI"], ",", 
      StyleBox["refLevel", "TI"]}], "]"}], ",", 
    RowBox[{"{", "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "50bfb711-0fd0-4b54-ba28-2646afb45cc4"],
 "."
}], "Notes",
 CellID->937665893,ExpressionUUID->"24e6fea5-2fc5-4712-90de-5cb6273d9847"]
}, Open  ]],

