Notebook[{

Cell[CellGroupData[{
Cell["InvertibleAutomatonCodes", "ObjectName",
 CellID->260722838,ExpressionUUID->"ff0c1460-6f1e-48f2-84f0-8ec63f3a30e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"585b07eb-34ca-4fb6-a2c5-a6fa1c8f802e"],
 Cell[BoxData[
  RowBox[{"InvertibleAutomatonCodes", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f8fef6e5-03bc-4479-b901-821c92886359"],
 " \[LineSeparator]",
 "gives the codes of all invertible automata over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "d23c26a0-41f7-4564-9184-63684d3da949"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "247d69bc-86e9-461a-96d6-67b2461b0ddf"],
 " symbols."
}], "Usage",
 CellID->840670118,ExpressionUUID->"6f3543ae-37c2-4a9d-9aed-377d853d099a"],

Cell[TextData[{
 "The list has ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "!"}], ")"}], 
    StyleBox["s", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "24d64155-aee2-4191-9d9d-b4e0d2618e4c"],
 " entries and is the domain every automaton-group search runs over."
}], "Notes",
 CellID->155092255,ExpressionUUID->"009eeac0-0afa-4c05-9a47-ad5d38c08767"],

Cell[TextData[{
 "It is computed by filtering all ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}], ")"}], 
   RowBox[{
    StyleBox["s", "TI"], " ", 
    StyleBox["k", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "75eefe9f-88b9-4a25-b3be-7777d6e3aa84"],
 " codes with ",
 Cell[BoxData[
  ButtonBox["InvertibleAutomatonQ",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
InvertibleAutomatonQ"]], "InlineFormula",ExpressionUUID->
  "cd0f7b84-884d-4b30-b0ca-c23d96290c58"],
 ", so it is practical up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"], "\[LessEqual]", "6"}]], "InlineFormula",
  ExpressionUUID->"88f40e38-e8bf-4cea-9b46-29c045db41e6"],
 "."
}], "Notes",
 CellID->683041717,ExpressionUUID->"fbaae81a-ac9c-431a-b908-e2950b620f8b"]
}, Open  ]],

