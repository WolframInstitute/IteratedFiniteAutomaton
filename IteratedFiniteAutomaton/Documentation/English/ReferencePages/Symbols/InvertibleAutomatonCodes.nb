Notebook[{

Cell[CellGroupData[{
Cell["InvertibleAutomatonCodes", "ObjectName",
 CellID->895579955,ExpressionUUID->"26d31983-7df5-4d8c-9887-d12bd2ee0eb1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ed233f08-6fd6-4d05-854f-0a125c8a33f7"],
 Cell[BoxData[
  RowBox[{"InvertibleAutomatonCodes", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "cc89d71f-affe-4c1b-b16b-867e54f580c7"],
 " \[LineSeparator]",
 "gives the codes of all invertible automata over ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "53d254c7-edd1-4606-969a-22c4b500a488"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "8c9a7044-9a94-437f-ba7b-ccffb36d8117"],
 " symbols."
}], "Usage",
 CellID->306861593,ExpressionUUID->"b360ad41-fa01-42ff-bfbf-9a7dfea2c340"],

Cell[TextData[{
 "The list has ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["k", "TI"], "!"}], ")"}], 
    StyleBox["s", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "681657db-a59f-44a3-9ce7-eadfc250fc68"],
 " entries and is the domain every automaton-group search runs over."
}], "Notes",
 CellID->538573915,ExpressionUUID->"bff177d3-fa8d-46b5-811c-3f99b8d35bf5"],

Cell[TextData[{
 "It is computed by filtering all ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}], ")"}], 
   RowBox[{
    StyleBox["s", "TI"], " ", 
    StyleBox["k", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "ac8d2b95-f1e6-496f-b278-2d6ed2db2398"],
 " codes with ",
 Cell[BoxData[
  ButtonBox["InvertibleAutomatonQ",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
InvertibleAutomatonQ"]], "InlineFormula",ExpressionUUID->
  "5e8c04de-efa1-439d-8045-0100b674939e"],
 ", so it is practical up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], " ", 
   StyleBox["k", "TI"], "\[LessEqual]", "6"}]], "InlineFormula",
  ExpressionUUID->"dcbf1b6a-4efa-48e7-b8f2-49dc44e90d16"],
 "."
}], "Notes",
 CellID->393898779,ExpressionUUID->"96df2efb-a3b2-4c1e-a0aa-464d9d2af83b"]
}, Open  ]],

