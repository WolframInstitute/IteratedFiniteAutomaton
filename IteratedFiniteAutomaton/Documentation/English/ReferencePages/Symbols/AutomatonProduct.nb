Cell["\<\
The pair acts as the composition of its two states, level by level:\
\>", "ExampleText",
 CellID->252979634,ExpressionUUID->"adb80586-dc15-481e-abdf-a65b21cf029a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"productPerms", "=", 
   RowBox[{"AutomatonLevelPermutations", "[", 
    RowBox[{
     RowBox[{"AutomatonProduct", "[", 
      RowBox[{
       RowBox[{"AutomatonAdderCascade", "[", "3", "]"}], ",", 
       RowBox[{"AutomatonWindowProgram", "[", "2", "]"}]}], "]"}], ",", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->800272710,ExpressionUUID->"52e904ac-2f40-4aec-be85-57fe69656498"],

