     RowBox[{
      RowBox[{"Range", "[", "3", "]"}], ",", 
      RowBox[{"Range", "[", "4", "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "pair", "}"}], ",", 
     RowBox[{
      RowBox[{"productPerms", "[", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "pair", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-",
            "1"}], ")"}]}], "+", 
