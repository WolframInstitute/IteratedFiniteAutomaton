    RowBox[{
     RowBox[{"AutomatonAdderCascade", "[", "3", "]"}], ",", "3"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->459103323,ExpressionUUID->"96a78399-ae67-4860-80e2-7f6d71e0c103"],

