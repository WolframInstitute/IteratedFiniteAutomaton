Notebook[{

Cell[CellGroupData[{
Cell["AutomatonProduct", "ObjectName",
 CellID->172470556,ExpressionUUID->"73badd23-d14e-4f14-b68e-5976558c5ce4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d1ed55c-b09a-4e8e-a16f-9671e08e200c"],
 Cell[BoxData[
  RowBox[{"AutomatonProduct", "[", 
   StyleBox["a", "TI"], ",", 
   StyleBox["b", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d510972d-16be-4389-8b06-b9e6c3710f94"],
 " \[LineSeparator]",
 "gives the rule of the composition automaton on the pairs of states, where \
the pair ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "94ed771d-10e4-43f4-8b93-a2aba8e8e55f"],
 " acts on the rooted tree as the automorphism of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "ffbdabe5-9cbd-4c28-8f10-5f77b8b52064"],
 " followed by that of ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",ExpressionUUID->
  "46e8b6fd-a862-4096-ade3-122039c6057e"],
 "."
}], "Usage",
 CellID->894204790,ExpressionUUID->"7d5d3e23-d4ee-4473-8789-96e81607d97a"],

Cell[TextData[{
 "The pair ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "6097470a-8c61-4aee-adfa-a3001cabc1b9"],
 " is numbered ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["p", "TI"], "-", "1"}], ")"}], " ", 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["b", "TI"]], "+", 
   StyleBox["q", "TI"]}]], "InlineFormula",ExpressionUUID->
  "787e9dfa-7042-4cb2-9846-58508a148b26"],
 ", so the product has ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["a", "TI"]], " ", 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["b", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "c64f3aa8-a972-43ff-927d-3e3c6d80d96b"],
 " states."
}], "Notes",
 CellID->922077292,ExpressionUUID->"9e9d3b85-9335-4909-bd3d-662c523840d5"],

Cell["\<\
The product is invertible exactly when both factors are, since its output map \
at each state composes the two factors' output maps.\
\>", "Notes",
 CellID->291044196,ExpressionUUID->"1ffb5221-64b6-4637-9d57-785f08bba6ee"],

Cell["\<\
The group of the product is contained in the group generated by the states of \
both factors, so multiplying the state count this way does not enlarge the \
group.\
\>", "Notes",
 CellID->620699621,ExpressionUUID->"5ae8848e-4494-472e-b371-fc0ff690fcab"]
}, Open  ]],

