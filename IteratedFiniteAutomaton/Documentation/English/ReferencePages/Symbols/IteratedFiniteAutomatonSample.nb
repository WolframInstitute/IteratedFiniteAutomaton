Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonSample", "ObjectName",
 CellID->102698531,ExpressionUUID->"632501dd-34c0-46f9-82e5-c57a6d060a76"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4108a93-5af0-4dde-a10a-c37191fc31af"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonSample", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "bd279c26-000f-4a8e-9059-c57ef57c4ee7"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "bfb29c51-b3fb-4e73-bdcc-b15b8f847417"],
 " codes spread evenly over the ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}], ")"}], 
   RowBox[{
    StyleBox["s", "TI"], " ", 
    StyleBox["k", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "42ec3ca6-03f7-4893-a572-e6448637edc7"],
 " automata on ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "387739e9-3b1d-4611-984b-2c76ecc50e96"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "648e0041-ec64-4edc-a99c-18d1adcd7b15"],
 " symbols."
}], "Usage",
 CellID->348091570,ExpressionUUID->"4e39a2e8-414f-457d-bf7f-2045c3d2eaf5"],

Cell[TextData[{
 "The automata on ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "ac540759-12d8-4a9f-8fd2-492104f364fd"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "fcdc52be-93d6-481d-8dd5-10b34248c258"],
 " symbols are coded 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["s", "TI"], " ", 
      StyleBox["k", "TI"]}], ")"}], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "5d9a0dcd-50fe-4166-8e73-0a7e1c2145c2"],
 "; each code pairs with its shape as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "380c6281-409b-4b1e-9003-37130b7cd809"],
 "."
}], "Notes",
 CellID->486297902,ExpressionUUID->"aa2da483-b943-432a-b634-c8a3c6bf2702"],

Cell[TextData[{
 "The sample is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Round",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Round"], "[", 
   RowBox[{
    ButtonBox["Subdivide",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Subdivide"], "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["s", "TI"], " ", 
         StyleBox["k", "TI"]}], ")"}], 
       RowBox[{
        StyleBox["s", "TI"], " ", 
        StyleBox["k", "TI"]}]], "-", "1"}], ",", 
     StyleBox["n", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "021265f6-1443-48c3-be07-1c7ef1ee1cd8"],
 ": an increasing list that starts at 0 and ends at the last code."
}], "Notes",
 CellID->396334447,ExpressionUUID->"6ff80fe9-f1f9-4f50-921c-0e142e6af7d2"],

Cell[TextData[{
 "It sweeps the whole code space, invertible automata and degenerate ones \
alike; ",
 Cell[BoxData[
  ButtonBox["InvertibleAutomatonCodes",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
InvertibleAutomatonCodes"]], "InlineFormula",ExpressionUUID->
  "6d6f0d06-8d26-43a7-a3db-eb7583d6b65d"],
 " enumerates the invertible part instead."
}], "Notes",
 CellID->478829169,ExpressionUUID->"d2b296d9-febd-4ca9-9be6-8dda168068b6"]
}, Open  ]],

