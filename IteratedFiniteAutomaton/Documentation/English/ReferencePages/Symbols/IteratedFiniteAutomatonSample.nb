Cell["\<\
Asking for as many subdivisions as there are codes enumerates the whole space:\
\>", "ExampleText",
 CellID->964562510,ExpressionUUID->"4bb3573a-2927-4735-b710-48d17cf1e206"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IteratedFiniteAutomatonSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], ",", 
    RowBox[{
     SuperscriptBox["4", "4"], "-", "1"}]}], "]"}], "===", 
  RowBox[{"Range", "[", 
   RowBox[{"0", ",", 
    RowBox[{
     SuperscriptBox["4", "4"], "-", "1"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->313275304,ExpressionUUID->"f11bf45b-a37d-4158-a0b5-4f4a06b31bd4"],

Cell[BoxData["True"], "Output",
