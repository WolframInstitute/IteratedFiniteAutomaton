 CellID->286136610,ExpressionUUID->"0c351138-d975-4311-b307-685ed03d0f0b"],

Cell["\<\
One automaton in four on two states and two symbols is invertible, and an \
even sweep of 100 codes lands close to that share:\
\>", "ExampleText",
 CellID->685848301,ExpressionUUID->"dfef7234-a031-472f-ade0-9f01e2a165d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Count", "[", 
    RowBox[{
     RowBox[{"IteratedFiniteAutomatonSample", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "99"}], "]"}], ",", 
     RowBox[{"code_", "/;", 
      RowBox[{"InvertibleAutomatonQ", "[", 
       RowBox[{"{", 
        RowBox[{"code", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"InvertibleAutomatonCodes", "[", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->115420578,ExpressionUUID->"b269e88c-103a-433e-9667-e0b124ee57d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"24", ",", "64"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->959795063,ExpressionUUID->"bf1e598c-30c3-4ae2-bd56-2fdc40a2b620"]
}, Open  ]]
}, Open  ]],

