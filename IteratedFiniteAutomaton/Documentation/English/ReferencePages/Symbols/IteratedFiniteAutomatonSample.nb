Cell["\<\
One automaton in four on two states and two symbols is invertible, and an \
even sweep of 100 codes lands close to that share:\
\>", "ExampleText",
 CellID->832343219,ExpressionUUID->"34700795-7b2d-4015-9f0f-7f569bd93374"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Count", "[", 
    RowBox[{
     RowBox[{"IteratedFiniteAutomatonSample", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "99"}], "]"}], ",", 
     RowBox[{"code_", "/;", 
      RowBox[{"InvertibleAutomatonQ", "[", 
       RowBox[{"{", 
        RowBox[{"code", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"InvertibleAutomatonCodes", "[", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->153812739,ExpressionUUID->"9bff2c05-8fe3-4b88-8384-bda538ab555f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"24", ",", "64"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->515467683,ExpressionUUID->"3327d27a-d3b1-48d2-b964-255b80fdc955"]
}, Open  ]]
}, Open  ]],

