Cell["The sample begins at 0, ends at the last code and increases:", \
"ExampleText",
 CellID->439962306,ExpressionUUID->"2622642e-ce8e-4ed5-8b27-9dac43cfe1f9"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"codes", "=", 
       RowBox[{"IteratedFiniteAutomatonSample", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", "n"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "codes", "]"}], ",", 
       RowBox[{"First", "[", "codes", "]"}], ",", 
       RowBox[{"Last", "[", "codes", "]"}], ",", 
       RowBox[{"OrderedQ", "[", "codes", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->555248836,ExpressionUUID->"3b22fd49-cb7c-4171-ba0b-ad30e10e03e1"],

Cell[BoxData[
 RowBox[{"{", 
