Cell[CellGroupData[{
Cell["IteratedFiniteAutomatonSample", "ObjectName",
 CellID->773936918,ExpressionUUID->"bd759a58-bdc4-45e1-8d83-501580e9ee53"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ad79d915-b0da-4506-9d08-3febaf831001"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomatonSample", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["k", "TI"]}], "}"}], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b4928e55-bddf-41e7-8935-eb9b1dceb8d5"],
 " \[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "f931ceed-4a00-4c0c-bad3-d34e0228a29c"],
 " codes spread evenly over the ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}], ")"}], 
   RowBox[{
    StyleBox["s", "TI"], " ", 
    StyleBox["k", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "d75ec4e7-2a27-4c00-8904-e22a0450e0ea"],
 " automata on ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "e08d1ab7-372b-4aac-805a-d96c888d00dc"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "131a74b7-43d1-4aa5-8c8b-1b2049b17714"],
 " symbols."
}], "Usage",
 CellID->184089833,ExpressionUUID->"adccd860-cd3b-4ae3-9934-31217c37aa94"],

Cell[TextData[{
 "The automata on ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "384113a5-2ebd-4cec-a2b0-e4be7d744e9f"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "fc69201d-1caf-4001-a979-f88ecc001356"],
 " symbols are coded 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["s", "TI"], " ", 
      StyleBox["k", "TI"]}], ")"}], 
    RowBox[{
     StyleBox["s", "TI"], " ", 
     StyleBox["k", "TI"]}]], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "7f6ad619-2868-450e-80ee-f56fdebbc3cb"],
 "; each code pairs with its shape as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c787604e-99ff-48f5-bc46-cd4fa3e49870"],
 "."
}], "Notes",
 CellID->310597080,ExpressionUUID->"8906d924-c26c-4b92-9aac-94bc9318449d"],

Cell[TextData[{
 "The sample is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Round",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Round"], "[", 
   RowBox[{
    ButtonBox["Subdivide",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Subdivide"], "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["s", "TI"], " ", 
         StyleBox["k", "TI"]}], ")"}], 
       RowBox[{
        StyleBox["s", "TI"], " ", 
        StyleBox["k", "TI"]}]], "-", "1"}], ",", 
     StyleBox["n", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f847271e-ef89-4b00-946f-3958ed24888a"],
 ": an increasing list that starts at 0 and ends at the last code."
}], "Notes",
 CellID->579686308,ExpressionUUID->"c5d6e2f0-0d55-43ea-bf26-744a1d14a467"],

Cell[TextData[{
 "It sweeps the whole code space, invertible automata and degenerate ones \
alike; ",
 Cell[BoxData[
  ButtonBox["InvertibleAutomatonCodes",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/IteratedFiniteAutomaton/ref/\
InvertibleAutomatonCodes"]], "InlineFormula",ExpressionUUID->
  "e9813435-a5f2-4760-99ed-0686056fbc6e"],
 " enumerates the invertible part instead."
}], "Notes",
 CellID->288519931,ExpressionUUID->"22c97511-8695-4903-af96-36c2cc2e2a1c"]
}, Open  ]],

