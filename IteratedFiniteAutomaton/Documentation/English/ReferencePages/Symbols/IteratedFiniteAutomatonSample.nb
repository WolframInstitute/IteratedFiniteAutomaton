Cell["The sample begins at 0, ends at the last code and increases:", \
"ExampleText",
 CellID->609047462,ExpressionUUID->"50148b1e-c91d-4742-b0d7-eb50770c6962"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"codes", "=", 
       RowBox[{"IteratedFiniteAutomatonSample", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", "n"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "codes", "]"}], ",", 
       RowBox[{"First", "[", "codes", "]"}], ",", 
       RowBox[{"Last", "[", "codes", "]"}], ",", 
       RowBox[{"OrderedQ", "[", "codes", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->459427580,ExpressionUUID->"0f358025-4e6e-49c6-a588-3c0d3795d880"],

