Cell["\<\
Asking for as many subdivisions as there are codes enumerates the whole space:\
\>", "ExampleText",
 CellID->718038682,ExpressionUUID->"a27960de-6af7-471f-8d40-433f233ec665"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IteratedFiniteAutomatonSample", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], ",", 
    RowBox[{
     SuperscriptBox["4", "4"], "-", "1"}]}], "]"}], "===", 
  RowBox[{"Range", "[", 
   RowBox[{"0", ",", 
    RowBox[{
     SuperscriptBox["4", "4"], "-", "1"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->266755862,ExpressionUUID->"26e275f5-5c30-47e5-bad1-0e79b15fe332"],

Cell[BoxData["True"], "Output",
