Cell["\<\
Define the two-state adding machine (binary odometer) and evolve it from the \
zero row:\
\>", "ExampleText",
 CellID->235569827,ExpressionUUID->"8ef7089e-aa1e-4b9f-ba3c-72951d0920b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->112108235,ExpressionUUID->"ef67da45-6e27-4755-a38c-5d84cd726b42"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomaton", "[", 
  RowBox[{"addingMachine", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "5"}], "]"}], ",", "4"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->531765054,ExpressionUUID->"840309f6-1fdc-4a95-969b-ea781ff9a3f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->277390262,ExpressionUUID->"2d6bb384-ad9e-41c8-b6be-14382101278a"],

Cell["\<\
Successive rows read as binary numbers, least significant digit first:\
\>", "ExampleText",
 CellID->423603733,ExpressionUUID->"308cfdf3-5363-4d23-81ab-fe267e0c7d8a"],

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "row", "}"}], "\[Function]", 
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{"Reverse", "[", "row", "]"}], ",", "2"}], "]"}]}], ",", 
   RowBox[{"IteratedFiniteAutomaton", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "8"}], "]"}], ",", "10"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->865483351,ExpressionUUID->"942ae297-290e-4022-9722-e4e996e5e8d9"],

Cell[BoxData[
