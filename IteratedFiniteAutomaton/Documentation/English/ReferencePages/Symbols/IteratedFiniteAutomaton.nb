Cell["\<\
Define the two-state adding machine (binary odometer) and evolve it from the \
zero row:\
\>", "ExampleText",
 CellID->333388221,ExpressionUUID->"2a0e28e9-561b-48f0-9a07-2635a11b3d4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->467976930,ExpressionUUID->"11b93efc-8576-4be5-878a-2dadb7eb7532"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomaton", "[", 
  RowBox[{"addingMachine", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "5"}], "]"}], ",", "4"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->258263677,ExpressionUUID->"bf52f0a6-3dcb-4ef3-881e-e7b1cf137099"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->552845624,ExpressionUUID->"b4fe0e75-dd99-4006-84a6-b92c7d515190"],

Cell["\<\
Successive rows read as binary numbers, least significant digit first:\
\>", "ExampleText",
 CellID->867426554,ExpressionUUID->"e86d3a23-bc05-4572-bef2-06d84c4ab9f0"],

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "row", "}"}], "\[Function]", 
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{"Reverse", "[", "row", "]"}], ",", "2"}], "]"}]}], ",", 
   RowBox[{"IteratedFiniteAutomaton", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "8"}], "]"}], ",", "10"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
