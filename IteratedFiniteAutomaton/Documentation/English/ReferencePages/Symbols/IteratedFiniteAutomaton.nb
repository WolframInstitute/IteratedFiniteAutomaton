Cell["\<\
Define the two-state adding machine (binary odometer) and evolve it from the \
zero row:\
\>", "ExampleText",
 CellID->579521193,ExpressionUUID->"abdf5268-f224-4395-9b5c-8f78d77151fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->287853490,ExpressionUUID->"6c496d60-6f24-46d2-bab7-fd9823b1e419"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomaton", "[", 
  RowBox[{"addingMachine", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "5"}], "]"}], ",", "4"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->838070520,ExpressionUUID->"2cf24867-2930-4639-9f56-bff23302856c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->207867923,ExpressionUUID->"275f0142-5dca-479d-bcb6-434cb45a98df"],

Cell["\<\
Successive rows read as binary numbers, least significant digit first:\
\>", "ExampleText",
 CellID->931835408,ExpressionUUID->"a8b202fe-ab64-4114-9090-e289e846f7e8"],

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "row", "}"}], "\[Function]", 
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{"Reverse", "[", "row", "]"}], ",", "2"}], "]"}]}], ",", 
   RowBox[{"IteratedFiniteAutomaton", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "8"}], "]"}], ",", "10"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->153280009,ExpressionUUID->"e12b15f2-361d-4b4f-b39b-a3e3fe70b1a7"],

