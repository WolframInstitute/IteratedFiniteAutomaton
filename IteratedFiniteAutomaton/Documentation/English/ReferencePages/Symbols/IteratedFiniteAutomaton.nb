Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomaton", "ObjectName",
 CellID->349221021,ExpressionUUID->"8de47fe6-8210-4673-bb26-d838042a875e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c5b2598b-d9d2-4068-bb85-d0e627cecb31"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "54814107-85bb-4127-a6e6-2c048971dafa"],
 " \[LineSeparator]",
 "generates the evolution of the iterated finite automaton with the specified \
",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "00425c0b-19ca-4f65-859e-1772f16ceb71"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "6f72895c-6bd0-4673-896d-71d80659ac62"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "5c6b273b-e28d-47dc-a664-cea113c5c0ae"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fe8b658b-b9d4-4fa4-9e01-f673d8bd699f"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "82c70419-ffca-4553-bfdf-31eb985c9475"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "0babb665-c800-42d2-a6b6-435f870c8453"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"20349633-8423-4a55-a930-79547e65851d"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fac4707a-1da3-45ce-b70f-de579b08ea2d"],
 " \[LineSeparator]",
 "gives a single step of evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cd884f96-1947-4fa1-9f8f-84bb3b8756b1"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "fa05c9eb-e8f8-4506-9608-cd44137dcb93"],
 " \[LineSeparator]",
 "is the operator form that can be applied to an initial condition."
}], "Usage",
 CellID->300236459,ExpressionUUID->"58dfc7db-c881-4a29-9a20-747d319ff543"],

Cell[TextData[{
 "The automaton reads a row of symbols from the left, starting in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "e68ae985-a6ee-4b24-88f6-b64a3047af86"],
 ". At a cell holding symbol ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "ac96e126-c949-40a4-837a-43570f691b76"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "67af6932-fe44-4f1b-8cb4-9e73dbd901cb"],
 ", the transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "6fa9b12c-757d-4e4a-8559-cc46c0462b22"],
 " writes the symbol ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "9a87d5f3-4653-4932-b8bb-f6c92c259b0e"],
 " and moves to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "8eb79492-279d-4922-8e90-40f41a1779d4"],
 "."
}], "Notes",
 CellID->968849001,ExpressionUUID->"14fbb0fd-ba07-4357-b167-7d3cd0c68992"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "9038c7ea-839b-4752-ab2a-fc125c7f05bf"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "ba571e18-f153-4918-8b70-594a1c0ac861"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "87839b2d-1fc3-4d1b-9274-a13a36c8e4d7"],
 " for an automaton with ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "bf1577c8-5640-440b-886a-0f798699262d"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "37de3485-6512-4f3a-acba-9c8d034549fe"],
 " symbols."
}], "Notes",
 CellID->845442752,ExpressionUUID->"5f20a012-5077-4faf-a4ae-6f089f89a9e6"],

Cell[TextData[{
 "States are numbered 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "82b02030-aad6-4022-9627-ca0d0e856ac4"],
 "; symbols are 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "b344a2fc-8481-40cb-855c-884b83e949fc"],
 ". The initial state defaults to 1."
}], "Notes",
 CellID->830254042,ExpressionUUID->"f6c26c2a-b7b1-4e9e-84aa-4abcf22d4a0c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "3e32d092-7b4e-41ee-977a-742a4cb412d9"],
 " steps the result is a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "79e5a4c3-eb4d-4e91-a982-b5011b4bb1dd"],
 " rows including the initial condition, a spacetime evolution analogous to \
",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula",
  ExpressionUUID->"a3c089be-ec68-4713-9933-ccd48af8366b"],
 "."
}], "Notes",
 CellID->639620180,ExpressionUUID->"9e265b10-d540-4dc0-82ad-59a00c2c0a34"]
}, Open  ]],

