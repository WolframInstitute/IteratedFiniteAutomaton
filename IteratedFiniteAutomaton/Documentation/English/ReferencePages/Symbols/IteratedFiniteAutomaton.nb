Cell["\<\
Define the two-state adding machine (binary odometer) and evolve it from the \
zero row:\
\>", "ExampleText",
 CellID->134406843,ExpressionUUID->"32b279af-b73a-4ef6-a92d-c90d5fc5f802"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addingMachine", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0"}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->261296466,ExpressionUUID->"696ce6f6-fd95-49a2-bdd0-9a3e97ad4404"],

Cell[BoxData[
 RowBox[{"IteratedFiniteAutomaton", "[", 
  RowBox[{"addingMachine", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "5"}], "]"}], ",", "4"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->373295366,ExpressionUUID->"c46e1c3a-e73f-4e6e-b741-98bb90187a27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->607278947,ExpressionUUID->"39af7957-c1f0-4f5e-87e1-bc4ac19fd88e"],

Cell["\<\
Successive rows read as binary numbers, least significant digit first:\
\>", "ExampleText",
 CellID->578286292,ExpressionUUID->"bd074e43-7319-444e-a40c-a8e98a60ed9a"],

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "row", "}"}], "\[Function]", 
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{"Reverse", "[", "row", "]"}], ",", "2"}], "]"}]}], ",", 
   RowBox[{"IteratedFiniteAutomaton", "[", 
    RowBox[{"addingMachine", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "8"}], "]"}], ",", "10"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->301350873,ExpressionUUID->"29c45860-bee9-4014-b376-d6b7fac72562"],

Cell[BoxData[
