Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomaton", "ObjectName",
 CellID->853673043,ExpressionUUID->"2c8d3aed-f2ac-4c81-9ad8-e050426effa1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e1908b2f-bf67-4b8a-8c01-4e012c0c9d9a"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6741bfc9-75b4-46bf-8fc6-1292b6decf87"],
 " \[LineSeparator]",
 "generates the evolution of the iterated finite automaton with the specified \
",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "0b49af85-86de-4d54-86c0-b52e7fe075dd"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "2faea790-dcf8-4e47-a92b-5a882b63c4a7"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "ee8b0968-7fd7-4058-888a-20efb8be1ee8"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"24380857-45b0-4f3f-80cb-a62a73655489"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c51b5020-a631-4878-9088-a1571e277afb"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "91c9fd3f-6910-4638-8efa-580a9691011f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fe0e864a-21b4-475a-a3e4-c24dd7aff6cd"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f24f00a6-4a12-4c14-8410-fca26a5505be"],
 " \[LineSeparator]",
 "gives a single step of evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5031a094-253c-456c-bfde-a7bea6a7f494"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "b375a8cf-d6d9-4750-8a16-c09018903edb"],
 " \[LineSeparator]",
 "is the operator form that can be applied to an initial condition."
}], "Usage",
 CellID->450807216,ExpressionUUID->"aabf5f5f-8087-4520-9ed1-304926dc7da9"],

Cell[TextData[{
 "The automaton reads a row of symbols from the left, starting in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "5a8bf072-2f72-4c85-94e1-4288ce782bec"],
 ". At a cell holding symbol ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "f8514b7c-9a1e-4169-a6c6-3fbac541ed9a"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "62bd6f30-104c-4dff-a009-abad0e6cb800"],
 ", the transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "94f36137-bc65-47b1-9cc5-a53d96897499"],
 " writes the symbol ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "35b0ea6e-1598-4368-8b79-2ddf08775d54"],
 " and moves to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "d8bf43a6-4031-443b-af70-2cd52bbb4630"],
 "."
}], "Notes",
 CellID->575049057,ExpressionUUID->"5160b77a-41b9-4e75-87a1-6e361d47167e"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "52dff5e9-0d6b-4049-aa17-0bc1fc7a7036"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "59dc4a18-a069-4ac7-b7ff-7895321a3fe1"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "6eb0f624-951c-49a8-96ea-04fdd8509197"],
 " for an automaton with ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "dea61257-4ac7-49d6-a054-6daf10dbf8e0"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ec3230ca-4940-4193-86ed-d9587b7aa2f8"],
 " symbols."
}], "Notes",
 CellID->972763320,ExpressionUUID->"a04e2644-a787-4fec-a266-ae6be2245370"],

Cell[TextData[{
 "States are numbered 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "a2d777ff-7665-4a7c-bac9-55e2a257d45b"],
 "; symbols are 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "e1d6310a-51a7-49ce-9770-0d65b5cce046"],
 ". The initial state defaults to 1."
}], "Notes",
 CellID->766404694,ExpressionUUID->"31019824-2215-407d-9723-43c7d1d37688"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "adfaf6cd-be72-4d1c-bf75-9e5f904b2bf0"],
 " steps the result is a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "b68cb55c-a7f7-44b8-bf74-94a7d748d67c"],
 " rows including the initial condition, a spacetime evolution analogous to \
",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula",
  ExpressionUUID->"935cbd24-06c0-4bfe-9089-31cc685e5239"],
 "."
}], "Notes",
 CellID->585883991,ExpressionUUID->"b8ae8a3a-3fd6-4566-8f82-a024521c67a9"]
}, Open  ]],

