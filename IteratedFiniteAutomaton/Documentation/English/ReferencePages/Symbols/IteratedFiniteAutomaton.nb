Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomaton", "ObjectName",
 CellID->951966507,ExpressionUUID->"87ccc3a1-3679-4bdd-b3de-0115233ef6e8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b2fb21a-8ffa-4878-b627-81d66c32e12f"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "89fea37c-f64c-4304-89da-879351994e2f"],
 " \[LineSeparator]",
 "generates the evolution of the iterated finite automaton with the specified \
",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "b5d5669d-1496-4ca4-aeb6-8db6bc882892"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "d1a9582c-8840-4366-a7bc-f734f50ffac4"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "d83ca7be-5efd-416a-adc3-20eddbcfbfac"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fe806cbd-457f-446c-a7e1-163f2704092b"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cd724edf-84f8-495f-9bcf-1fa2cdd1c1ea"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "7af0ad33-b162-4921-aba8-d62244736a58"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c8827912-8129-49a4-a3c2-192ebf49b542"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "74b01b5f-bf18-470e-bdf8-0a94a81bdaaf"],
 " \[LineSeparator]",
 "gives a single step of evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6c9111c4-f201-4e5a-8916-d75dcba6b107"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "317eb4d7-3527-48ff-a261-db313d5dd598"],
 " \[LineSeparator]",
 "is the operator form that can be applied to an initial condition."
}], "Usage",
 CellID->982313535,ExpressionUUID->"ca5e77a6-9aae-44c8-b069-34b69441bb33"],

Cell[TextData[{
 "The automaton reads a row of symbols from the left, starting in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "772376d9-b784-4f20-b602-29c5734d5d47"],
 ". At a cell holding symbol ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c5a1fd09-2ba7-4c80-ad46-129403972b50"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "9fe2a9ff-2b8e-422b-96fb-089aeb54de64"],
 ", the transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "d2a42ed1-3dd7-4fa1-bc0c-62a2fb9a9398"],
 " writes the symbol ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "c878b70b-854d-40fe-b6b5-e287e24b7b27"],
 " and moves to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "d6839178-85c1-4c4d-b50e-f362d569b93e"],
 "."
}], "Notes",
 CellID->625579521,ExpressionUUID->"3232becb-bad7-4944-878e-246f50c4011b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "83b85223-504d-4dcd-ab4d-2e128af41a23"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "8b6dbc66-0796-4d05-b143-f597ff5e8495"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "0918808a-553f-4081-9a54-fcf4469b791f"],
 " for an automaton with ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "697ae475-853c-436d-bce1-2f14407c89aa"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a2d1f08f-8797-4104-ac5f-d77f9e45d391"],
 " symbols."
}], "Notes",
 CellID->310105414,ExpressionUUID->"0b0a9056-e5da-40a7-9e89-38728ebf9172"],

Cell[TextData[{
 "States are numbered 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "7c608353-1cea-4317-b372-dd2824aa1f4c"],
 "; symbols are 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "38bc6661-5567-4464-acf6-4684f91db945"],
 ". The initial state defaults to 1."
}], "Notes",
 CellID->914158490,ExpressionUUID->"3439fdfb-ff28-4cac-a8aa-fafbd9c4a679"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "34b61172-4165-4687-9736-432b2a1f8f2f"],
 " steps the result is a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "79725507-19d3-4144-916b-86e63c4b2b62"],
 " rows including the initial condition, a spacetime evolution analogous to \
",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula",
  ExpressionUUID->"31bbe91a-ddd7-443e-9dd5-1a890ee6dce8"],
 "."
}], "Notes",
 CellID->203544867,ExpressionUUID->"28096cc2-658a-4d01-a580-636334628bf7"]
}, Open  ]],

