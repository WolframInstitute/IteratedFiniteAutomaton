Notebook[{

Cell[CellGroupData[{
Cell["IteratedFiniteAutomaton", "ObjectName",
 CellID->775176235,ExpressionUUID->"3ab70b3b-2a96-43ab-a5bd-b4c624933ebe"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ffcaab21-604a-4f0c-b0b6-79b37fa98bd1"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "42a00dd7-771e-4216-9a2c-a25d46ea11fc"],
 " \[LineSeparator]",
 "generates the evolution of the iterated finite automaton with the specified \
",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "a562854a-c898-45a7-9ccd-43586703836c"],
 " from initial condition ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "6714664d-5fe0-4e65-bb10-158361137f85"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "c6c6e685-54a2-4520-ab21-ce03fecc1ec5"],
 " steps.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3fcc55b3-f1a4-4bed-a0fb-c621c1891189"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], ",", 
   StyleBox["init", "TI"], ",", 
   StyleBox["t", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5850e1bc-6dca-45b4-bc34-671dd61a8583"],
 " \[LineSeparator]",
 "starts the automaton in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "612836a5-51de-43a2-8aad-bccb1d525a44"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0da5c8ed-2ab6-4054-970d-ef2641fb57df"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   StyleBox["init", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "95776656-1b97-40ce-8604-4638dae5bbb4"],
 " \[LineSeparator]",
 "gives a single step of evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1c2aad36-bda6-4679-ab40-0f6a1232d9ed"],
 Cell[BoxData[
  RowBox[{"IteratedFiniteAutomaton", "[", 
   StyleBox["rule", "TI"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "0"], "]"}]], "InlineFormula",ExpressionUUID->
  "2e97c15a-4e5a-4576-9bc8-b63ecd46fda1"],
 " \[LineSeparator]",
 "is the operator form that can be applied to an initial condition."
}], "Usage",
 CellID->911357660,ExpressionUUID->"1e609456-08e1-4b09-aab3-c2ac160fbbd1"],

Cell[TextData[{
 "The automaton reads a row of symbols from the left, starting in state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "0"]], "InlineFormula",ExpressionUUID->
  "ea259e77-a217-4631-a5b0-f98207a255f5"],
 ". At a cell holding symbol ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "4823aae2-8111-4846-aa5b-ea2a9fc9afcf"],
 " in state ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "d439131e-1347-4029-a7b7-17505381541f"],
 ", the transition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "c7da0ce4-93d4-4a01-8249-a645eae58288"],
 " writes the symbol ",
 Cell[BoxData[
  StyleBox["o", "TI"]], "InlineFormula",ExpressionUUID->
  "b7b8d171-a221-4ebc-be00-ba053f24e060"],
 " and moves to state ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "7e6ef6fd-210e-49ab-9a9d-666cdab86755"],
 "."
}], "Notes",
 CellID->220962863,ExpressionUUID->"1eae2ee2-9feb-45c7-a774-9d4ece93e2c4"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["rule", "TI"]], "InlineFormula",ExpressionUUID->
  "32640867-e87a-4f05-879d-2053b1caa64b"],
 " is either an explicit list of transitions ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["s", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["f", "TI"], ",", 
     StyleBox["o", "TI"]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "fe8c081f-6a42-4ad1-817d-066c556729fd"],
 " or a numeric code ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["code", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["k", "TI"]}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "35c02206-1eb4-4372-b56b-3ad3bc06752d"],
 " for an automaton with ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "e99de22a-1c2b-4806-80b3-b64cb66dff5f"],
 " states and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "7ff50fa1-7141-44bc-b528-76fceb5c074b"],
 " symbols."
}], "Notes",
 CellID->511024330,ExpressionUUID->"a5824da6-5eee-4d48-a9ab-ec515af121f6"],

Cell[TextData[{
 "States are numbered 1, \[Ellipsis], ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "fa9900ac-a590-47e0-b187-8c086db2773c"],
 "; symbols are 0, \[Ellipsis], ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "cdd6a407-b457-402b-bb23-233d361fdb9a"],
 ". The initial state defaults to 1."
}], "Notes",
 CellID->777027325,ExpressionUUID->"0afe35b3-b7b0-4004-91d7-a10681bac549"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "3b3c8acb-953a-497e-b7e7-aca41fa70ea3"],
 " steps the result is a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "5234f18e-1235-4576-b8cd-f6138f7b8af6"],
 " rows including the initial condition, a spacetime evolution analogous to \
",
 Cell[BoxData[
  ButtonBox["CellularAutomaton",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CellularAutomaton"]], "InlineFormula",
  ExpressionUUID->"f2558476-2db1-4a54-95d5-d83efef09085"],
 "."
}], "Notes",
 CellID->152847222,ExpressionUUID->"2a7b6abd-d3a4-470e-b730-dd24220c4222"]
}, Open  ]],

